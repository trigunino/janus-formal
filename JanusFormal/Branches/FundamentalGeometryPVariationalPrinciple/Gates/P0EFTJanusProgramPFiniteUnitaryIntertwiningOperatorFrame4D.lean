import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPFiniteUnitaryIntertwiningKernelComplementTransport4D

/-!
# Unitary kernel-complement transport from a basepoint frame

A pairwise unitary transport is generated by one unitary trivializing frame
based at parameter zero.  Given

`F_a : E ≃ₗᵢ E`,

`F_0 = id`,

and

`H_a F_a = F_a H_0`,

define `U_ab = F_b ∘ F_a⁻¹`.  Its identity, cocycle and intertwining laws are
automatic.  The preceding unitary restriction theorem then transports both the
true kernels and their canonical orthogonal complements.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPFiniteUnitaryIntertwiningOperatorFrame4D

set_option autoImplicit false
noncomputable section

open P0EFTJanusProgramPFiniteUnitaryIntertwiningKernelComplementTransport4D

variable {E : Type*}
  [NormedAddCommGroup E] [InnerProductSpace Real E]

/-- Unitary trivializing frame of an operator family based at parameter zero. -/
structure FiniteUnitaryIntertwiningOperatorFrameData
    (operator : Real → E →L[Real] E) where
  frame : ∀ parameter, E ≃ₗᵢ[Real] E
  frame_zero : frame 0 = LinearIsometryEquiv.refl Real E
  intertwines_basepoint : ∀ parameter vector,
    operator parameter (frame parameter vector) =
      frame parameter (operator 0 vector)

namespace FiniteUnitaryIntertwiningOperatorFrameData

/-- Pairwise unitary transport generated by the basepoint frame. -/
def transport
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (first second : Real) : E ≃ₗᵢ[Real] E :=
  (data.frame first).symm.trans (data.frame second)

@[simp]
theorem transport_apply
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (first second : Real) (vector : E) :
    data.transport first second vector =
      data.frame second ((data.frame first).symm vector) :=
  rfl

/-- The inverse unitary frame intertwines in the reverse direction. -/
theorem frame_symm_intertwines
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (parameter : Real) (vector : E) :
    operator 0 ((data.frame parameter).symm vector) =
      (data.frame parameter).symm (operator parameter vector) := by
  apply (data.frame parameter).injective
  rw [(data.frame parameter).apply_symm_apply]
  have hIntertwine := data.intertwines_basepoint parameter
    ((data.frame parameter).symm vector)
  rw [(data.frame parameter).apply_symm_apply] at hIntertwine
  exact hIntertwine.symm

/-- Identity of the generated unitary transport. -/
theorem transport_self
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (parameter : Real) :
    data.transport parameter parameter =
      LinearIsometryEquiv.refl Real E := by
  ext vector
  simp [transport]

/-- Exact unitary transport cocycle. -/
theorem transport_trans
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (first second third : Real) :
    (data.transport first second).trans
        (data.transport second third) =
      data.transport first third := by
  ext vector
  simp [transport]

/-- Pairwise unitary transport intertwines the corresponding operators. -/
theorem transport_intertwines
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (first second : Real) (vector : E) :
    operator second (data.transport first second vector) =
      data.transport first second (operator first vector) := by
  calc
    operator second (data.transport first second vector) =
        data.frame second
          (operator 0 ((data.frame first).symm vector)) := by
      rw [transport_apply]
      exact data.intertwines_basepoint second
        ((data.frame first).symm vector)
    _ = data.frame second
          ((data.frame first).symm (operator first vector)) := by
      rw [data.frame_symm_intertwines first vector]
    _ = data.transport first second (operator first vector) :=
      rfl

/-- Adapter to the coherent unitary ambient transport packet. -/
def toFiniteUnitaryIntertwiningOperatorTransport
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator) :
    FiniteUnitaryIntertwiningOperatorTransportData operator where
  transport := data.transport
  transport_self := data.transport_self
  transport_trans := data.transport_trans
  intertwines := data.transport_intertwines

/-- At parameter zero the generated pairwise transport is exactly the frame. -/
theorem transport_zero
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (parameter : Real) :
    data.transport 0 parameter = data.frame parameter := by
  ext vector
  simp [transport, data.frame_zero]

/-- Canonical unitary frame of the true kernel bundle. -/
def kernelFrame
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (parameter : Real) :
    (operator 0).ker ≃ₗᵢ[Real] (operator parameter).ker :=
  data.toFiniteUnitaryIntertwiningOperatorTransport.kernelTransport 0 parameter

/-- Canonical unitary frame of the orthogonal kernel-complement bundle. -/
def kernelComplementFrame
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (parameter : Real) :
    (operator 0).kerᗮ ≃ₗᵢ[Real] (operator parameter).kerᗮ :=
  data.toFiniteUnitaryIntertwiningOperatorTransport.
    kernelComplementTransport 0 parameter

@[simp]
theorem kernelFrame_apply_val
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (parameter : Real) (vector : (operator 0).ker) :
    (data.kernelFrame parameter vector).1 = data.frame parameter vector.1 := by
  change data.transport 0 parameter vector.1 = data.frame parameter vector.1
  have hTransport := congrArg (fun equivalence => equivalence vector.1)
    (data.transport_zero parameter)
  exact hTransport

@[simp]
theorem kernelComplementFrame_apply_val
    {operator : Real → E →L[Real] E}
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator)
    (parameter : Real) (vector : (operator 0).kerᗮ) :
    (data.kernelComplementFrame parameter vector).1 =
      data.frame parameter vector.1 := by
  change data.transport 0 parameter vector.1 = data.frame parameter vector.1
  have hTransport := congrArg (fun equivalence => equivalence vector.1)
    (data.transport_zero parameter)
  exact hTransport

/-- Public unitary basepoint-frame checkpoint. -/
theorem finite_unitary_intertwining_operator_frame_gate
    (operator : Real → E →L[Real] E)
    (data : FiniteUnitaryIntertwiningOperatorFrameData operator) :
    (∀ first second vector,
      operator second (data.transport first second vector) =
        data.transport first second (operator first vector)) ∧
    (∀ first second third,
      (data.transport first second).trans
          (data.transport second third) =
        data.transport first third) ∧
    (∀ parameter vector,
      ‖data.kernelFrame parameter vector‖ = ‖vector‖) ∧
    (∀ parameter vector,
      ‖data.kernelComplementFrame parameter vector‖ = ‖vector‖) ∧
    (∀ parameter,
      data.transport 0 parameter = data.frame parameter) :=
  ⟨data.transport_intertwines,
    data.transport_trans,
    fun parameter vector => (data.kernelFrame parameter).norm_map vector,
    fun parameter vector =>
      (data.kernelComplementFrame parameter).norm_map vector,
    data.transport_zero⟩

end FiniteUnitaryIntertwiningOperatorFrameData

end
end P0EFTJanusProgramPFiniteUnitaryIntertwiningOperatorFrame4D
end JanusFormal