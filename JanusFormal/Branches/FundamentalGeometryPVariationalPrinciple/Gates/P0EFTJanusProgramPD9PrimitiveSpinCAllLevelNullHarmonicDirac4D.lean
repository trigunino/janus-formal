    (sector : NormalRootChoice) (circleMode : Int)
    (index : PrimitiveSpinCAllPositiveNullHarmonicIndex)
    (coefficient : Complex) :
    primitiveSpinCAllPositiveNullHarmonicSquaredCoefficientOperator
        period sector circleMode (Finsupp.single index coefficient) =
      primitiveSpinCAllPositiveNullHarmonicSquaredEigenvalue
          period index.1 sector circleMode •
        Finsupp.single index coefficient := by
  simp [
    primitiveSpinCAllPositiveNullHarmonicSquaredCoefficientOperator,
    primitiveSpinCAllPositiveNullHarmonicSquaredCoefficientBlock]

/-- Pointwise squared-Dirac equation for the jointly independent
all-positive-level family. -/
theorem primitiveSpinCAllPositiveNullHarmonicFamily_dirac_sq
    (sector : NormalRootChoice) (circleMode : Int)
    (index : PrimitiveSpinCAllPositiveNullHarmonicIndex) :
    primitiveSpinCGeometricDiracSquaredComplexLinearMap period hPeriod
        (primitiveSpinCAllPositiveNullHarmonicFamily
          period hPeriod sector circleMode index) =
