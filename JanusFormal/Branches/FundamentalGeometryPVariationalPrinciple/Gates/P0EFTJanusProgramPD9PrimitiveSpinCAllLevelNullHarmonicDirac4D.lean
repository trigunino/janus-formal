/-- One genuine smooth squared-Dirac section for every coefficient label,
including the Hopf zero tower. -/
def primitiveSpinCAllModeNullHarmonicRealSection :
    PrimitiveSpinCGeometricFullMode → SmoothSection period hPeriod
  | (sector, (⟨0, _⟩, circleMode)) =>
      primitiveSpinCHopfZeroModeSection
        period hPeriod sector circleMode
  | (sector, (⟨positiveLevel + 1, multiplicity⟩, circleMode)) =>
      (primitiveSpinCAllLevelNullHarmonicSquaredSeed
        period hPeriod positiveLevel multiplicity sector circleMode
