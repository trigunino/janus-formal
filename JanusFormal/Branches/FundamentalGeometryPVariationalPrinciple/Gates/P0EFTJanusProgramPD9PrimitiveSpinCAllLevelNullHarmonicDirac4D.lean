/-- The genuine squared geometric Dirac operator intertwines finite
all-positive-level synthesis with the exact diagonal coefficient
operator. -/
theorem primitiveSpinCAllPositiveNullHarmonicSynthesis_intertwines_dirac_sq
    (sector : NormalRootChoice) (circleMode : Int)
    (coefficients :
      PrimitiveSpinCAllPositiveNullHarmonicIndex →₀ Complex) :
    primitiveSpinCGeometricDiracSquaredComplexLinearMap period hPeriod
        (primitiveSpinCAllPositiveNullHarmonicSynthesis
          period hPeriod sector circleMode coefficients) =
      primitiveSpinCAllPositiveNullHarmonicSynthesis
        period hPeriod sector circleMode
        (primitiveSpinCAllPositiveNullHarmonicSquaredCoefficientOperator
          period sector circleMode coefficients) := by
  induction coefficients using Finsupp.induction with
  | zero =>
      change
        primitiveSpinCGeometricDiracSquaredComplexLinearMap
            period hPeriod 0 = 0
      exact map_zero
        (primitiveSpinCGeometricDiracSquaredComplexLinearMap
          period hPeriod)
  | single_add index coefficient rest _ _ ih =>
      rw [map_add, map_add, map_add,
        primitiveSpinCAllPositiveNullHarmonicSynthesis_single,
        map_smul,
        primitiveSpinCAllPositiveNullHarmonicFamily_dirac_sq,
        ih,
        primitiveSpinCAllPositiveNullHarmonicSquaredCoefficientOperator_single,
        map_add,
        map_smul,
        primitiveSpinCAllPositiveNullHarmonicSynthesis_single]
      rw [smul_smul, smul_smul, mul_comm]

/-- Consolidated faithful spectral realization of every finite packet
across all positive sphere levels at fixed sector and circle mode. -/
theorem primitiveSpinCAllPositiveNullHarmonicSpectralRealization_closed
    (sector : NormalRootChoice) (circleMode : Int) :
    Function.Injective
        (primitiveSpinCAllPositiveNullHarmonicSynthesis
          period hPeriod sector circleMode) ∧
      (∀ coefficients :
          PrimitiveSpinCAllPositiveNullHarmonicIndex →₀ Complex,
        primitiveSpinCGeometricDiracSquaredComplexLinearMap period hPeriod
            (primitiveSpinCAllPositiveNullHarmonicSynthesis
              period hPeriod sector circleMode coefficients) =
