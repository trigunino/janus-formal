variable (period : Real) (hPeriod : period ≠ 0)

private abbrev ThroatData := fixedEquatorData period hPeriod
private abbrev ThroatCover := MappingTorusCover (ThroatData period hPeriod)
private abbrev ThroatBase := MappingTorus (ThroatData period hPeriod)

local instance throatBaseChartedSpace :
    ChartedSpace ThroatCoverModel (ThroatBase period hPeriod) :=
  fixedThroatQuotientChartedSpace period hPeriod

local instance throatBaseIsManifold :
    IsManifold throatCoverModelWithCorners ω
      (ThroatBase period hPeriod) :=
  fixedThroatQuotient_isManifold period hPeriod

private abbrev SmoothSection :=
  D9PrimitiveSpinCSmoothSection period hPeriod .positiveQuarter

/-- Multiplication by one real sphere coordinate as a linear endomorphism of
the genuine smooth SpinC core. -/
def primitiveSpinCCoordinateMultiplicationLinearMap
    (coordinate : Fin 3) :
    SmoothSection period hPeriod →ₗ[Real] SmoothSection period hPeriod where
  toFun state :=
    d9PrimitiveSpinCRealScalarMulSection
      period hPeriod .positiveQuarter
      (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
      (d9PrimitiveMonopoleBaseCoordinate_contMDiff
        period hPeriod coordinate)
      state
  map_add' first second :=
    d9PrimitiveSpinCRealScalarMulSection_add
      period hPeriod .positiveQuarter
      (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
      (d9PrimitiveMonopoleBaseCoordinate_contMDiff
        period hPeriod coordinate)
      first second
  map_smul' scalar state :=
    d9PrimitiveSpinCRealScalarMulSection_real_smul
      period hPeriod .positiveQuarter
      (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
      (d9PrimitiveMonopoleBaseCoordinate_contMDiff
        period hPeriod coordinate)
      scalar state

@[simp]
theorem primitiveSpinCCoordinateMultiplicationLinearMap_apply
    (coordinate : Fin 3) (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateMultiplicationLinearMap
        period hPeriod coordinate state =
      d9PrimitiveSpinCRealScalarMulSection
        period hPeriod .positiveQuarter
        (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
        (d9PrimitiveMonopoleBaseCoordinate_contMDiff
          period hPeriod coordinate)
        state :=
  rfl

/-- Clifford multiplication by the differential of one sphere coordinate,
as a real-linear endomorphism. -/
def primitiveSpinCCoordinateGradientLinearMap
    (coordinate : Fin 3) :
    SmoothSection period hPeriod →ₗ[Real] SmoothSection period hPeriod where
  toFun state :=
    d9PrimitiveSpinCScalarCliffordGradientSection
      period hPeriod .positiveQuarter
      (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
      (d9PrimitiveMonopoleBaseCoordinate_contMDiff
        period hPeriod coordinate)
      state
  map_add' first second :=
    d9PrimitiveSpinCScalarCliffordGradientSection_add
      period hPeriod
      (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
      (d9PrimitiveMonopoleBaseCoordinate_contMDiff
        period hPeriod coordinate)
      first second
  map_smul' scalar state := by
    unfold d9PrimitiveSpinCScalarCliffordGradientSection
    rw [d9PrimitiveSpinCRealScalarMulSection_real_smul,
      d9PrimitiveSpinCGeometricDiracOperator_real_smul,
      d9PrimitiveSpinCGeometricDiracOperator_real_smul,
      d9PrimitiveSpinCRealScalarMulSection_real_smul]
    simp only [RingHom.id_apply]
    module

@[simp]
theorem primitiveSpinCCoordinateGradientLinearMap_apply
    (coordinate : Fin 3) (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateGradientLinearMap
        period hPeriod coordinate state =
      d9PrimitiveSpinCScalarCliffordGradientSection
        period hPeriod .positiveQuarter
        (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
        (d9PrimitiveMonopoleBaseCoordinate_contMDiff
          period hPeriod coordinate)
        state :=
  rfl

/-- Coordinate multiplication commutes with the intrinsic complex scalar
action. -/
theorem primitiveSpinCCoordinateMultiplication_complexScalar
    (coordinate : Fin 3) (scalar : Complex)
    (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateMultiplicationLinearMap
        period hPeriod coordinate
        (d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar state) =
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter scalar
        (primitiveSpinCCoordinateMultiplicationLinearMap
          period hPeriod coordinate state) := by
  change
    d9PrimitiveSpinCRealScalarMulSection
        period hPeriod .positiveQuarter
        (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
        (d9PrimitiveMonopoleBaseCoordinate_contMDiff
          period hPeriod coordinate)
        (d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar state) =
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter scalar
        (d9PrimitiveSpinCRealScalarMulSection
          period hPeriod .positiveQuarter
          (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
          (d9PrimitiveMonopoleBaseCoordinate_contMDiff
            period hPeriod coordinate)
          state)
  ext base
  rw [d9PrimitiveSpinCRealScalarMulSection_apply,
    d9PrimitiveSpinCComplexScalarSection_apply,
    d9PrimitiveSpinCComplexScalarSection_apply,
    d9PrimitiveSpinCRealScalarMulSection_apply]
  let matter : D9DoubledMatterFiber := state base
  change
    d9PrimitiveMonopoleBaseCoordinate
          period hPeriod coordinate base •
        (scalar.re • matter +
          scalar.im • d9PrimitiveSpinCImaginaryAction matter) =
      scalar.re •
          (d9PrimitiveMonopoleBaseCoordinate
            period hPeriod coordinate base • matter) +
        scalar.im •
          d9PrimitiveSpinCImaginaryAction
            (d9PrimitiveMonopoleBaseCoordinate
              period hPeriod coordinate base • matter)
  rw [map_smul]
  module

/-- Multiplication by the complex null linear form on smooth sections. -/
def primitiveSpinCNullMultiplicationLinearMap (parameter : Complex) :
    SmoothSection period hPeriod →ₗ[Real] SmoothSection period hPeriod :=
  ∑ coordinate : Fin 3,
    (d9PrimitiveSpinCComplexScalarSectionLinearMap
      period hPeriod .positiveQuarter
      (primitiveSpinCSolidNullVector parameter coordinate)).comp
        (primitiveSpinCCoordinateMultiplicationLinearMap
          period hPeriod coordinate)

/-- Clifford contraction by the differential of the same null linear
form. -/
def primitiveSpinCNullGradientLinearMap (parameter : Complex) :
    SmoothSection period hPeriod →ₗ[Real] SmoothSection period hPeriod :=
  ∑ coordinate : Fin 3,
    (d9PrimitiveSpinCComplexScalarSectionLinearMap
      period hPeriod .positiveQuarter
      (primitiveSpinCSolidNullVector parameter coordinate)).comp
        (primitiveSpinCCoordinateGradientLinearMap
          period hPeriod coordinate)

@[simp]
theorem primitiveSpinCNullMultiplicationLinearMap_apply
    (parameter : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter state =
      ∑ coordinate : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter coordinate)
          (primitiveSpinCCoordinateMultiplicationLinearMap
            period hPeriod coordinate state) := by
  simp [primitiveSpinCNullMultiplicationLinearMap]

@[simp]
theorem primitiveSpinCNullGradientLinearMap_apply
    (parameter : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullGradientLinearMap
        period hPeriod parameter state =
      ∑ coordinate : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter coordinate)
          (primitiveSpinCCoordinateGradientLinearMap
            period hPeriod coordinate state) := by
  simp [primitiveSpinCNullGradientLinearMap]

/-- The intrinsic complex scalar action is additive in its section
argument. -/
theorem d9PrimitiveSpinCComplexScalarSection_add_state
    (scalar : Complex) (first second : SmoothSection period hPeriod) :
    d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter scalar (first + second) =
      d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar first +
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar second := by
  change
    d9PrimitiveSpinCComplexScalarSectionLinearMap
        period hPeriod .positiveQuarter scalar (first + second) = _
  rw [map_add]
  simp only [d9PrimitiveSpinCComplexScalarSectionLinearMap_apply]

/-- The intrinsic complex scalar action preserves section subtraction. -/
theorem d9PrimitiveSpinCComplexScalarSection_sub_state
    (scalar : Complex) (first second : SmoothSection period hPeriod) :
    d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter scalar (first - second) =
      d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar first -
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar second := by
  change
    d9PrimitiveSpinCComplexScalarSectionLinearMap
        period hPeriod .positiveQuarter scalar (first - second) = _
  rw [map_sub]
  simp only [d9PrimitiveSpinCComplexScalarSectionLinearMap_apply]

/-- Coordinate Clifford differentiation commutes with the global complex
scalar action. -/
theorem primitiveSpinCCoordinateGradient_complexScalar
    (coordinate : Fin 3) (scalar : Complex)
    (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateGradientLinearMap
        period hPeriod coordinate
        (d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar state) =
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter scalar
        (primitiveSpinCCoordinateGradientLinearMap
          period hPeriod coordinate state) := by
  change
    d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (primitiveSpinCCoordinateMultiplicationLinearMap
            period hPeriod coordinate
            (d9PrimitiveSpinCComplexScalarSection
              period hPeriod .positiveQuarter scalar state)) -
        primitiveSpinCCoordinateMultiplicationLinearMap
          period hPeriod coordinate
          (d9PrimitiveSpinCGeometricDiracOperator
            period hPeriod .positiveQuarter
            (d9PrimitiveSpinCComplexScalarSection
              period hPeriod .positiveQuarter scalar state)) =
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter scalar
        (d9PrimitiveSpinCGeometricDiracOperator
            period hPeriod .positiveQuarter
            (primitiveSpinCCoordinateMultiplicationLinearMap
              period hPeriod coordinate state) -
          primitiveSpinCCoordinateMultiplicationLinearMap
            period hPeriod coordinate
            (d9PrimitiveSpinCGeometricDiracOperator
              period hPeriod .positiveQuarter state))
  rw [primitiveSpinCCoordinateMultiplication_complexScalar,
    d9PrimitiveSpinCGeometricDiracOperator_complexScalar,
    d9PrimitiveSpinCGeometricDiracOperator_complexScalar,
    primitiveSpinCCoordinateMultiplication_complexScalar,
    d9PrimitiveSpinCComplexScalarSection_sub_state]

/-- Clifford differentiation by one coordinate is pointwise linear in a
second coordinate multiplier. -/
theorem primitiveSpinCCoordinateGradient_coordinateMultiplication
    (gradient multiplier : Fin 3)
    (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateGradientLinearMap
        period hPeriod gradient
        (primitiveSpinCCoordinateMultiplicationLinearMap
          period hPeriod multiplier state) =
      primitiveSpinCCoordinateMultiplicationLinearMap
        period hPeriod multiplier
        (primitiveSpinCCoordinateGradientLinearMap
          period hPeriod gradient state) := by
  simp only [primitiveSpinCCoordinateGradientLinearMap_apply,
    primitiveSpinCCoordinateMultiplicationLinearMap_apply]
  exact
    d9PrimitiveSpinCScalarCliffordGradientSection_realScalarMul
      period hPeriod .positiveQuarter
      (d9PrimitiveMonopoleBaseCoordinate period hPeriod gradient)
      (d9PrimitiveMonopoleBaseCoordinate period hPeriod multiplier)
      (d9PrimitiveMonopoleBaseCoordinate_contMDiff
        period hPeriod gradient)
      (d9PrimitiveMonopoleBaseCoordinate_contMDiff
        period hPeriod multiplier)
      state

/-- Uniform complex Leibniz rule for the null linear multiplier. -/
theorem d9PrimitiveSpinCGeometricDiracOperator_nullMultiplication
    (parameter : Complex) (state : SmoothSection period hPeriod) :
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter
        (primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter state) =
      primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter
          (d9PrimitiveSpinCGeometricDiracOperator
            period hPeriod .positiveQuarter state) +
        primitiveSpinCNullGradientLinearMap
          period hPeriod parameter state := by
  simp only [primitiveSpinCNullMultiplicationLinearMap_apply,
    primitiveSpinCNullGradientLinearMap_apply]
  change
    d9PrimitiveSpinCGeometricDiracRealLinearMap
        period hPeriod
        (∑ coordinate : Fin 3,
          d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter
            (primitiveSpinCSolidNullVector parameter coordinate)
            (primitiveSpinCCoordinateMultiplicationLinearMap
              period hPeriod coordinate state)) = _
  rw [map_sum]
  simp only [d9PrimitiveSpinCGeometricDiracRealLinearMap_apply]
  simp_rw [primitiveSpinCCoordinateMultiplicationLinearMap_apply,
    primitiveSpinCCoordinateGradientLinearMap_apply,
    d9PrimitiveSpinCGeometricDiracOperator_complexScalar,
    d9PrimitiveSpinCGeometricDiracOperator_realScalarMul]
  simp_rw [d9PrimitiveSpinCComplexScalarSection_add_state]
  rw [Finset.sum_add_distrib]

/-- The null multiplier is complex-linear for the descended global complex
action. -/
theorem primitiveSpinCNullMultiplication_complexScalar
    (parameter scalar : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar state) =
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter scalar
        (primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter state) := by
  simp only [primitiveSpinCNullMultiplicationLinearMap_apply]
  change
    (∑ coordinate : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter coordinate)
          (primitiveSpinCCoordinateMultiplicationLinearMap
            period hPeriod coordinate
            (d9PrimitiveSpinCComplexScalarSection
              period hPeriod .positiveQuarter scalar state))) =
      d9PrimitiveSpinCComplexScalarSectionLinearMap
        period hPeriod .positiveQuarter scalar
        (∑ coordinate : Fin 3,
          d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter
            (primitiveSpinCSolidNullVector parameter coordinate)
            (primitiveSpinCCoordinateMultiplicationLinearMap
              period hPeriod coordinate state))
  rw [map_sum]
  simp only [d9PrimitiveSpinCComplexScalarSectionLinearMap_apply]
  apply Finset.sum_congr rfl
  intro coordinate _
  rw [primitiveSpinCCoordinateMultiplication_complexScalar,
    ← d9PrimitiveSpinCComplexScalarSection_mul,
    ← d9PrimitiveSpinCComplexScalarSection_mul, mul_comm]

/-- Each coordinate Clifford gradient commutes with the full null
multiplier. -/
theorem primitiveSpinCCoordinateGradient_nullMultiplication
    (coordinate : Fin 3) (parameter : Complex)
    (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateGradientLinearMap
        period hPeriod coordinate
        (primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter state) =
      primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (primitiveSpinCCoordinateGradientLinearMap
          period hPeriod coordinate state) := by
  simp only [primitiveSpinCNullMultiplicationLinearMap_apply]
  change
    primitiveSpinCCoordinateGradientLinearMap
        period hPeriod coordinate
        (∑ multiplier : Fin 3,
          d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter
            (primitiveSpinCSolidNullVector parameter multiplier)
            (primitiveSpinCCoordinateMultiplicationLinearMap
              period hPeriod multiplier state)) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro multiplier _
  rw [primitiveSpinCCoordinateGradient_complexScalar,
    primitiveSpinCCoordinateGradient_coordinateMultiplication]

/-- Clifford contraction by a null linear form commutes with multiplication
by that form. -/
theorem primitiveSpinCNullGradient_nullMultiplication
    (parameter : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullGradientLinearMap
        period hPeriod parameter
        (primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter state) =
      primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (primitiveSpinCNullGradientLinearMap
          period hPeriod parameter state) := by
  simp only [primitiveSpinCNullGradientLinearMap_apply]
  change
    (∑ coordinate : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter coordinate)
          (primitiveSpinCCoordinateGradientLinearMap
            period hPeriod coordinate
            (primitiveSpinCNullMultiplicationLinearMap
              period hPeriod parameter state))) =
      primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (∑ coordinate : Fin 3,
          d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter
            (primitiveSpinCSolidNullVector parameter coordinate)
            (primitiveSpinCCoordinateGradientLinearMap
              period hPeriod coordinate state))
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro coordinate _
  rw [primitiveSpinCCoordinateGradient_nullMultiplication,
    primitiveSpinCNullMultiplication_complexScalar]

/-- Local scalar notation for the already proved global complex action. -/
local instance primitiveSpinCComplexSMul :
    SMul Complex (SmoothSection period hPeriod) where
  smul scalar state :=
    d9PrimitiveSpinCComplexScalarSection
      period hPeriod .positiveQuarter scalar state

/-- The descended complex action makes the smooth positive-quarter core a
genuine complex module.  This is derived from the representation laws. -/
local instance primitiveSpinCComplexModule :
    Module Complex (SmoothSection period hPeriod) :=
  Module.ofMinimalAxioms
    (fun scalar first second =>
      d9PrimitiveSpinCComplexScalarSection_add_state
        period hPeriod scalar first second)
    (fun first second state =>
      d9PrimitiveSpinCComplexScalarSection_add_scalar
        period hPeriod .positiveQuarter first second state)
    (fun first second state =>
      d9PrimitiveSpinCComplexScalarSection_mul
        period hPeriod .positiveQuarter first second state)
    (fun state =>
      d9PrimitiveSpinCComplexScalarSection_one
        period hPeriod .positiveQuarter state)

@[simp]
theorem primitiveSpinCComplex_smul
    (scalar : Complex) (state : SmoothSection period hPeriod) :
    scalar • state =
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter scalar state :=
  rfl

/-- The descended geometric Dirac operator is complex-linear on the smooth
positive-quarter core. -/
def primitiveSpinCGeometricDiracComplexLinearMap :
    SmoothSection period hPeriod →ₗ[Complex] SmoothSection period hPeriod where
  toFun state :=
    d9PrimitiveSpinCGeometricDiracOperator
      period hPeriod .positiveQuarter state
  map_add' :=
    d9PrimitiveSpinCGeometricDiracOperator_add period hPeriod
  map_smul' scalar state := by
    change
      d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter scalar state) =
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar
          (d9PrimitiveSpinCGeometricDiracOperator
            period hPeriod .positiveQuarter state)
    exact d9PrimitiveSpinCGeometricDiracOperator_complexScalar
      period hPeriod scalar state

/-- The genuine squared geometric Dirac operator as a complex-linear
endomorphism of the smooth positive-quarter core. -/
def primitiveSpinCGeometricDiracSquaredComplexLinearMap :
    SmoothSection period hPeriod →ₗ[Complex] SmoothSection period hPeriod :=
  (primitiveSpinCGeometricDiracComplexLinearMap period hPeriod).comp
    (primitiveSpinCGeometricDiracComplexLinearMap period hPeriod)

@[simp]
theorem primitiveSpinCGeometricDiracSquaredComplexLinearMap_apply
    (state : SmoothSection period hPeriod) :
    primitiveSpinCGeometricDiracSquaredComplexLinearMap
        period hPeriod state =
      d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter
        (d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter state) :=
  rfl

/-- Complex-linear coordinate multiplication. -/
def primitiveSpinCCoordinateMultiplicationComplexLinearMap
    (coordinate : Fin 3) :
    SmoothSection period hPeriod →ₗ[Complex] SmoothSection period hPeriod where
  toFun :=
    primitiveSpinCCoordinateMultiplicationLinearMap
      period hPeriod coordinate
  map_add' := map_add
    (primitiveSpinCCoordinateMultiplicationLinearMap
      period hPeriod coordinate)
  map_smul' scalar state :=
    primitiveSpinCCoordinateMultiplication_complexScalar
      period hPeriod coordinate scalar state

@[simp]
theorem primitiveSpinCCoordinateMultiplicationComplexLinearMap_apply
    (coordinate : Fin 3) (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateMultiplicationComplexLinearMap
        period hPeriod coordinate state =
      primitiveSpinCCoordinateMultiplicationLinearMap
        period hPeriod coordinate state :=
  rfl

/-- Complex-linear coordinate Clifford gradient. -/
def primitiveSpinCCoordinateGradientComplexLinearMap
    (coordinate : Fin 3) :
    SmoothSection period hPeriod →ₗ[Complex] SmoothSection period hPeriod where
  toFun :=
    primitiveSpinCCoordinateGradientLinearMap
      period hPeriod coordinate
  map_add' := map_add
    (primitiveSpinCCoordinateGradientLinearMap
      period hPeriod coordinate)
  map_smul' scalar state :=
    primitiveSpinCCoordinateGradient_complexScalar
      period hPeriod coordinate scalar state

@[simp]
theorem primitiveSpinCCoordinateGradientComplexLinearMap_apply
    (coordinate : Fin 3) (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateGradientComplexLinearMap
        period hPeriod coordinate state =
      primitiveSpinCCoordinateGradientLinearMap
        period hPeriod coordinate state :=
  rfl

/-- The null Clifford gradient is complex-linear. -/
theorem primitiveSpinCNullGradient_complexScalar
    (parameter scalar : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullGradientLinearMap
        period hPeriod parameter (scalar • state) =
      scalar •
        primitiveSpinCNullGradientLinearMap
          period hPeriod parameter state := by
  simp only [primitiveSpinCComplex_smul,
    primitiveSpinCNullGradientLinearMap_apply]
  change
    (∑ coordinate : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter coordinate)
          (primitiveSpinCCoordinateGradientLinearMap
            period hPeriod coordinate
            (d9PrimitiveSpinCComplexScalarSection
              period hPeriod .positiveQuarter scalar state))) =
      d9PrimitiveSpinCComplexScalarSectionLinearMap
        period hPeriod .positiveQuarter scalar
        (∑ coordinate : Fin 3,
          d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter
            (primitiveSpinCSolidNullVector parameter coordinate)
            (primitiveSpinCCoordinateGradientLinearMap
              period hPeriod coordinate state))
  rw [map_sum]
  simp only [d9PrimitiveSpinCComplexScalarSectionLinearMap_apply]
  apply Finset.sum_congr rfl
  intro coordinate _
  rw [primitiveSpinCCoordinateGradient_complexScalar,
    ← d9PrimitiveSpinCComplexScalarSection_mul,
    ← d9PrimitiveSpinCComplexScalarSection_mul, mul_comm]

/-- Complex-linear null multiplication. -/
def primitiveSpinCNullMultiplicationComplexLinearMap
    (parameter : Complex) :
    SmoothSection period hPeriod →ₗ[Complex] SmoothSection period hPeriod where
  toFun :=
    primitiveSpinCNullMultiplicationLinearMap
      period hPeriod parameter
  map_add' := map_add
    (primitiveSpinCNullMultiplicationLinearMap
      period hPeriod parameter)
  map_smul' scalar state :=
    primitiveSpinCNullMultiplication_complexScalar
      period hPeriod parameter scalar state

/-- One coordinate gradient of a Hopf zero mode is its installed tangential
partner. -/
theorem primitiveSpinCCoordinateGradient_zeroMode
    (coordinate : Fin 3) (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCCoordinateGradientLinearMap
        period hPeriod coordinate
        (primitiveSpinCHopfZeroModeSection
          period hPeriod sector circleMode) =
      primitiveSpinCHopfFirstSphereTangentialSection
        period hPeriod coordinate sector circleMode := by
  change
    primitiveSpinCScalarHarmonicGradientSection
        period hPeriod
        (d9PrimitiveMonopoleBaseCoordinate period hPeriod coordinate)
        (d9PrimitiveMonopoleBaseCoordinate_contMDiff
          period hPeriod coordinate)
        sector circleMode = _
  exact primitiveSpinCFirstPositiveScalarHarmonicGradientSection_eq
    period hPeriod coordinate sector circleMode

/-- Two coordinate multipliers of a Hopf zero mode are the installed raw
quadratic product section. -/
theorem primitiveSpinCCoordinateMultiplication_sq_zeroMode
    (first second : Fin 3)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCCoordinateMultiplicationLinearMap
        period hPeriod first
        (primitiveSpinCCoordinateMultiplicationLinearMap
          period hPeriod second
          (primitiveSpinCHopfZeroModeSection
            period hPeriod sector circleMode)) =
      primitiveSpinCHopfSecondSphereProductSection
        period hPeriod first second sector circleMode := by
  simp only [primitiveSpinCCoordinateMultiplicationLinearMap_apply]
  rw [primitiveSpinCHopfCoordinateMulZeroMode_eq_firstSphere]
  rfl

/-- Real form of the coordinate-gradient anticommutator. -/
theorem primitiveSpinCCoordinateGradient_anticommutator_zeroMode_real
    (first second : Fin 3)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCCoordinateGradientLinearMap
          period hPeriod first
          (primitiveSpinCCoordinateGradientLinearMap
            period hPeriod second
            (primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode)) +
        primitiveSpinCCoordinateGradientLinearMap
          period hPeriod second
          (primitiveSpinCCoordinateGradientLinearMap
            period hPeriod first
            (primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode)) =
      (2 : Real) •
          primitiveSpinCCoordinateMultiplicationLinearMap
            period hPeriod first
            (primitiveSpinCCoordinateMultiplicationLinearMap
              period hPeriod second
              (primitiveSpinCHopfZeroModeSection
                period hPeriod sector circleMode)) -
        (2 * d9KroneckerDelta first second) •
          primitiveSpinCHopfZeroModeSection
            period hPeriod sector circleMode := by
  rw [primitiveSpinCCoordinateGradient_zeroMode,
    primitiveSpinCCoordinateGradient_zeroMode,
    primitiveSpinCCoordinateMultiplication_sq_zeroMode]
  exact primitiveSpinCHopfFirstSphereTangential_crossGradient_eq_productSection
    period hPeriod first second sector circleMode

/-- Coordinate-gradient anticommutator on a Hopf zero mode. -/
theorem primitiveSpinCCoordinateGradient_anticommutator_zeroMode
    (first second : Fin 3)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCCoordinateGradientComplexLinearMap
          period hPeriod first
          (primitiveSpinCCoordinateGradientComplexLinearMap
            period hPeriod second
            (primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode)) +
        primitiveSpinCCoordinateGradientComplexLinearMap
          period hPeriod second
          (primitiveSpinCCoordinateGradientComplexLinearMap
            period hPeriod first
            (primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode)) =
      (2 : Complex) •
          primitiveSpinCCoordinateMultiplicationComplexLinearMap
            period hPeriod first
            (primitiveSpinCCoordinateMultiplicationComplexLinearMap
              period hPeriod second
              (primitiveSpinCHopfZeroModeSection
                period hPeriod sector circleMode)) -
        ((2 * d9KroneckerDelta first second : Real) : Complex) •
          primitiveSpinCHopfZeroModeSection
            period hPeriod sector circleMode := by
  simp only [primitiveSpinCCoordinateGradientComplexLinearMap_apply,
    primitiveSpinCCoordinateMultiplicationComplexLinearMap_apply]
  rw [primitiveSpinCCoordinateGradient_zeroMode,
    primitiveSpinCCoordinateGradient_zeroMode,
    primitiveSpinCCoordinateMultiplication_sq_zeroMode]
  have hTwo : (2 : Complex) = ((2 : Real) : Complex) := by
    norm_num
  rw [primitiveSpinCComplex_smul,
    primitiveSpinCComplex_smul, hTwo,
    d9PrimitiveSpinCComplexScalarSection_ofReal,
    d9PrimitiveSpinCComplexScalarSection_ofReal]
  exact primitiveSpinCHopfFirstSphereTangential_crossGradient_eq_productSection
    period hPeriod first second sector circleMode

/-- Finite-dimensional algebra behind the null recurrence. -/
private theorem finThreeNullOperator_square
    {V : Type} [AddCommGroup V] [Module Complex V]
    (coefficient : Fin 3 → Complex)
    (gradient multiplier : Fin 3 → V →ₗ[Complex] V)
    (state : V)
    (hCross :
      ∀ first second,
        gradient first (gradient second state) +
            gradient second (gradient first state) =
          (2 : Complex) • multiplier first (multiplier second state) -
            ((2 * d9KroneckerDelta first second : Real) : Complex) • state)
    (hNull : ∑ coordinate : Fin 3, coefficient coordinate ^ 2 = 0) :
    (∑ coordinate : Fin 3, coefficient coordinate • gradient coordinate)
          ((∑ coordinate : Fin 3,
            coefficient coordinate • gradient coordinate) state) =
      (∑ coordinate : Fin 3, coefficient coordinate • multiplier coordinate)
          ((∑ coordinate : Fin 3,
            coefficient coordinate • multiplier coordinate) state) := by
  apply smul_right_injective V (show (2 : Complex) ≠ 0 by norm_num)
  calc
    (2 : Complex) •
        (∑ coordinate : Fin 3, coefficient coordinate • gradient coordinate)
          ((∑ coordinate : Fin 3,
            coefficient coordinate • gradient coordinate) state) =
      ∑ first : Fin 3, ∑ second : Fin 3,
        (coefficient first * coefficient second) •
          (gradient first (gradient second state) +
            gradient second (gradient first state)) := by
      simp [Fin.sum_univ_succ]
      module
    _ =
      ∑ first : Fin 3, ∑ second : Fin 3,
        (coefficient first * coefficient second) •
          ((2 : Complex) •
              multiplier first (multiplier second state) -
            ((2 * d9KroneckerDelta first second : Real) : Complex) •
              state) := by
      apply Finset.sum_congr rfl
      intro first _
      apply Finset.sum_congr rfl
      intro second _
      rw [hCross first second]
    _ =
      (2 : Complex) •
          (∑ coordinate : Fin 3,
            coefficient coordinate • multiplier coordinate)
            ((∑ coordinate : Fin 3,
              coefficient coordinate • multiplier coordinate) state) -
        (2 * (∑ coordinate : Fin 3, coefficient coordinate ^ 2)) •
          state := by
      simp [Fin.sum_univ_succ, d9KroneckerDelta]
      module
    _ =
      (2 : Complex) •
        (∑ coordinate : Fin 3, coefficient coordinate • multiplier coordinate)
          ((∑ coordinate : Fin 3,
            coefficient coordinate • multiplier coordinate) state) := by
      rw [hNull]
      simp

/-- The real-linear null gradient is the finite complex-linear combination
of the three coordinate gradients. -/
theorem primitiveSpinCNullGradient_eq_complex_sum
    (parameter : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullGradientLinearMap
        period hPeriod parameter state =
      (∑ coordinate : Fin 3,
        primitiveSpinCSolidNullVector parameter coordinate •
          primitiveSpinCCoordinateGradientComplexLinearMap
            period hPeriod coordinate) state := by
  change
    (∑ coordinate : Fin 3,
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter
        (primitiveSpinCSolidNullVector parameter coordinate)
        (primitiveSpinCCoordinateGradientLinearMap
          period hPeriod coordinate state)) =
      ∑ coordinate : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter coordinate)
          (primitiveSpinCCoordinateGradientLinearMap
            period hPeriod coordinate state)
  rfl

/-- The real-linear null multiplier is the finite complex-linear combination
of the three coordinate multipliers. -/
theorem primitiveSpinCNullMultiplication_eq_complex_sum
    (parameter : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter state =
      (∑ coordinate : Fin 3,
        primitiveSpinCSolidNullVector parameter coordinate •
          primitiveSpinCCoordinateMultiplicationComplexLinearMap
            period hPeriod coordinate) state := by
  change
    (∑ coordinate : Fin 3,
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter
        (primitiveSpinCSolidNullVector parameter coordinate)
        (primitiveSpinCCoordinateMultiplicationLinearMap
          period hPeriod coordinate state)) =
      ∑ coordinate : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter coordinate)
          (primitiveSpinCCoordinateMultiplicationLinearMap
            period hPeriod coordinate state)
  rfl

/-- A coordinate gradient expands a null-gradient input coefficientwise. -/
theorem primitiveSpinCCoordinateGradient_nullGradient
    (coordinate : Fin 3) (parameter : Complex)
    (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateGradientLinearMap
        period hPeriod coordinate
        (primitiveSpinCNullGradientLinearMap
          period hPeriod parameter state) =
      ∑ inner : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter inner)
          (primitiveSpinCCoordinateGradientLinearMap
            period hPeriod coordinate
            (primitiveSpinCCoordinateGradientLinearMap
              period hPeriod inner state)) := by
  rw [primitiveSpinCNullGradientLinearMap_apply, map_sum]
  apply Finset.sum_congr rfl
  intro inner _
  rw [primitiveSpinCCoordinateGradient_complexScalar]

/-- A coordinate multiplier expands a null-multiplier input
coefficientwise. -/
theorem primitiveSpinCCoordinateMultiplication_nullMultiplication
    (coordinate : Fin 3) (parameter : Complex)
    (state : SmoothSection period hPeriod) :
    primitiveSpinCCoordinateMultiplicationLinearMap
        period hPeriod coordinate
        (primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter state) =
      ∑ inner : Fin 3,
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter
          (primitiveSpinCSolidNullVector parameter inner)
          (primitiveSpinCCoordinateMultiplicationLinearMap
            period hPeriod coordinate
            (primitiveSpinCCoordinateMultiplicationLinearMap
              period hPeriod inner state)) := by
  rw [primitiveSpinCNullMultiplicationLinearMap_apply, map_sum]
  apply Finset.sum_congr rfl
  intro inner _
  rw [primitiveSpinCCoordinateMultiplication_complexScalar]

/-- Fiber half-spinor coordinates turn the intrinsic complex section action
into ordinary complex scalar multiplication. -/
theorem primitiveSpinCHalfSpinor_complexScalar_apply
    (scalar : Complex) (state : SmoothSection period hPeriod)
    (base : ThroatBase period hPeriod) :
    d9DoubledMatterFiberHalfSpinorLinearEquiv
        ((d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar state) base) =
      scalar • d9DoubledMatterFiberHalfSpinorLinearEquiv (state base) := by
  rw [d9PrimitiveSpinCComplexScalarSection_apply,
    ← d9PrimitiveSpinCComplexAction_eq_re_add_im,
    d9DoubledMatterFiberHalfSpinorLinearEquiv_complexAction]

/-- Fiber half-spinor coordinates commute with a finite complex section
sum. -/
theorem primitiveSpinCHalfSpinor_complex_sum_apply
    (coefficient : Fin 3 → Complex)
    (states : Fin 3 → SmoothSection period hPeriod)
    (base : ThroatBase period hPeriod) :
    d9DoubledMatterFiberHalfSpinorLinearEquiv
        ((∑ coordinate : Fin 3,
          d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter
            (coefficient coordinate) (states coordinate)) base) =
      ∑ coordinate : Fin 3,
        coefficient coordinate •
          d9DoubledMatterFiberHalfSpinorLinearEquiv
            (states coordinate base) := by
  change
    d9DoubledMatterFiberHalfSpinorLinearEquiv
        (∑ coordinate : Fin 3,
          (d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter
            (coefficient coordinate) (states coordinate)) base) = _
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro coordinate _
  rw [primitiveSpinCHalfSpinor_complexScalar_apply]

/-- Half-spinor coordinates of the twice iterated null gradient. -/
theorem primitiveSpinCHalfSpinor_nullGradient_sq_apply
    (parameter : Complex) (state : SmoothSection period hPeriod)
    (base : ThroatBase period hPeriod) :
    d9DoubledMatterFiberHalfSpinorLinearEquiv
        ((primitiveSpinCNullGradientLinearMap
          period hPeriod parameter
          (primitiveSpinCNullGradientLinearMap
            period hPeriod parameter state)) base) =
      ∑ first : Fin 3, ∑ second : Fin 3,
        (primitiveSpinCSolidNullVector parameter first *
            primitiveSpinCSolidNullVector parameter second) •
          d9DoubledMatterFiberHalfSpinorLinearEquiv
            ((primitiveSpinCCoordinateGradientLinearMap
              period hPeriod first
              (primitiveSpinCCoordinateGradientLinearMap
                period hPeriod second state)) base) := by
  rw [primitiveSpinCNullGradientLinearMap_apply,
    primitiveSpinCHalfSpinor_complex_sum_apply]
  apply Finset.sum_congr rfl
  intro first _
  rw [primitiveSpinCCoordinateGradient_nullGradient,
    primitiveSpinCHalfSpinor_complex_sum_apply, Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro second _
  rw [mul_smul]

/-- Half-spinor coordinates of the twice iterated null multiplier. -/
theorem primitiveSpinCHalfSpinor_nullMultiplication_sq_apply
    (parameter : Complex) (state : SmoothSection period hPeriod)
    (base : ThroatBase period hPeriod) :
    d9DoubledMatterFiberHalfSpinorLinearEquiv
        ((primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter
          (primitiveSpinCNullMultiplicationLinearMap
            period hPeriod parameter state)) base) =
      ∑ first : Fin 3, ∑ second : Fin 3,
        (primitiveSpinCSolidNullVector parameter first *
            primitiveSpinCSolidNullVector parameter second) •
          d9DoubledMatterFiberHalfSpinorLinearEquiv
            ((primitiveSpinCCoordinateMultiplicationLinearMap
              period hPeriod first
              (primitiveSpinCCoordinateMultiplicationLinearMap
                period hPeriod second state)) base) := by
  rw [primitiveSpinCNullMultiplicationLinearMap_apply,
    primitiveSpinCHalfSpinor_complex_sum_apply]
  apply Finset.sum_congr rfl
  intro first _
  rw [primitiveSpinCCoordinateMultiplication_nullMultiplication,
    primitiveSpinCHalfSpinor_complex_sum_apply, Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro second _
  rw [mul_smul]

/-- Fiber form of the coordinate-gradient anticommutator. -/
theorem primitiveSpinCHalfSpinor_coordinateGradient_anticommutator_zeroMode
    (first second : Fin 3)
    (sector : NormalRootChoice) (circleMode : Int)
    (base : ThroatBase period hPeriod) :
    d9DoubledMatterFiberHalfSpinorLinearEquiv
          ((primitiveSpinCCoordinateGradientLinearMap
            period hPeriod first
            (primitiveSpinCCoordinateGradientLinearMap
              period hPeriod second
              (primitiveSpinCHopfZeroModeSection
                period hPeriod sector circleMode))) base) +
        d9DoubledMatterFiberHalfSpinorLinearEquiv
          ((primitiveSpinCCoordinateGradientLinearMap
            period hPeriod second
            (primitiveSpinCCoordinateGradientLinearMap
              period hPeriod first
              (primitiveSpinCHopfZeroModeSection
                period hPeriod sector circleMode))) base) =
      (2 : Complex) •
          d9DoubledMatterFiberHalfSpinorLinearEquiv
            ((primitiveSpinCCoordinateMultiplicationLinearMap
              period hPeriod first
              (primitiveSpinCCoordinateMultiplicationLinearMap
                period hPeriod second
                (primitiveSpinCHopfZeroModeSection
                  period hPeriod sector circleMode))) base) -
        ((2 * d9KroneckerDelta first second : Real) : Complex) •
          d9DoubledMatterFiberHalfSpinorLinearEquiv
            ((primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode) base) := by
  have hSection :=
    primitiveSpinCCoordinateGradient_anticommutator_zeroMode_real
      period hPeriod first second sector circleMode
  have hAt := congrArg
    (fun current : SmoothSection period hPeriod =>
      current base)
    hSection
  let firstGradient : D9DoubledMatterFiber :=
    (primitiveSpinCCoordinateGradientLinearMap
      period hPeriod first
      (primitiveSpinCCoordinateGradientLinearMap
        period hPeriod second
        (primitiveSpinCHopfZeroModeSection
          period hPeriod sector circleMode))) base
  let secondGradient : D9DoubledMatterFiber :=
    (primitiveSpinCCoordinateGradientLinearMap
      period hPeriod second
      (primitiveSpinCCoordinateGradientLinearMap
        period hPeriod first
        (primitiveSpinCHopfZeroModeSection
          period hPeriod sector circleMode))) base
  let product : D9DoubledMatterFiber :=
    (primitiveSpinCCoordinateMultiplicationLinearMap
      period hPeriod first
      (primitiveSpinCCoordinateMultiplicationLinearMap
        period hPeriod second
        (primitiveSpinCHopfZeroModeSection
          period hPeriod sector circleMode))) base
  let zeroMode : D9DoubledMatterFiber :=
    (primitiveSpinCHopfZeroModeSection
      period hPeriod sector circleMode) base
  change
    firstGradient + secondGradient =
      (2 : Real) • product -
        (2 * d9KroneckerDelta first second) • zeroMode at hAt
  change
    d9DoubledMatterFiberHalfSpinorLinearEquiv firstGradient +
        d9DoubledMatterFiberHalfSpinorLinearEquiv secondGradient =
      (2 : Complex) •
          d9DoubledMatterFiberHalfSpinorLinearEquiv product -
        ((2 * d9KroneckerDelta first second : Real) : Complex) •
          d9DoubledMatterFiberHalfSpinorLinearEquiv zeroMode
  calc
    d9DoubledMatterFiberHalfSpinorLinearEquiv firstGradient +
        d9DoubledMatterFiberHalfSpinorLinearEquiv secondGradient =
      d9DoubledMatterFiberHalfSpinorLinearEquiv
        (firstGradient + secondGradient) :=
          (d9DoubledMatterFiberHalfSpinorLinearEquiv.map_add
            firstGradient secondGradient).symm
    _ =
      d9DoubledMatterFiberHalfSpinorLinearEquiv
        ((2 : Real) • product -
          (2 * d9KroneckerDelta first second) • zeroMode) := by
            rw [hAt]
    _ =
      d9DoubledMatterFiberHalfSpinorLinearEquiv
          ((2 : Real) • product) -
        d9DoubledMatterFiberHalfSpinorLinearEquiv
          ((2 * d9KroneckerDelta first second) • zeroMode) :=
            d9DoubledMatterFiberHalfSpinorLinearEquiv.map_sub _ _
    _ =
      (2 : Real) •
          d9DoubledMatterFiberHalfSpinorLinearEquiv product -
        (2 * d9KroneckerDelta first second) •
          d9DoubledMatterFiberHalfSpinorLinearEquiv zeroMode := by
            congr 1
            · exact d9DoubledMatterFiberHalfSpinorLinearEquiv.map_smul
                (2 : Real) product
            · exact d9DoubledMatterFiberHalfSpinorLinearEquiv.map_smul
                (2 * d9KroneckerDelta first second) zeroMode
    _ = _ := by
      simp only [Complex.coe_smul]
      with_reducible_and_instances rfl

/-- Bilinear finite-dimensional null contraction identity. -/
private theorem finThreeNullBilinear_square
    {V : Type} [AddCommGroup V] [Module Complex V]
    (coefficient : Fin 3 → Complex)
    (gradientSquare multiplierSquare : Fin 3 → Fin 3 → V)
    (state : V)
    (hCross :
      ∀ first second,
        gradientSquare first second + gradientSquare second first =
          (2 : Complex) • multiplierSquare first second -
            ((2 * d9KroneckerDelta first second : Real) : Complex) • state)
    (hNull : ∑ coordinate : Fin 3, coefficient coordinate ^ 2 = 0) :
    (∑ first : Fin 3, ∑ second : Fin 3,
        (coefficient first * coefficient second) •
          gradientSquare first second) =
      ∑ first : Fin 3, ∑ second : Fin 3,
        (coefficient first * coefficient second) •
          multiplierSquare first second := by
  apply smul_right_injective V (show (2 : Complex) ≠ 0 by norm_num)
  calc
    (2 : Complex) •
        (∑ first : Fin 3, ∑ second : Fin 3,
          (coefficient first * coefficient second) •
            gradientSquare first second) =
      ∑ first : Fin 3, ∑ second : Fin 3,
        (coefficient first * coefficient second) •
          (gradientSquare first second + gradientSquare second first) := by
      simp [Fin.sum_univ_succ]
      module
    _ =
      ∑ first : Fin 3, ∑ second : Fin 3,
        (coefficient first * coefficient second) •
          ((2 : Complex) • multiplierSquare first second -
            ((2 * d9KroneckerDelta first second : Real) : Complex) •
              state) := by
      apply Finset.sum_congr rfl
      intro first _
      apply Finset.sum_congr rfl
      intro second _
      rw [hCross first second]
    _ =
      (2 : Complex) •
          (∑ first : Fin 3, ∑ second : Fin 3,
            (coefficient first * coefficient second) •
              multiplierSquare first second) -
        (2 * (∑ coordinate : Fin 3, coefficient coordinate ^ 2)) •
          state := by
      simp [Fin.sum_univ_succ, d9KroneckerDelta]
      module
    _ =
      (2 : Complex) •
        (∑ first : Fin 3, ∑ second : Fin 3,
          (coefficient first * coefficient second) •
            multiplierSquare first second) := by
      rw [hNull]
      simp

/-- Null Clifford contraction squares to null-coordinate multiplication
squared on every Hopf zero mode. -/
theorem primitiveSpinCNullGradient_sq_zeroMode
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCNullGradientLinearMap
        period hPeriod parameter
        (primitiveSpinCNullGradientLinearMap
          period hPeriod parameter
          (primitiveSpinCHopfZeroModeSection
            period hPeriod sector circleMode)) =
      primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter
          (primitiveSpinCHopfZeroModeSection
            period hPeriod sector circleMode)) := by
  ext base
  apply d9DoubledMatterFiberHalfSpinorLinearEquiv.injective
  rw [primitiveSpinCHalfSpinor_nullGradient_sq_apply,
    primitiveSpinCHalfSpinor_nullMultiplication_sq_apply]
  exact finThreeNullBilinear_square
    (primitiveSpinCSolidNullVector parameter)
    (fun first second =>
      d9DoubledMatterFiberHalfSpinorLinearEquiv
        ((primitiveSpinCCoordinateGradientLinearMap
          period hPeriod first
          (primitiveSpinCCoordinateGradientLinearMap
            period hPeriod second
            (primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode))) base))
    (fun first second =>
      d9DoubledMatterFiberHalfSpinorLinearEquiv
        ((primitiveSpinCCoordinateMultiplicationLinearMap
          period hPeriod first
          (primitiveSpinCCoordinateMultiplicationLinearMap
            period hPeriod second
            (primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode))) base))
    (d9DoubledMatterFiberHalfSpinorLinearEquiv
      ((primitiveSpinCHopfZeroModeSection
        period hPeriod sector circleMode) base))
    (fun first second =>
      primitiveSpinCHalfSpinor_coordinateGradient_anticommutator_zeroMode
        period hPeriod first second sector circleMode base)
    (primitiveSpinCSolidNullVector_sq_sum parameter)

/-- The intrinsic complex action commutes with real scalar multiplication. -/
theorem d9PrimitiveSpinCComplexScalarSection_real_smul
    (complexScalar : Complex) (realScalar : Real)
    (state : SmoothSection period hPeriod) :
    d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter complexScalar (realScalar • state) =
      realScalar •
        d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter complexScalar state := by
  change
    d9PrimitiveSpinCComplexScalarSectionLinearMap
        period hPeriod .positiveQuarter complexScalar
        (realScalar • state) = _
  rw [map_smul]
  rfl

/-- The first tangential null combination satisfies the uniform second
first-order block equation. -/
theorem d9PrimitiveSpinCGeometricDiracOperator_nullGradient_zeroMode
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) :
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter
        (primitiveSpinCNullGradientLinearMap
          period hPeriod parameter
          (primitiveSpinCHopfZeroModeSection
            period hPeriod sector circleMode)) =
      (2 : Real) •
          primitiveSpinCNullMultiplicationLinearMap
            period hPeriod parameter
            (primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode) +
        normalRootLeviCivitaCorrectedFrequency
            period sector circleMode •
          primitiveSpinCNullGradientLinearMap
            period hPeriod parameter
            (primitiveSpinCHopfZeroModeSection
              period hPeriod sector circleMode) := by
  simp only [primitiveSpinCNullGradientLinearMap_apply,
    primitiveSpinCNullMultiplicationLinearMap_apply]
  change
    d9PrimitiveSpinCGeometricDiracRealLinearMap
        period hPeriod
        (∑ coordinate : Fin 3,
          d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter
            (primitiveSpinCSolidNullVector parameter coordinate)
            (primitiveSpinCCoordinateGradientLinearMap
              period hPeriod coordinate
              (primitiveSpinCHopfZeroModeSection
                period hPeriod sector circleMode))) = _
  rw [map_sum]
  simp only [d9PrimitiveSpinCGeometricDiracRealLinearMap_apply]
  simp_rw [d9PrimitiveSpinCGeometricDiracOperator_complexScalar,
    primitiveSpinCCoordinateGradient_zeroMode,
    primitiveSpinCHopfFirstSphereTangentialGeometricDiracOperator_eq,
    ← primitiveSpinCHopfCoordinateMulZeroMode_eq_firstSphere,
    d9PrimitiveSpinCComplexScalarSection_add_state,
    d9PrimitiveSpinCComplexScalarSection_real_smul]
  rw [Finset.sum_add_distrib, Finset.smul_sum, Finset.smul_sum]
  simp only [primitiveSpinCCoordinateMultiplicationLinearMap_apply]

/-- Degree-`p` smooth null-harmonic section `M_a^p ψ`. -/
def primitiveSpinCNullPowerSection
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) :
    Nat → SmoothSection period hPeriod
  | 0 =>
      primitiveSpinCHopfZeroModeSection
        period hPeriod sector circleMode
  | degree + 1 =>
      primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (primitiveSpinCNullPowerSection
          parameter sector circleMode degree)

/-- Auxiliary sequence `M_a^p G_a ψ`. -/
def primitiveSpinCNullGradientPowerSection
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) :
    Nat → SmoothSection period hPeriod
  | 0 =>
      primitiveSpinCNullGradientLinearMap
        period hPeriod parameter
        (primitiveSpinCHopfZeroModeSection
          period hPeriod sector circleMode)
  | degree + 1 =>
      primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (primitiveSpinCNullGradientPowerSection
          parameter sector circleMode degree)

@[simp]
theorem primitiveSpinCNullPowerSection_zero
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCNullPowerSection
        period hPeriod parameter sector circleMode 0 =
      primitiveSpinCHopfZeroModeSection
        period hPeriod sector circleMode :=
  rfl

@[simp]
theorem primitiveSpinCNullPowerSection_succ
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) (degree : Nat) :
    primitiveSpinCNullPowerSection
        period hPeriod parameter sector circleMode (degree + 1) =
      primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (primitiveSpinCNullPowerSection
          period hPeriod parameter sector circleMode degree) :=
  rfl

@[simp]
theorem primitiveSpinCNullGradientPowerSection_zero
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCNullGradientPowerSection
        period hPeriod parameter sector circleMode 0 =
      primitiveSpinCNullGradientLinearMap
        period hPeriod parameter
        (primitiveSpinCHopfZeroModeSection
          period hPeriod sector circleMode) :=
  rfl

@[simp]
theorem primitiveSpinCNullGradientPowerSection_succ
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) (degree : Nat) :
    primitiveSpinCNullGradientPowerSection
        period hPeriod parameter sector circleMode (degree + 1) =
      primitiveSpinCNullMultiplicationLinearMap
        period hPeriod parameter
        (primitiveSpinCNullGradientPowerSection
          period hPeriod parameter sector circleMode degree) :=
  rfl

/-- Applying the null Clifford gradient to `M_a^p ψ` gives
`M_a^p G_a ψ`. -/
theorem primitiveSpinCNullGradient_powerSection
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) (degree : Nat) :
    primitiveSpinCNullGradientLinearMap
        period hPeriod parameter
        (primitiveSpinCNullPowerSection
          period hPeriod parameter sector circleMode degree) =
      primitiveSpinCNullGradientPowerSection
        period hPeriod parameter sector circleMode degree := by
  induction degree with
  | zero =>
      rw [primitiveSpinCNullPowerSection_zero,
        primitiveSpinCNullGradientPowerSection_zero]
  | succ degree ih =>
      rw [primitiveSpinCNullPowerSection_succ,
        primitiveSpinCNullGradientPowerSection_succ,
        primitiveSpinCNullGradient_nullMultiplication, ih]

/-- Applying the null Clifford gradient to `M_a^p G_a ψ` produces
`M_a^(p+2) ψ`; nullness removes the trace term. -/
theorem primitiveSpinCNullGradient_gradientPowerSection
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) (degree : Nat) :
    primitiveSpinCNullGradientLinearMap
        period hPeriod parameter
        (primitiveSpinCNullGradientPowerSection
          period hPeriod parameter sector circleMode degree) =
      primitiveSpinCNullPowerSection
        period hPeriod parameter sector circleMode (degree + 2) := by
  induction degree with
  | zero =>
      rw [primitiveSpinCNullGradientPowerSection_zero,
        primitiveSpinCNullGradient_sq_zeroMode]
      rfl
  | succ degree ih =>
      rw [primitiveSpinCNullGradientPowerSection_succ,
        primitiveSpinCNullGradient_nullMultiplication, ih]
      rfl

/-- Uniform first-order Dirac recurrence for the null-power pair. -/
theorem primitiveSpinCNullPower_dirac_recurrence
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) (degree : Nat) :
    (d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (primitiveSpinCNullPowerSection
            period hPeriod parameter sector circleMode (degree + 1)) =
        (-normalRootLeviCivitaCorrectedFrequency
            period sector circleMode) •
            primitiveSpinCNullPowerSection
              period hPeriod parameter sector circleMode (degree + 1) +
          ((degree + 1 : Nat) : Real) •
            primitiveSpinCNullGradientPowerSection
              period hPeriod parameter sector circleMode degree) ∧
      (d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (primitiveSpinCNullGradientPowerSection
            period hPeriod parameter sector circleMode degree) =
        ((degree + 2 : Nat) : Real) •
            primitiveSpinCNullPowerSection
              period hPeriod parameter sector circleMode (degree + 1) +
          normalRootLeviCivitaCorrectedFrequency
              period sector circleMode •
            primitiveSpinCNullGradientPowerSection
              period hPeriod parameter sector circleMode degree) := by
  induction degree with
  | zero =>
      constructor
      · rw [primitiveSpinCNullPowerSection_succ,
          primitiveSpinCNullPowerSection_zero,
          d9PrimitiveSpinCGeometricDiracOperator_nullMultiplication,
          primitiveSpinCHopfZeroModeGeometricDiracOperator_eigen,
          map_smul]
        norm_num
      · simpa using
          d9PrimitiveSpinCGeometricDiracOperator_nullGradient_zeroMode
            period hPeriod parameter sector circleMode
  | succ degree ih =>
      constructor
      · rw [show degree.succ + 1 = (degree + 1) + 1 by omega,
          primitiveSpinCNullPowerSection_succ,
          d9PrimitiveSpinCGeometricDiracOperator_nullMultiplication,
          ih.1, map_add, map_smul, map_smul,
          primitiveSpinCNullGradient_powerSection,
          ← primitiveSpinCNullPowerSection_succ,
          ← primitiveSpinCNullGradientPowerSection_succ]
        push_cast
        module
      · rw [primitiveSpinCNullGradientPowerSection_succ,
          d9PrimitiveSpinCGeometricDiracOperator_nullMultiplication,
          ih.2, map_add, map_smul, map_smul,
          primitiveSpinCNullGradient_gradientPowerSection,
          ← primitiveSpinCNullPowerSection_succ,
          ← primitiveSpinCNullGradientPowerSection_succ]
        push_cast
        module

/-- Every positive null-power section is a genuine squared-Dirac
eigensection with spherical energy `p(p+1)`. -/
theorem primitiveSpinCNullPower_geometricDirac_sq
    (parameter : Complex)
    (sector : NormalRootChoice) (circleMode : Int) (positiveLevel : Nat) :
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter
        (d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (primitiveSpinCNullPowerSection
            period hPeriod parameter sector circleMode
            (positiveLevel + 1))) =
      (normalRootLeviCivitaCorrectedFrequency
            period sector circleMode ^ 2 +
          ((positiveLevel + 1 : Nat) : Real) *
            ((positiveLevel + 2 : Nat) : Real)) •
        primitiveSpinCNullPowerSection
          period hPeriod parameter sector circleMode
          (positiveLevel + 1) := by
  have hRecurrence :=
    primitiveSpinCNullPower_dirac_recurrence
      period hPeriod parameter sector circleMode positiveLevel
  rw [hRecurrence.1,
    d9PrimitiveSpinCGeometricDiracOperator_add,
    d9PrimitiveSpinCGeometricDiracOperator_real_smul,
    d9PrimitiveSpinCGeometricDiracOperator_real_smul,
    hRecurrence.1, hRecurrence.2]
  module

/-- Null-curve parameter attached to one physical multiplicity label. -/
def primitiveSpinCNullGeometricParameter
    (positiveLevel : Nat)
    (multiplicity :
      Fin (primitiveSphereModeDegeneracy (positiveLevel + 1))) :
    Complex :=
  primitiveSpinCSolidPacketParameter (positiveLevel + 1)
    (Fin.cast
      (primitiveSpinCSolidPacket_degeneracy_eq (positiveLevel + 1))
      multiplicity)

/-- Canonical genuine smooth squared seed at every positive level and every
physical multiplicity. -/
def primitiveSpinCAllLevelNullHarmonicSquaredSeed
    (positiveLevel : Nat)
    (multiplicity :
      Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)))
    (sector : NormalRootChoice) (circleMode : Int) :
    PrimitiveSpinCHarmonicSquaredSeed4D
      period hPeriod positiveLevel sector circleMode where
  scalarSection :=
    primitiveSpinCNullPowerSection
      period hPeriod
      (primitiveSpinCNullGeometricParameter positiveLevel multiplicity)
      sector circleMode (positiveLevel + 1)
  dirac_sq_scalar := by
    rw [primitiveSpinCHarmonicSphereEnergy_eq]
    exact primitiveSpinCNullPower_geometricDirac_sq
      period hPeriod
      (primitiveSpinCNullGeometricParameter positiveLevel multiplicity)
      sector circleMode positiveLevel

/-- Complete positive-level squared-seed tower obtained by the single
null-power recurrence. -/
def primitiveSpinCAllLevelNullHarmonicSquaredSeedTower :
    PrimitiveSpinCAllPositiveHarmonicSquaredSeedTower4D
      period hPeriod where
  seed := fun positiveLevel multiplicity sector circleMode =>
    primitiveSpinCAllLevelNullHarmonicSquaredSeed
      period hPeriod positiveLevel multiplicity sector circleMode

/-- Complete first-order all-level Dirac tower generated canonically from
the squared seeds. -/
def primitiveSpinCAllLevelNullHarmonicDiracSeedTower :
    PrimitiveSpinCAllPositiveHarmonicSeedTower4D period hPeriod :=
  (primitiveSpinCAllLevelNullHarmonicSquaredSeedTower
    period hPeriod).toDiracSeedTower

/-- The reconstructed first-order gradient is exactly `p M^(p-1) Gψ`. -/
theorem primitiveSpinCAllLevelNullHarmonicSquaredSeed_gradientSection
    (positiveLevel : Nat)
    (multiplicity :
      Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)))
    (sector : NormalRootChoice) (circleMode : Int) :
    (primitiveSpinCAllLevelNullHarmonicSquaredSeed
        period hPeriod positiveLevel multiplicity sector circleMode
      ).gradientSection =
      ((positiveLevel + 1 : Nat) : Real) •
        primitiveSpinCNullGradientPowerSection
          period hPeriod
          (primitiveSpinCNullGeometricParameter positiveLevel multiplicity)
          sector circleMode positiveLevel := by
  unfold primitiveSpinCAllLevelNullHarmonicSquaredSeed
    PrimitiveSpinCHarmonicSquaredSeed4D.gradientSection
  rw [(primitiveSpinCNullPower_dirac_recurrence
    period hPeriod
    (primitiveSpinCNullGeometricParameter positiveLevel multiplicity)
    sector circleMode positiveLevel).1]
  module

/-! ## Faithfulness of the smooth all-level packet -/

/-- Cover representative over an arbitrary monopole-sphere point. -/
def primitiveSpinCNullPacketWitnessCover
    (point : MonopoleSphere) : ThroatCover period hPeriod :=
  ⟨equatorialTwoSphereHomeomorph.symm point, 0⟩

/-- Quotient-throat point over an arbitrary monopole-sphere point. -/
def primitiveSpinCNullPacketWitnessBase
    (point : MonopoleSphere) : ThroatBase period hPeriod :=
  mappingTorusMk (ThroatData period hPeriod)
    (primitiveSpinCNullPacketWitnessCover period hPeriod point)

/-- North local chart over an arbitrary non-south-pole sphere point. -/
def primitiveSpinCNullPacketWitnessIndex
    (point : MonopoleSphere) :
    D9PrimitiveSpinCIndex period hPeriod :=
  (primitiveSpinCNullPacketWitnessCover period hPeriod point, .north)

@[simp]
theorem primitiveSpinCNullPacketWitnessCover_sphere
    (point : MonopoleSphere) :
    d9MonopoleSphereCoverProjection period hPeriod
        (primitiveSpinCNullPacketWitnessCover
          period hPeriod point) =
      point := by
  simp [primitiveSpinCNullPacketWitnessCover,
    d9MonopoleSphereCoverProjection]

@[simp]
theorem primitiveSpinCNullPacketWitnessBase_coordinate
    (point : MonopoleSphere) (coordinate : Fin 3) :
    d9PrimitiveMonopoleBaseCoordinate
        period hPeriod coordinate
        (primitiveSpinCNullPacketWitnessBase period hPeriod point) =
      monopoleSphereCoordinate point coordinate := by
  unfold d9PrimitiveMonopoleBaseCoordinate
    primitiveSpinCNullPacketWitnessBase
  rw [d9ThroatMonopoleSphereProjection_mk,
    primitiveSpinCNullPacketWitnessCover_sphere]

theorem primitiveSpinCNullPacketWitnessBase_mem
    (point : MonopoleSphere)
    (hNorth : point ∈ monopoleChartDomain .north) :
    primitiveSpinCNullPacketWitnessBase period hPeriod point ∈
      d9PrimitiveSpinCBaseSet period hPeriod
        (primitiveSpinCNullPacketWitnessIndex period hPeriod point) := by
  constructor
  · exact ((mappingTorusMk_isCoveringMap
      (ThroatData period hPeriod)).isLocalHomeomorph)
      |>.apply_self_mem_localInverseAt_source
  · change
      d9ThroatMonopoleSphereProjection period hPeriod
          (primitiveSpinCNullPacketWitnessBase
            period hPeriod point) ∈
        monopoleChartDomain .north
    rw [primitiveSpinCNullPacketWitnessBase,
      d9ThroatMonopoleSphereProjection_mk,
      primitiveSpinCNullPacketWitnessCover_sphere]
    exact hNorth

/-- Normal Fourier matter evaluated at an arbitrary sphere witness. -/
def primitiveSpinCNullPacketWitnessMode
    (point : MonopoleSphere)
    (sector : NormalRootChoice) (circleMode : Int) :
    D9DoubledMatterFiber :=
  primitiveSpinCNormalModeDoubledLift
    period hPeriod sector circleMode
    (primitiveSpinCNullPacketWitnessCover period hPeriod point)

theorem primitiveSpinCNullPacketWitnessMode_halfSpinor
    (point : MonopoleSphere)
    (sector : NormalRootChoice) (circleMode : Int) :
    d9DoubledMatterFiberHalfSpinorLinearEquiv
        (primitiveSpinCNullPacketWitnessMode
          period hPeriod point sector circleMode) =
      match sector with
      | .positiveQuarter => (ambientHalfGammaPositiveEigenvector, 0)
      | .negativeQuarter => (0, ambientHalfGammaPositiveEigenvector) := by
  have zero_apply (choice : NormalRootChoice)
      (coverPoint : ThroatCover period hPeriod) :
      (0 : SmoothThroatMatterSpinorLift period hPeriod choice)
          coverPoint = 0 := rfl
  cases sector <;>
    apply Prod.ext <;>
    funext index <;>
    fin_cases index <;>
    simp [primitiveSpinCNullPacketWitnessMode,
      primitiveSpinCNullPacketWitnessCover,
      primitiveSpinCNormalModeDoubledLift,
      normalRootMatterModeLift, normalRootMatterModeValue,
      normalRootSpinFramePhase, normalRootSpinFramePhaseAngle,
      d9MatterGammaPositiveEigenlineCLM_apply,
      d9MatterComplexAction, d9MatterGammaPositiveEigenvector,
      ambientHalfGammaPositiveEigenvector, zero_apply]

@[simp]
theorem primitiveSpinCNullPacketWitnessMode_sectorCoefficient
    (point : MonopoleSphere)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        (primitiveSpinCNullPacketWitnessMode
          period hPeriod point sector circleMode) = 1 := by
  cases sector
  · change
      (d9DoubledMatterFiberHalfSpinorLinearEquiv
        (primitiveSpinCNullPacketWitnessMode
          period hPeriod point .positiveQuarter circleMode)).1 0 = 1
    rw [primitiveSpinCNullPacketWitnessMode_halfSpinor]
    rfl
  · change
      (d9DoubledMatterFiberHalfSpinorLinearEquiv
        (primitiveSpinCNullPacketWitnessMode
          period hPeriod point .negativeQuarter circleMode)).2 0 = 1
    rw [primitiveSpinCNullPacketWitnessMode_halfSpinor]
    rfl

@[simp]
theorem primitiveSpinCNullPacketWitnessMode_gamma_two_sectorCoefficient
    (point : MonopoleSphere)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        (d9DoubledMatterFiberCliffordGammaCLM 2
          (primitiveSpinCNullPacketWitnessMode
            period hPeriod point sector circleMode)) = 0 := by
  cases sector
  · change
      (d9DoubledMatterFiberHalfSpinorLinearEquiv
        (d9DoubledMatterFiberCliffordGammaCLM 2
          (primitiveSpinCNullPacketWitnessMode
            period hPeriod point .positiveQuarter circleMode))).1 0 = 0
    rw [d9DoubledMatterFiberCliffordGammaCLM_apply,
      d9DoubledMatterFiberHalfSpinorLinearEquiv_gamma,
      d9DoubledMatterSpinorCliffordGamma_two,
      primitiveSpinCNullPacketWitnessMode_halfSpinor]
    simp
  · change
      (d9DoubledMatterFiberHalfSpinorLinearEquiv
        (d9DoubledMatterFiberCliffordGammaCLM 2
          (primitiveSpinCNullPacketWitnessMode
            period hPeriod point .negativeQuarter circleMode))).2 0 = 0
    rw [d9DoubledMatterFiberCliffordGammaCLM_apply,
      d9DoubledMatterFiberHalfSpinorLinearEquiv_gamma,
      d9DoubledMatterSpinorCliffordGamma_two,
      primitiveSpinCNullPacketWitnessMode_halfSpinor]
    simp

@[simp]
theorem primitiveSpinCNullPacketWitnessMode_firstFrame_sectorCoefficient
    (point : MonopoleSphere)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        (d9PrimitiveSpinCHopfFirstFrameCLM sector
          (primitiveSpinCNullPacketWitnessMode
            period hPeriod point sector circleMode)) = 1 := by
  rw [d9PrimitiveSpinCHopfFirstFrameCLM_apply, map_sub,
    ←
      P0EFTJanusProgramPD9PrimitiveSpinCFirstPositiveSphereComplexMultiplicity4D.d9PrimitiveSpinCComplexAction_I,
    primitiveSpinCGeometricZeroModeSectorFiberCoefficient_complexAction,
    primitiveSpinCNullPacketWitnessMode_sectorCoefficient,
    primitiveSpinCNullPacketWitnessMode_gamma_two_sectorCoefficient]
  simp

@[simp]
theorem primitiveSpinCNullPacketWitnessMode_secondFrame_sectorCoefficient
    (point : MonopoleSphere)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        (d9PrimitiveSpinCHopfSecondFrameCLM sector
          (primitiveSpinCNullPacketWitnessMode
            period hPeriod point sector circleMode)) = 1 := by
  rw [d9PrimitiveSpinCHopfSecondFrameCLM_apply, map_add,
    ←
      P0EFTJanusProgramPD9PrimitiveSpinCFirstPositiveSphereComplexMultiplicity4D.d9PrimitiveSpinCComplexAction_I,
    primitiveSpinCGeometricZeroModeSectorFiberCoefficient_complexAction,
    primitiveSpinCNullPacketWitnessMode_sectorCoefficient,
    primitiveSpinCNullPacketWitnessMode_gamma_two_sectorCoefficient]
  simp

/-- Local Hopf zero-mode value at an arbitrary north-chart witness. -/
def primitiveSpinCNullPacketHopfZeroLocal
    (point : MonopoleSphere)
    (sector : NormalRootChoice) (circleMode : Int) :
    D9DoubledMatterFiber :=
  primitiveSpinCGeometricSectionLocalCoordinate
    period hPeriod
    (primitiveSpinCNullPacketWitnessIndex period hPeriod point)
    (primitiveSpinCNullPacketWitnessBase period hPeriod point)
    (primitiveSpinCHopfZeroModeSection
      period hPeriod sector circleMode)

theorem primitiveSpinCNullPacketHopfZeroLocal_sectorCoefficient
    (point : MonopoleSphere)
    (hNorth : point ∈ monopoleChartDomain .north)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        (primitiveSpinCNullPacketHopfZeroLocal
          period hPeriod point sector circleMode) =
      primitiveMonopoleZeroNorthValue point +
        primitiveMonopoleZeroComplementNorthValue point := by
  unfold primitiveSpinCNullPacketHopfZeroLocal
  rw [primitiveSpinCGeometricSectionLocalCoordinate_hopfZeroMode
    period hPeriod sector circleMode
    (primitiveSpinCNullPacketWitnessIndex period hPeriod point)
    (primitiveSpinCNullPacketWitnessBase period hPeriod point)
    (primitiveSpinCNullPacketWitnessBase_mem
      period hPeriod point hNorth)]
  change
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        ((primitiveSpinCHopfZeroModeLocalGaugeFamily
          period hPeriod sector circleMode).localValue
            (primitiveSpinCNullPacketWitnessCover
              period hPeriod point, .north)
            (mappingTorusMk (ThroatData period hPeriod)
              (primitiveSpinCNullPacketWitnessCover
                period hPeriod point))) = _
  rw [primitiveSpinCHopfZeroModeLocalGaugeFamily_mk,
    primitiveSpinCNullPacketWitnessCover_sphere, map_add,
    primitiveSpinCGeometricZeroModeSectorFiberCoefficient_complexAction,
    primitiveSpinCGeometricZeroModeSectorFiberCoefficient_complexAction]
  change
    primitiveMonopoleZeroLocalValue .north point *
        primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
          (d9PrimitiveSpinCHopfFirstFrameCLM sector
            (primitiveSpinCNullPacketWitnessMode
              period hPeriod point sector circleMode)) +
      primitiveMonopoleZeroComplementLocalValue .north point *
        primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
          (d9PrimitiveSpinCHopfSecondFrameCLM sector
            (primitiveSpinCNullPacketWitnessMode
              period hPeriod point sector circleMode)) = _
  rw [
    primitiveSpinCNullPacketWitnessMode_firstFrame_sectorCoefficient,
    primitiveSpinCNullPacketWitnessMode_secondFrame_sectorCoefficient]
  simp [primitiveMonopoleZeroLocalValue,
    primitiveMonopoleZeroComplementLocalValue]

/-- One complex coefficient extracted after north-chart local evaluation. -/
def primitiveSpinCNullPacketLocalCoefficientLinearMap
    (point : MonopoleSphere) (sector : NormalRootChoice) :
    SmoothSection period hPeriod →ₗ[Real] Complex :=
  (primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector).comp
    (primitiveSpinCGeometricSectionLocalCoordinate
      period hPeriod
      (primitiveSpinCNullPacketWitnessIndex period hPeriod point)
      (primitiveSpinCNullPacketWitnessBase period hPeriod point))

/-- The local coefficient extractor respects the intrinsic complex action. -/
theorem primitiveSpinCNullPacketLocalCoefficient_complexScalar
    (point : MonopoleSphere)
    (hNorth : point ∈ monopoleChartDomain .north)
    (sector : NormalRootChoice)
    (scalar : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullPacketLocalCoefficientLinearMap
        period hPeriod point sector (scalar • state) =
      scalar *
        primitiveSpinCNullPacketLocalCoefficientLinearMap
          period hPeriod point sector state := by
  change
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        (primitiveSpinCGeometricSectionLocalCoordinate
          period hPeriod
          (primitiveSpinCNullPacketWitnessIndex period hPeriod point)
          (primitiveSpinCNullPacketWitnessBase period hPeriod point)
          (d9PrimitiveSpinCComplexScalarSection
            period hPeriod .positiveQuarter scalar state)) = _
  rw [primitiveSpinCGeometricSectionLocalCoordinate_complexScalar_eq_action
    period hPeriod
    (primitiveSpinCNullPacketWitnessIndex period hPeriod point)
    (primitiveSpinCNullPacketWitnessBase period hPeriod point)
    (primitiveSpinCNullPacketWitnessBase_mem
      period hPeriod point hNorth),
    primitiveSpinCGeometricZeroModeSectorFiberCoefficient_complexAction]
  rfl

theorem primitiveSpinCNullPacketLocalCoefficient_complexScalarSection
    (point : MonopoleSphere)
    (hNorth : point ∈ monopoleChartDomain .north)
    (sector : NormalRootChoice)
    (scalar : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullPacketLocalCoefficientLinearMap
        period hPeriod point sector
        (d9PrimitiveSpinCComplexScalarSection
          period hPeriod .positiveQuarter scalar state) =
      scalar *
        primitiveSpinCNullPacketLocalCoefficientLinearMap
          period hPeriod point sector state := by
  change
    primitiveSpinCNullPacketLocalCoefficientLinearMap
        period hPeriod point sector (scalar • state) = _
  exact primitiveSpinCNullPacketLocalCoefficient_complexScalar
    period hPeriod point hNorth sector scalar state

/-- The local coefficient extractor turns coordinate multiplication into
ordinary multiplication by that coordinate. -/
theorem primitiveSpinCNullPacketLocalCoefficient_coordinateMultiplication
    (point : MonopoleSphere)
    (sector : NormalRootChoice) (coordinate : Fin 3)
    (state : SmoothSection period hPeriod) :
    primitiveSpinCNullPacketLocalCoefficientLinearMap
        period hPeriod point sector
        (primitiveSpinCCoordinateMultiplicationLinearMap
          period hPeriod coordinate state) =
      (monopoleSphereCoordinate point coordinate : Complex) *
        primitiveSpinCNullPacketLocalCoefficientLinearMap
          period hPeriod point sector state := by
  change
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        (primitiveSpinCGeometricSectionLocalCoordinate
          period hPeriod
          (primitiveSpinCNullPacketWitnessIndex period hPeriod point)
          (primitiveSpinCNullPacketWitnessBase period hPeriod point)
          (d9PrimitiveSpinCRealScalarMulSection
            period hPeriod .positiveQuarter
            (d9PrimitiveMonopoleBaseCoordinate
              period hPeriod coordinate)
            (d9PrimitiveMonopoleBaseCoordinate_contMDiff
              period hPeriod coordinate)
            state)) = _
  rw [primitiveSpinCGeometricSectionLocalCoordinate_realScalarMul,
    map_smul, primitiveSpinCNullPacketWitnessBase_coordinate]
  rfl

/-- Evaluation of one null linear form on a physical sphere point. -/
def primitiveSpinCNullSphereScalar
    (parameter : Complex) (point : MonopoleSphere) : Complex :=
  ∑ coordinate : Fin 3,
    primitiveSpinCSolidNullVector parameter coordinate *
      monopoleSphereCoordinate point coordinate

/-- Local coefficients turn the smooth null multiplier into multiplication
by the corresponding scalar null form. -/
theorem primitiveSpinCNullPacketLocalCoefficient_nullMultiplication
    (point : MonopoleSphere)
    (hNorth : point ∈ monopoleChartDomain .north)
    (sector : NormalRootChoice)
    (parameter : Complex) (state : SmoothSection period hPeriod) :
    primitiveSpinCNullPacketLocalCoefficientLinearMap
        period hPeriod point sector
        (primitiveSpinCNullMultiplicationLinearMap
          period hPeriod parameter state) =
      primitiveSpinCNullSphereScalar parameter point *
        primitiveSpinCNullPacketLocalCoefficientLinearMap
          period hPeriod point sector state := by
  rw [primitiveSpinCNullMultiplicationLinearMap_apply, map_sum]
  simp_rw [primitiveSpinCNullPacketLocalCoefficient_complexScalarSection
      period hPeriod point hNorth,
    primitiveSpinCNullPacketLocalCoefficient_coordinateMultiplication]
  unfold primitiveSpinCNullSphereScalar
  simp [Fin.sum_univ_succ]
  ring

/-- Exact local scalar formula for every power in the smooth packet. -/
theorem primitiveSpinCNullPacketLocalCoefficient_powerSection
    (point : MonopoleSphere)
    (hNorth : point ∈ monopoleChartDomain .north)
    (sector : NormalRootChoice) (circleMode : Int)
    (parameter : Complex) (degree : Nat) :
    primitiveSpinCNullPacketLocalCoefficientLinearMap
        period hPeriod point sector
        (primitiveSpinCNullPowerSection
          period hPeriod parameter sector circleMode degree) =
      primitiveSpinCNullSphereScalar parameter point ^ degree *
        primitiveSpinCNullPacketLocalCoefficientLinearMap
          period hPeriod point sector
          (primitiveSpinCHopfZeroModeSection
            period hPeriod sector circleMode) := by
  induction degree with
  | zero =>
      rw [primitiveSpinCNullPowerSection_zero]
      simp
  | succ degree ih =>
      rw [primitiveSpinCNullPowerSection_succ,
        primitiveSpinCNullPacketLocalCoefficient_nullMultiplication
          period hPeriod point hNorth,
        ih, pow_succ]
      ring

/-- On the positive-coordinate part of the north chart, the common Hopf
zero-mode coefficient never vanishes. -/
theorem primitiveSpinCNullPacketLocalCoefficient_zeroMode_ne_zero
    (point : MonopoleSphere)
    (hNorth : point ∈ monopoleChartDomain .north)
    (hCoordinate :
      0 < monopoleSphereCoordinate point 0)
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCNullPacketLocalCoefficientLinearMap
        period hPeriod point sector
        (primitiveSpinCHopfZeroModeSection
          period hPeriod sector circleMode) ≠ 0 := by
  change
    primitiveSpinCGeometricZeroModeSectorFiberCoefficientLinearMap sector
        (primitiveSpinCNullPacketHopfZeroLocal
          period hPeriod point sector circleMode) ≠ 0
  rw [primitiveSpinCNullPacketHopfZeroLocal_sectorCoefficient
    period hPeriod point hNorth]
  apply Complex.ne_zero_of_re_pos
  have hRadicand :
      0 < 1 + monopoleSphereCoordinate point 2 :=
    one_add_monopoleSphereCoordinate_two_pos_of_mem_north point hNorth
  have hSqrt :
      0 < Real.sqrt (1 + monopoleSphereCoordinate point 2) :=
    Real.sqrt_pos.2 hRadicand
  simp only [primitiveMonopoleZeroNorthValue,
    primitiveMonopoleZeroComplementNorthValue,
    Complex.add_re, Complex.ofReal_re, Complex.real_smul,
    map_star, Complex.star_def, Complex.conj_re,
    monopoleSphereXY, Complex.mul_re, Complex.ofReal_im,
    Complex.conj_im, Complex.neg_im, zero_mul, sub_zero]
  exact add_pos hSqrt (mul_pos (inv_pos.mpr hSqrt) hCoordinate)

/-- Uniform smooth packet indexed exactly like the algebraic null-curve
packet. -/
def primitiveSpinCNullHarmonicSmoothPacket
    (degree : Nat) (multiplicity : Fin (2 * degree + 1))
    (sector : NormalRootChoice) (circleMode : Int) :
    SmoothSection period hPeriod :=
  primitiveSpinCNullPowerSection
    period hPeriod
    (primitiveSpinCSolidPacketParameter degree multiplicity)
    sector circleMode degree

/-- A vanishing complex combination of smooth packet sections forces the
same scalar combination to vanish on every positive-coordinate north-chart
sphere point. -/
theorem primitiveSpinCNullHarmonicSmoothPacket_scalar_relation
    (degree : Nat)
    (coefficients : Fin (2 * degree + 1) → Complex)
    (sector : NormalRootChoice) (circleMode : Int)
    (hSum :
      ∑ multiplicity : Fin (2 * degree + 1),
          coefficients multiplicity •
            primitiveSpinCNullHarmonicSmoothPacket
              period hPeriod degree multiplicity sector circleMode = 0)
    (point : MonopoleSphere)
    (hNorth : point ∈ monopoleChartDomain .north)
    (hCoordinate :
      0 < monopoleSphereCoordinate point 0) :
    ∑ multiplicity : Fin (2 * degree + 1),
        coefficients multiplicity *
          primitiveSpinCNullSphereScalar
              (primitiveSpinCSolidPacketParameter degree multiplicity)
              point ^ degree = 0 := by
  have hLocal := congrArg
    (primitiveSpinCNullPacketLocalCoefficientLinearMap
      period hPeriod point sector)
    hSum
  simp only [map_sum, map_zero] at hLocal
  simp_rw [primitiveSpinCNullPacketLocalCoefficient_complexScalar
      period hPeriod point hNorth,
    primitiveSpinCNullHarmonicSmoothPacket,
    primitiveSpinCNullPacketLocalCoefficient_powerSection
      period hPeriod point hNorth] at hLocal
  have hFactored :
      (∑ multiplicity : Fin (2 * degree + 1),
          coefficients multiplicity *
            primitiveSpinCNullSphereScalar
                (primitiveSpinCSolidPacketParameter degree multiplicity)
                point ^ degree) *
        primitiveSpinCNullPacketLocalCoefficientLinearMap
          period hPeriod point sector
          (primitiveSpinCHopfZeroModeSection
            period hPeriod sector circleMode) = 0 := by
    rw [Finset.sum_mul]
    convert hLocal using 1
    apply Finset.sum_congr rfl
    intro multiplicity _
    ring
  exact (mul_eq_zero.mp hFactored).resolve_right
    (primitiveSpinCNullPacketLocalCoefficient_zeroMode_ne_zero
      period hPeriod point hNorth hCoordinate sector circleMode)

/-- Evaluation of the algebraic packet on physical sphere coordinates is
exactly the scalar used by the smooth null-power construction. -/
theorem primitiveSpinCSolidHarmonicPacket_eval_sphere
    (degree : Nat) (multiplicity : Fin (2 * degree + 1))
    (point : MonopoleSphere) :
    MvPolynomial.eval
        (fun coordinate : Fin 3 =>
          (monopoleSphereCoordinate point coordinate : Complex))
        (primitiveSpinCSolidHarmonicPacket degree multiplicity) =
      primitiveSpinCNullSphereScalar
          (primitiveSpinCSolidPacketParameter degree multiplicity)
          point ^ degree := by
  unfold primitiveSpinCSolidHarmonicPacket
    primitiveSpinCSolidNullLinearForm primitiveSpinCNullSphereScalar
  rw [map_pow]
  congr 1
  simp [Fin.sum_univ_succ]

/-- A degree-`p` null packet member scales by the `p`-th power under
simultaneous scaling of all three evaluation coordinates. -/
theorem primitiveSpinCSolidHarmonicPacket_eval_smul
    (degree : Nat) (multiplicity : Fin (2 * degree + 1))
    (scalar : Complex) (coordinates : Fin 3 → Complex) :
    MvPolynomial.eval
        (fun coordinate => scalar * coordinates coordinate)
        (primitiveSpinCSolidHarmonicPacket degree multiplicity) =
      scalar ^ degree *
        MvPolynomial.eval coordinates
          (primitiveSpinCSolidHarmonicPacket degree multiplicity) := by
  unfold primitiveSpinCSolidHarmonicPacket
    primitiveSpinCSolidNullLinearForm
  rw [map_pow, map_pow]
  rw [← mul_pow]
  congr 1
  simp [Fin.sum_univ_succ]
  ring

/-- Normalize one nonzero Euclidean vector to the monopole sphere. -/
def primitiveSpinCNullPacketNormalize
    (vector : EuclideanSpace Real (Fin 3)) (hVector : vector ≠ 0) :
    MonopoleSphere :=
  ⟨‖vector‖⁻¹ • vector, by
    rw [mem_sphere_zero_iff_norm]
    simp [norm_smul, hVector]⟩

@[simp]
theorem primitiveSpinCNullPacketNormalize_coordinate
    (vector : EuclideanSpace Real (Fin 3)) (hVector : vector ≠ 0)
    (coordinate : Fin 3) :
    monopoleSphereCoordinate
        (primitiveSpinCNullPacketNormalize vector hVector) coordinate =
      ‖vector‖⁻¹ * vector coordinate := by
  rfl

/-- An infinite positive real subset of the complex coefficient field. -/
def primitiveSpinCPositiveNaturalComplexSet : Set Complex :=
  Set.range (fun index : Nat => ((index + 1 : Nat) : Complex))

theorem primitiveSpinCPositiveNaturalComplexSet_infinite :
    primitiveSpinCPositiveNaturalComplexSet.Infinite := by
  apply Set.infinite_range_of_injective
  intro first second hEqual
  change ((first + 1 : Nat) : Complex) =
    ((second + 1 : Nat) : Complex) at hEqual
  have hNat : first + 1 = second + 1 := by
    exact Nat.cast_injective hEqual
  omega

/-- A scalar null-packet relation on the positive north-chart locus
already forces every algebraic packet coefficient to vanish. -/
theorem primitiveSpinCNullHarmonicSmoothPacket_coefficients_eq_zero_of_scalar_relation
    (degree : Nat)
    (coefficients : Fin (2 * degree + 1) → Complex)
    (hRelation : ∀ point : MonopoleSphere,
      point ∈ monopoleChartDomain .north →
      0 < monopoleSphereCoordinate point 0 →
      ∑ basis : Fin (2 * degree + 1),
          coefficients basis *
            primitiveSpinCNullSphereScalar
              (primitiveSpinCSolidPacketParameter degree basis)
              point ^ degree = 0) :
    ∀ multiplicity, coefficients multiplicity = 0 := by
  classical
  have hPolynomial :
      ∑ basis : Fin (2 * degree + 1),
          coefficients basis •
            primitiveSpinCSolidHarmonicPacket degree basis = 0 := by
    apply MvPolynomial.funext_set
      (fun _ : Fin 3 => primitiveSpinCPositiveNaturalComplexSet)
      (fun _ => primitiveSpinCPositiveNaturalComplexSet_infinite)
    intro coordinates hCoordinates
    have hReal (coordinate : Fin 3) :
        ((coordinates coordinate).re : Complex) =
          coordinates coordinate := by
      rcases hCoordinates coordinate (Set.mem_univ coordinate) with
        ⟨index, hIndex⟩
      rw [← hIndex]
      norm_num
    have hPositive (coordinate : Fin 3) :
        0 < (coordinates coordinate).re := by
      rcases hCoordinates coordinate (Set.mem_univ coordinate) with
        ⟨index, hIndex⟩
      rw [← hIndex]
      change (0 : Real) < (index + 1 : Nat)
      exact_mod_cast Nat.zero_lt_succ index
    let vector : EuclideanSpace Real (Fin 3) :=
      WithLp.toLp 2 (fun coordinate => (coordinates coordinate).re)
    have hVector : vector ≠ 0 := by
      intro hZero
      have hAt := congrArg
        (fun current : EuclideanSpace Real (Fin 3) => current 0)
        hZero
      have hCoordinateZero : (coordinates 0).re = 0 := by
        simpa [vector] using hAt
      exact (ne_of_gt (hPositive 0)) hCoordinateZero
    have hNormPositive : 0 < ‖vector‖ :=
      norm_pos_iff.mpr hVector
    let point : MonopoleSphere :=
      primitiveSpinCNullPacketNormalize vector hVector
    have hPointPositive (coordinate : Fin 3) :
        0 < monopoleSphereCoordinate point coordinate := by
      rw [show point =
          primitiveSpinCNullPacketNormalize vector hVector by rfl,
        primitiveSpinCNullPacketNormalize_coordinate]
      exact mul_pos (inv_pos.mpr hNormPositive) (hPositive coordinate)
    have hNorth : point ∈ monopoleChartDomain .north := by
      change monopoleSphereCoordinate point 2 ≠ -1
      nlinarith [hPointPositive 2]
    have hSphere := hRelation point hNorth (hPointPositive 0)
    let sphereCoordinates : Fin 3 → Complex :=
      fun coordinate =>
        (monopoleSphereCoordinate point coordinate : Complex)
    have hSphereEval :
        ∑ basis : Fin (2 * degree + 1),
            coefficients basis *
              MvPolynomial.eval sphereCoordinates
                (primitiveSpinCSolidHarmonicPacket degree basis) = 0 := by
      simpa only [sphereCoordinates,
        primitiveSpinCSolidHarmonicPacket_eval_sphere] using hSphere
    let scale : Complex := (‖vector‖⁻¹ : Real)
    have hSphereCoordinates :
        sphereCoordinates =
          fun coordinate => scale * coordinates coordinate := by
      funext coordinate
      change
        ((monopoleSphereCoordinate point coordinate : Real) : Complex) =
          scale * coordinates coordinate
      rw [show point =
          primitiveSpinCNullPacketNormalize vector hVector by rfl,
        primitiveSpinCNullPacketNormalize_coordinate]
      change
        ((‖vector‖⁻¹ * (coordinates coordinate).re : Real) : Complex) =
          scale * coordinates coordinate
      push_cast
      rw [hReal coordinate]
      simp [scale]
    have hScale : scale ≠ 0 := by
      change ((‖vector‖⁻¹ : Real) : Complex) ≠ 0
      exact Complex.ofReal_ne_zero.mpr
        (inv_ne_zero hNormPositive.ne')
    have hScaled :
        scale ^ degree *
            (∑ basis : Fin (2 * degree + 1),
              coefficients basis *
                MvPolynomial.eval coordinates
                  (primitiveSpinCSolidHarmonicPacket degree basis)) = 0 := by
      calc
        scale ^ degree *
            (∑ basis : Fin (2 * degree + 1),
              coefficients basis *
                MvPolynomial.eval coordinates
                  (primitiveSpinCSolidHarmonicPacket degree basis)) =
          ∑ basis : Fin (2 * degree + 1),
            coefficients basis *
              MvPolynomial.eval sphereCoordinates
                (primitiveSpinCSolidHarmonicPacket degree basis) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro basis _
            rw [hSphereCoordinates,
              primitiveSpinCSolidHarmonicPacket_eval_smul]
            ring
        _ = 0 := hSphereEval
    have hEval :
        ∑ basis : Fin (2 * degree + 1),
            coefficients basis *
              MvPolynomial.eval coordinates
                (primitiveSpinCSolidHarmonicPacket degree basis) = 0 :=
      (mul_eq_zero.mp hScaled).resolve_left (pow_ne_zero degree hScale)
    simpa [MvPolynomial.smul_eq_C_mul] using hEval
  intro multiplicity
  exact
    (Fintype.linearIndependent_iff.mp
      (primitiveSpinCSolidHarmonicPacket_linearIndependent degree)
      coefficients hPolynomial multiplicity)

/-- At every degree, every normal-root sector and every circle mode, the
`2p+1` genuine smooth null-power eigensections are complex-linearly
independent. -/
theorem primitiveSpinCNullHarmonicSmoothPacket_linearIndependent
    (degree : Nat) (sector : NormalRootChoice) (circleMode : Int) :
    LinearIndependent Complex
      (fun multiplicity : Fin (2 * degree + 1) =>
        primitiveSpinCNullHarmonicSmoothPacket
          period hPeriod degree multiplicity sector circleMode) := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro coefficients hSum multiplicity
  exact
    primitiveSpinCNullHarmonicSmoothPacket_coefficients_eq_zero_of_scalar_relation
      degree coefficients
      (fun point hNorth hCoordinate =>
        primitiveSpinCNullHarmonicSmoothPacket_scalar_relation
          period hPeriod degree coefficients sector circleMode hSum
          point hNorth hCoordinate)
      multiplicity

/-- The same independence statement in the repository's physical
`2p+1` multiplicity indexing. -/
theorem primitiveSpinCAllLevelNullHarmonicSquaredSeed_linearIndependent
    (positiveLevel : Nat)
    (sector : NormalRootChoice) (circleMode : Int) :
    LinearIndependent Complex
      (fun multiplicity :
          Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)) =>
        (primitiveSpinCAllLevelNullHarmonicSquaredSeed
          period hPeriod positiveLevel multiplicity sector circleMode
        ).scalarSection) := by
  let reindex :
      Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)) →
        Fin (2 * (positiveLevel + 1) + 1) :=
    Fin.cast
      (primitiveSpinCSolidPacket_degeneracy_eq (positiveLevel + 1))
  have hIndependent :=
    (primitiveSpinCNullHarmonicSmoothPacket_linearIndependent
      period hPeriod (positiveLevel + 1) sector circleMode).comp
      reindex (Fin.cast_injective _)
  change LinearIndependent Complex
    (fun multiplicity =>
      primitiveSpinCNullPowerSection
        period hPeriod
        (primitiveSpinCSolidPacketParameter (positiveLevel + 1)
          (reindex multiplicity))
        sector circleMode (positiveLevel + 1))
  simpa only [Function.comp_def,
    primitiveSpinCNullHarmonicSmoothPacket] using hIndependent

/-- Finite complex synthesis of the exact physical packet at one arbitrary
positive level. -/
def primitiveSpinCAllLevelNullHarmonicPacketSynthesis
    (positiveLevel : Nat)
    (sector : NormalRootChoice) (circleMode : Int) :
    (Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)) → Complex) →ₗ[Complex]
      SmoothSection period hPeriod where
  toFun coefficients :=
    ∑ multiplicity,
      coefficients multiplicity •
        (primitiveSpinCAllLevelNullHarmonicSquaredSeed
          period hPeriod positiveLevel multiplicity sector circleMode
        ).scalarSection
  map_add' first second := by
    simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib]
  map_smul' scalar coefficients := by
    change
      (∑ multiplicity,
          (scalar * coefficients multiplicity) •
            (primitiveSpinCAllLevelNullHarmonicSquaredSeed
              period hPeriod positiveLevel multiplicity sector circleMode
            ).scalarSection) =
        scalar •
          ∑ multiplicity,
            coefficients multiplicity •
              (primitiveSpinCAllLevelNullHarmonicSquaredSeed
                period hPeriod positiveLevel multiplicity sector circleMode
              ).scalarSection
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro multiplicity _
    rw [mul_smul]

/-- The uniform finite packet gives faithful complex Fourier coordinates at
every positive level. -/
theorem primitiveSpinCAllLevelNullHarmonicPacketSynthesis_injective
    (positiveLevel : Nat)
    (sector : NormalRootChoice) (circleMode : Int) :
    Function.Injective
      (primitiveSpinCAllLevelNullHarmonicPacketSynthesis
        period hPeriod positiveLevel sector circleMode) := by
  intro first second hEqual
  have hKernel :
      primitiveSpinCAllLevelNullHarmonicPacketSynthesis
          period hPeriod positiveLevel sector circleMode (first - second) = 0 := by
    rw [map_sub, hEqual, sub_self]
  have hRelation :
      ∑ multiplicity,
          (first - second) multiplicity •
            (primitiveSpinCAllLevelNullHarmonicSquaredSeed
              period hPeriod positiveLevel multiplicity sector circleMode
            ).scalarSection = 0 := by
    exact hKernel
  have hCoefficient :=
    Fintype.linearIndependent_iff.mp
      (primitiveSpinCAllLevelNullHarmonicSquaredSeed_linearIndependent
        period hPeriod positiveLevel sector circleMode)
      (first - second) hRelation
  funext multiplicity
  exact sub_eq_zero.mp (hCoefficient multiplicity)

/-- Finite synthesis intertwines the genuine squared geometric Dirac
operator with the exact scalar eigenvalue at every positive level. -/
theorem primitiveSpinCAllLevelNullHarmonicPacketSynthesis_dirac_sq
    (positiveLevel : Nat)
    (sector : NormalRootChoice) (circleMode : Int)
    (coefficients :
      Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)) → Complex) :
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter
        (d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (primitiveSpinCAllLevelNullHarmonicPacketSynthesis
            period hPeriod positiveLevel sector circleMode coefficients)) =
      (normalRootLeviCivitaCorrectedFrequency
            period sector circleMode ^ 2 +
          primitiveSpinCHarmonicSphereEnergy positiveLevel) •
        primitiveSpinCAllLevelNullHarmonicPacketSynthesis
          period hPeriod positiveLevel sector circleMode coefficients := by
  change
    primitiveSpinCGeometricDiracComplexLinearMap period hPeriod
        (primitiveSpinCGeometricDiracComplexLinearMap period hPeriod
          (∑ multiplicity,
            coefficients multiplicity •
              (primitiveSpinCAllLevelNullHarmonicSquaredSeed
                period hPeriod positiveLevel multiplicity sector circleMode
              ).scalarSection)) =
      _ •
        ∑ multiplicity,
          coefficients multiplicity •
            (primitiveSpinCAllLevelNullHarmonicSquaredSeed
              period hPeriod positiveLevel multiplicity sector circleMode
            ).scalarSection
  rw [map_sum]
  simp_rw [map_smul]
  rw [map_sum]
  simp_rw [map_smul]
  rw [Finset.smul_sum]
  apply Finset.sum_congr rfl
  intro multiplicity _
  change
    coefficients multiplicity •
        d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (d9PrimitiveSpinCGeometricDiracOperator
            period hPeriod .positiveQuarter
            (primitiveSpinCAllLevelNullHarmonicSquaredSeed
              period hPeriod positiveLevel multiplicity sector circleMode
            ).scalarSection) =
      _ •
        (coefficients multiplicity •
          (primitiveSpinCAllLevelNullHarmonicSquaredSeed
            period hPeriod positiveLevel multiplicity sector circleMode
          ).scalarSection)
  rw [(primitiveSpinCAllLevelNullHarmonicSquaredSeed
    period hPeriod positiveLevel multiplicity sector circleMode
    ).dirac_sq_scalar]
  exact d9PrimitiveSpinCComplexScalarSection_real_smul
    period hPeriod (coefficients multiplicity)
    (normalRootLeviCivitaCorrectedFrequency
        period sector circleMode ^ 2 +
      primitiveSpinCHarmonicSphereEnergy positiveLevel)
    (primitiveSpinCAllLevelNullHarmonicSquaredSeed
      period hPeriod positiveLevel multiplicity sector circleMode
    ).scalarSection

/-! ## Faithful finite synthesis across all positive sphere levels -/

/-- One dependent label for every positive sphere level and its full
`2p+1` multiplicity packet. -/
abbrev PrimitiveSpinCAllPositiveNullHarmonicIndex :=
  Σ positiveLevel : Nat,
    Fin (primitiveSphereModeDegeneracy (positiveLevel + 1))

/-- The genuine smooth null-harmonic family across all positive levels at
one fixed normal-root sector and circle mode. -/
def primitiveSpinCAllPositiveNullHarmonicFamily
    (sector : NormalRootChoice) (circleMode : Int)
    (index : PrimitiveSpinCAllPositiveNullHarmonicIndex) :
    SmoothSection period hPeriod :=
  (primitiveSpinCAllLevelNullHarmonicSquaredSeed
    period hPeriod index.1 index.2 sector circleMode).scalarSection

/-- Squared-Dirac eigenvalue of one positive sphere level, viewed in the
intrinsic complex scalar field. -/
def primitiveSpinCAllPositiveNullHarmonicSquaredEigenvalue
    (positiveLevel : Nat)
    (sector : NormalRootChoice) (circleMode : Int) : Complex :=
  ((normalRootLeviCivitaCorrectedFrequency
        period sector circleMode ^ 2 +
      primitiveSpinCHarmonicSphereEnergy positiveLevel : Real) : Complex)

/-- At fixed sector and circle mode, distinct positive levels have
distinct squared-Dirac eigenvalues. -/
theorem primitiveSpinCAllPositiveNullHarmonicSquaredEigenvalue_injective
    (sector : NormalRootChoice) (circleMode : Int) :
    Function.Injective
      (fun positiveLevel =>
        primitiveSpinCAllPositiveNullHarmonicSquaredEigenvalue
          period positiveLevel sector circleMode) := by
  intro first second hEqual
  apply primitiveSpinCHarmonicSphereEnergy_strictMono.injective
  apply add_left_cancel
  exact Complex.ofReal_injective hEqual

/-- Every member of the all-positive-level family belongs to its exact
complex eigenspace for the genuine squared geometric Dirac operator. -/
theorem primitiveSpinCAllPositiveNullHarmonicFamily_mem_eigenspace
    (positiveLevel : Nat)
    (multiplicity :
      Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)))
    (sector : NormalRootChoice) (circleMode : Int) :
    primitiveSpinCAllPositiveNullHarmonicFamily
        period hPeriod sector circleMode ⟨positiveLevel, multiplicity⟩ ∈
      Module.End.eigenspace
        (primitiveSpinCGeometricDiracSquaredComplexLinearMap
          period hPeriod)
        (primitiveSpinCAllPositiveNullHarmonicSquaredEigenvalue
          period positiveLevel sector circleMode) := by
  rw [Module.End.mem_eigenspace_iff]
  change
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter
        (d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (primitiveSpinCAllLevelNullHarmonicSquaredSeed
            period hPeriod positiveLevel multiplicity sector circleMode
          ).scalarSection) =
      d9PrimitiveSpinCComplexScalarSection
        period hPeriod .positiveQuarter
        ((normalRootLeviCivitaCorrectedFrequency
              period sector circleMode ^ 2 +
            primitiveSpinCHarmonicSphereEnergy positiveLevel : Real) :
          Complex)
        (primitiveSpinCAllLevelNullHarmonicSquaredSeed
          period hPeriod positiveLevel multiplicity sector circleMode
        ).scalarSection
  rw [(primitiveSpinCAllLevelNullHarmonicSquaredSeed
      period hPeriod positiveLevel multiplicity sector circleMode
    ).dirac_sq_scalar,
    d9PrimitiveSpinCComplexScalarSection_ofReal]

/-- All positive sphere packets are jointly complex-linearly independent
at a fixed sector and circle mode.  Separation between levels follows from
the distinct eigenspaces of the genuine squared Dirac operator. -/
theorem primitiveSpinCAllPositiveNullHarmonicFamily_linearIndependent
    (sector : NormalRootChoice) (circleMode : Int) :
    LinearIndependent Complex
      (primitiveSpinCAllPositiveNullHarmonicFamily
        period hPeriod sector circleMode) := by
  classical
  let packet :
      (positiveLevel : Nat) →
        Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)) →
          SmoothSection period hPeriod :=
    fun positiveLevel multiplicity =>
      (primitiveSpinCAllLevelNullHarmonicSquaredSeed
        period hPeriod positiveLevel multiplicity sector circleMode
      ).scalarSection
  have hEigenspaces :
      iSupIndep
        (fun positiveLevel =>
          Module.End.eigenspace
            (primitiveSpinCGeometricDiracSquaredComplexLinearMap
              period hPeriod)
              (primitiveSpinCAllPositiveNullHarmonicSquaredEigenvalue
                period positiveLevel sector circleMode)) :=
    (Module.End.eigenspaces_iSupIndep
      (primitiveSpinCGeometricDiracSquaredComplexLinearMap
        period hPeriod)).comp
      (primitiveSpinCAllPositiveNullHarmonicSquaredEigenvalue_injective
        period sector circleMode)
  have hCombined :
      LinearIndependent Complex
        (fun index :
            Σ positiveLevel : Nat,
              Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)) =>
          packet index.1 index.2) := by
    apply linearIndependent_iUnion_finite
    · intro positiveLevel
      exact primitiveSpinCAllLevelNullHarmonicSquaredSeed_linearIndependent
        period hPeriod positiveLevel sector circleMode
    · intro positiveLevel levels _ hNotMem
      apply (hEigenspaces.disjoint_biSup hNotMem).mono
      · rw [Submodule.span_le]
        rintro state ⟨multiplicity, rfl⟩
        exact
          primitiveSpinCAllPositiveNullHarmonicFamily_mem_eigenspace
            period hPeriod positiveLevel multiplicity sector circleMode
      · refine iSup₂_le fun level hLevel => ?_
        rw [Submodule.span_le]
        rintro state ⟨multiplicity, rfl⟩
        apply Submodule.mem_iSup_of_mem level
        apply Submodule.mem_iSup_of_mem hLevel
        exact
          primitiveSpinCAllPositiveNullHarmonicFamily_mem_eigenspace
            period hPeriod level multiplicity sector circleMode
  change
    LinearIndependent Complex
      (fun index :
          Σ positiveLevel : Nat,
            Fin (primitiveSphereModeDegeneracy (positiveLevel + 1)) =>
        (primitiveSpinCAllLevelNullHarmonicSquaredSeed
          period hPeriod index.1 index.2 sector circleMode).scalarSection)
  simpa only [packet] using hCombined

/-- Finite-support synthesis of genuine smooth modes across every positive
sphere level at one fixed sector and circle mode. -/
def primitiveSpinCAllPositiveNullHarmonicSynthesis
    (sector : NormalRootChoice) (circleMode : Int) :
    (PrimitiveSpinCAllPositiveNullHarmonicIndex →₀ Complex) →ₗ[Complex]
      SmoothSection period hPeriod :=
  Finsupp.linearCombination Complex
    (primitiveSpinCAllPositiveNullHarmonicFamily
      period hPeriod sector circleMode)

@[simp]
theorem primitiveSpinCAllPositiveNullHarmonicSynthesis_apply
    (sector : NormalRootChoice) (circleMode : Int)
    (coefficients :
      PrimitiveSpinCAllPositiveNullHarmonicIndex →₀ Complex) :
    primitiveSpinCAllPositiveNullHarmonicSynthesis
        period hPeriod sector circleMode coefficients =
      coefficients.sum fun index coefficient =>
        coefficient •
          primitiveSpinCAllPositiveNullHarmonicFamily
            period hPeriod sector circleMode index :=
  rfl

/-- Finite coefficients over all positive levels have faithful intrinsic
smooth realization. -/
theorem primitiveSpinCAllPositiveNullHarmonicSynthesis_injective
    (sector : NormalRootChoice) (circleMode : Int) :
    Function.Injective
      (primitiveSpinCAllPositiveNullHarmonicSynthesis
        period hPeriod sector circleMode) :=
  (primitiveSpinCAllPositiveNullHarmonicFamily_linearIndependent
    period hPeriod sector circleMode).finsuppLinearCombination_injective

@[simp]
theorem primitiveSpinCAllPositiveNullHarmonicSynthesis_single
    (sector : NormalRootChoice) (circleMode : Int)
    (index : PrimitiveSpinCAllPositiveNullHarmonicIndex)
    (coefficient : Complex) :
    primitiveSpinCAllPositiveNullHarmonicSynthesis
        period hPeriod sector circleMode
        (Finsupp.single index coefficient) =
      coefficient •
        primitiveSpinCAllPositiveNullHarmonicFamily
          period hPeriod sector circleMode index := by
  simp [primitiveSpinCAllPositiveNullHarmonicSynthesis]

/-- One diagonal squared-Dirac block on the finite all-positive-level
coefficient space. -/
def primitiveSpinCAllPositiveNullHarmonicSquaredCoefficientBlock
    (sector : NormalRootChoice) (circleMode : Int)
    (index : PrimitiveSpinCAllPositiveNullHarmonicIndex) :
    Complex →ₗ[Complex]
      (PrimitiveSpinCAllPositiveNullHarmonicIndex →₀ Complex) :=
  (Finsupp.lsingle index).comp
    (primitiveSpinCAllPositiveNullHarmonicSquaredEigenvalue
        period index.1 sector circleMode •
      (LinearMap.id : Complex →ₗ[Complex] Complex))

/-- Exact diagonal coefficient operator for squared Dirac across all
positive sphere levels. -/
def primitiveSpinCAllPositiveNullHarmonicSquaredCoefficientOperator
    (sector : NormalRootChoice) (circleMode : Int) :
    (PrimitiveSpinCAllPositiveNullHarmonicIndex →₀ Complex) →ₗ[Complex]
      (PrimitiveSpinCAllPositiveNullHarmonicIndex →₀ Complex) :=
  Finsupp.lsum Complex fun index =>
    primitiveSpinCAllPositiveNullHarmonicSquaredCoefficientBlock
      period sector circleMode index

@[simp]
theorem
