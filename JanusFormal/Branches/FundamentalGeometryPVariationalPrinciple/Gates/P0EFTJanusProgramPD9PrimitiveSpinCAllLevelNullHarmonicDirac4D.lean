/-- Intrinsic imaginary companion of every all-level smooth mode. -/
def primitiveSpinCAllModeNullHarmonicImaginarySection
    (mode : PrimitiveSpinCGeometricFullMode) :
    SmoothSection period hPeriod :=
  Complex.I •
    primitiveSpinCAllModeNullHarmonicRealSection period hPeriod mode

/-- Every coefficient label is now represented by a genuine smooth
eigensection of the squared geometric Dirac operator. -/
theorem primitiveSpinCAllModeNullHarmonicRealSection_dirac_sq
    (mode : PrimitiveSpinCGeometricFullMode) :
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter
        (d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (primitiveSpinCAllModeNullHarmonicRealSection
            period hPeriod mode)) =
      primitiveSpinCGeometricSquaredEigenvalue period hPeriod mode •
        primitiveSpinCAllModeNullHarmonicRealSection
          period hPeriod mode := by
  rcases mode with ⟨sector, ⟨⟨level, multiplicity⟩, circleMode⟩⟩
  cases level with
  | zero =>
      fin_cases multiplicity
      simp only [primitiveSpinCAllModeNullHarmonicRealSection]
      rw [primitiveSpinCHopfZeroModeGeometricDiracOperator_eigen,
        d9PrimitiveSpinCGeometricDiracOperator_real_smul,
        primitiveSpinCHopfZeroModeGeometricDiracOperator_eigen]
      simp only [primitiveSpinCGeometricSquaredEigenvalue,
        primitiveSpinCFullSphereEigenvalueSquared, Nat.cast_zero,
        zero_mul, zero_add]
      rw [← normalRootLeviCivitaCorrectedFrequency_sq_eq_circle]
      module
  | succ positiveLevel =>
      simp only [primitiveSpinCAllModeNullHarmonicRealSection]
      rw [(primitiveSpinCAllLevelNullHarmonicSquaredSeed
        period hPeriod positiveLevel multiplicity sector circleMode
        ).dirac_sq_scalar]
      change
        _ =
          primitiveSpinCGeometricSquaredEigenvalue period hPeriod
              (primitiveSpinCHarmonicGeometricMode
                positiveLevel multiplicity sector circleMode) •
            (primitiveSpinCAllLevelNullHarmonicSquaredSeed
              period hPeriod positiveLevel multiplicity sector circleMode
            ).scalarSection
      rw [
        ← primitiveSpinCHarmonicDiracFrequency_sq_eq_geometricSpectrum
          period hPeriod positiveLevel multiplicity sector circleMode,
        primitiveSpinCHarmonicDiracFrequency_sq]

/-- The intrinsic imaginary companions obey the same exact squared
eigen-equation. -/
theorem primitiveSpinCAllModeNullHarmonicImaginarySection_dirac_sq
    (mode : PrimitiveSpinCGeometricFullMode) :
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter
        (d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (primitiveSpinCAllModeNullHarmonicImaginarySection
            period hPeriod mode)) =
      primitiveSpinCGeometricSquaredEigenvalue period hPeriod mode •
        primitiveSpinCAllModeNullHarmonicImaginarySection
          period hPeriod mode := by
  change
    primitiveSpinCGeometricDiracComplexLinearMap period hPeriod
        (primitiveSpinCGeometricDiracComplexLinearMap period hPeriod
          (Complex.I •
            primitiveSpinCAllModeNullHarmonicRealSection
              period hPeriod mode)) =
      _ •
        (Complex.I •
          primitiveSpinCAllModeNullHarmonicRealSection
            period hPeriod mode)
  rw [map_smul, map_smul]
  change
    Complex.I •
        d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter
          (d9PrimitiveSpinCGeometricDiracOperator
            period hPeriod .positiveQuarter
            (primitiveSpinCAllModeNullHarmonicRealSection
              period hPeriod mode)) =
      _ •
        (Complex.I •
          primitiveSpinCAllModeNullHarmonicRealSection
            period hPeriod mode)
  rw [primitiveSpinCAllModeNullHarmonicRealSection_dirac_sq]
  exact d9PrimitiveSpinCComplexScalarSection_real_smul
    period hPeriod Complex.I
    (primitiveSpinCGeometricSquaredEigenvalue period hPeriod mode)
    (primitiveSpinCAllModeNullHarmonicRealSection period hPeriod mode)

