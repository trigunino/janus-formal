variable (hWeights : candidateAPlusEinsteinKineticWeight couplings + candidateAMinusEinsteinKineticWeight couplings = 0)

theorem candidateAReducedBRSTSmooth_mem
    (pair : GlobalCandidateADiagonalDiffeomorphismBRSTState period hPeriod × GlobalPairedAbelianBRSTState period hPeriod) :
    candidateAReducedBRSTSmooth period hPeriod configuration data pair ∈
      (candidateAReducedBRSTOperator period hPeriod configuration data analysis realization
        plusBase minusBase hBase hCenter physical hMetric hWeights).domain :=
  (candidateAReducedBRSTOperator_project_domain_iff period hPeriod configuration data analysis realization
    plusBase minusBase hBase hCenter physical hMetric hWeights _).mpr
      (candidateACoupledBRSTSmooth_mem period hPeriod configuration data analysis realization
        plusBase minusBase hBase hCenter physical pair)

