theorem candidateABRSTQuotientMap_zero_iff
    (x : CandidateACoupledBRSTHilbert period hPeriod configuration data) :
    candidateABRSTQuotientMap period hPeriod configuration data x = 0 ↔
    x.fst ∈ diffeomorphismGhostNullSpace period hPeriod configuration data ∧ x.snd = 0 := by
  constructor
  · intro h
    exact ⟨(Submodule.Quotient.mk_eq_zero _).mp (congrArg WithLp.fst h), congrArg WithLp.snd h⟩
  · rintro ⟨hd, ha⟩
    apply WithLp.ofLp_injective 2
    exact Prod.ext ((Submodule.Quotient.mk_eq_zero _).mpr hd) ha

/-- The actual smooth fields mapped to the closed shared-ghost quotient. -/
def candidateAReducedBRSTSmooth :
    (GlobalCandidateADiagonalDiffeomorphismBRSTState period hPeriod × GlobalPairedAbelianBRSTState period hPeriod) →ₗ[Real]
      CandidateAReducedBRSTHilbert period hPeriod configuration data :=
  (candidateABRSTQuotientMap period hPeriod configuration data).toLinearMap.comp
    (candidateACoupledBRSTSmooth period hPeriod configuration data)

theorem candidateAReducedBRSTSmooth_denseRange :
    DenseRange (candidateAReducedBRSTSmooth period hPeriod configuration data) :=
  (candidateABRSTQuotientMap_surjective period hPeriod configuration data).denseRange.comp
    (candidateACoupledBRSTSmooth_denseRange period hPeriod configuration data)
    (candidateABRSTQuotientMap period hPeriod configuration data).continuous

/-- The shared ghost generators are sent to zero. -/
theorem candidateAReducedBRSTSmooth_ghost_zero (pair : SharedGhostPair period hPeriod) :
    candidateAReducedBRSTSmooth period hPeriod configuration data
      (diagonalGhostPairState period hPeriod pair, 0) = 0 := by
  change candidateABRSTQuotientMap period hPeriod configuration data
    (WithLp.toLp 2 (diffeomorphismGhostEmbedding period hPeriod configuration data pair,
      candidateAAbelianMixedSmooth period hPeriod data 0)) = 0
  rw [candidateABRSTQuotientMap_zero_iff]
  exact ⟨Submodule.le_topologicalClosure _ ⟨pair, rfl⟩,
    (candidateAAbelianMixedSmoothLinearMap period hPeriod data).map_zero⟩

