import Mathlib.Analysis.Normed.Algebra.Exponential
import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPSelfAdjointKernelComplementReduction4D

/-!
# Exact exponential on the actual kernel complement

For a bounded self-adjoint operator `H`, the canonical reduced operator on
`(ker H)ᗮ` is bounded and self-adjoint.  Its Banach-algebra exponential

`U(t) = exp (-t H_red)`

therefore exists for all real times.  This construction uses the genuine
kernel complement directly and does not require a supplied defect projector or
a coercive finite-rank shift.

The exponential forms an exact one-parameter group, is invertible with inverse
`U(-t)`, is self-adjoint for real time and commutes with `H_red`.  No compactness,
nuclearity or heat-trace claim is made.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPSelfAdjointKernelComplementExponential4D

set_option autoImplicit false
set_option maxHeartbeats 3000000
set_option synthInstance.maxHeartbeats 1500000

noncomputable section

open scoped InnerProductSpace
open P0EFTJanusProgramPSelfAdjointKernelComplementReduction4D

variable {E : Type*}
  [NormedAddCommGroup E] [NormedSpace Real E]
  [InnerProductSpace Real E] [CompleteSpace E]

local instance actualKernelExponentialCompleteSpace
    (operator : E →L[Real] E) :
    CompleteSpace (SelfAdjointKernelComplement operator) :=
  inferInstance

/-- Exact bounded evolution generated by the actual reduced operator. -/
noncomputable def selfAdjointKernelComplementExponential
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator)
    (time : Real) :
    SelfAdjointKernelComplement operator →L[Real]
      SelfAdjointKernelComplement operator :=
  NormedSpace.exp
    ((-time) • selfAdjointKernelComplementOperator operator hSelfAdjoint)

@[simp]
theorem selfAdjointKernelComplementExponential_zero
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator) :
    selfAdjointKernelComplementExponential operator hSelfAdjoint 0 =
      (1 : SelfAdjointKernelComplement operator →L[Real]
        SelfAdjointKernelComplement operator) := by
  simp [selfAdjointKernelComplementExponential]

private theorem reducedGenerator_commute
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator)
    (firstTime secondTime : Real) :
    Commute
      ((-firstTime) • selfAdjointKernelComplementOperator operator hSelfAdjoint)
      ((-secondTime) •
        selfAdjointKernelComplementOperator operator hSelfAdjoint) := by
  exact ((Commute.refl
    (selfAdjointKernelComplementOperator operator hSelfAdjoint)).smul_left
      (-firstTime)).smul_right (-secondTime)

/-- Exact one-parameter group law. -/
theorem selfAdjointKernelComplementExponential_add
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator)
    (firstTime secondTime : Real) :
    selfAdjointKernelComplementExponential operator hSelfAdjoint
        (firstTime + secondTime) =
      selfAdjointKernelComplementExponential operator hSelfAdjoint firstTime *
        selfAdjointKernelComplementExponential operator hSelfAdjoint secondTime := by
  unfold selfAdjointKernelComplementExponential
  rw [show (-(firstTime + secondTime)) •
      selfAdjointKernelComplementOperator operator hSelfAdjoint =
        (-firstTime) • selfAdjointKernelComplementOperator operator hSelfAdjoint +
          (-secondTime) •
            selfAdjointKernelComplementOperator operator hSelfAdjoint by
    module]
  exact NormedSpace.exp_add_of_commute
    (reducedGenerator_commute operator hSelfAdjoint firstTime secondTime)

/-- Every actual-complement exponential is a unit. -/
theorem selfAdjointKernelComplementExponential_isUnit
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator)
    (time : Real) :
    IsUnit (selfAdjointKernelComplementExponential operator hSelfAdjoint time) :=
  NormedSpace.isUnit_exp _

/-- Positive and negative times are two-sided inverses. -/
theorem selfAdjointKernelComplementExponential_mul_neg
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator)
    (time : Real) :
    selfAdjointKernelComplementExponential operator hSelfAdjoint time *
        selfAdjointKernelComplementExponential operator hSelfAdjoint (-time) =
      (1 : SelfAdjointKernelComplement operator →L[Real]
        SelfAdjointKernelComplement operator) := by
  rw [← selfAdjointKernelComplementExponential_add]
  simp

/-- Reverse-order inverse identity. -/
theorem selfAdjointKernelComplementExponential_neg_mul
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator)
    (time : Real) :
    selfAdjointKernelComplementExponential operator hSelfAdjoint (-time) *
        selfAdjointKernelComplementExponential operator hSelfAdjoint time =
      (1 : SelfAdjointKernelComplement operator →L[Real]
        SelfAdjointKernelComplement operator) := by
  rw [← selfAdjointKernelComplementExponential_add]
  simp

/-- The actual reduced Hessian commutes with its exponential. -/
theorem selfAdjointKernelComplementOperator_commute_exponential
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator)
    (time : Real) :
    Commute
      (selfAdjointKernelComplementOperator operator hSelfAdjoint)
      (selfAdjointKernelComplementExponential operator hSelfAdjoint time) := by
  unfold selfAdjointKernelComplementExponential
  exact ((Commute.refl
    (selfAdjointKernelComplementOperator operator hSelfAdjoint)).smul_right
      (-time)).exp_right

/-- Real-time exponential of the reduced self-adjoint Hessian is self-adjoint. -/
theorem selfAdjointKernelComplementExponential_isSelfAdjoint
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator)
    (time : Real) :
    IsSelfAdjoint
      (selfAdjointKernelComplementExponential operator hSelfAdjoint time) := by
  have hReduced :
      IsSelfAdjoint
        (selfAdjointKernelComplementOperator operator hSelfAdjoint) :=
    selfAdjointKernelComplementOperator_isSelfAdjoint operator hSelfAdjoint
  have hGenerator :
      IsSelfAdjoint
        ((-time) • selfAdjointKernelComplementOperator operator hSelfAdjoint) := by
    apply LinearMap.IsSymmetric.isSelfAdjoint
    intro first second
    change inner Real
        ((-time) •
          selfAdjointKernelComplementOperator operator hSelfAdjoint first)
        second =
      inner Real first
        ((-time) •
          selfAdjointKernelComplementOperator operator hSelfAdjoint second)
    simpa using congrArg (fun value : Real => (-time) * value)
      (hReduced.isSymmetric first second)
  exact hGenerator.exp Real

/-- Structural certificate for the exact actual-complement exponential. -/
structure SelfAdjointKernelComplementExponentialCertificate
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator) : Prop where
  zero : selfAdjointKernelComplementExponential operator hSelfAdjoint 0 = 1
  add : ∀ firstTime secondTime,
    selfAdjointKernelComplementExponential operator hSelfAdjoint
        (firstTime + secondTime) =
      selfAdjointKernelComplementExponential operator hSelfAdjoint firstTime *
        selfAdjointKernelComplementExponential operator hSelfAdjoint secondTime
  isUnit : ∀ time,
    IsUnit (selfAdjointKernelComplementExponential operator hSelfAdjoint time)
  selfAdjoint : ∀ time,
    IsSelfAdjoint
      (selfAdjointKernelComplementExponential operator hSelfAdjoint time)
  commutes : ∀ time,
    Commute
      (selfAdjointKernelComplementOperator operator hSelfAdjoint)
      (selfAdjointKernelComplementExponential operator hSelfAdjoint time)

/-- Construct the structural exponential certificate. -/
def selfAdjointKernelComplementExponentialCertificate
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator) :
    SelfAdjointKernelComplementExponentialCertificate operator hSelfAdjoint where
  zero := selfAdjointKernelComplementExponential_zero operator hSelfAdjoint
  add := selfAdjointKernelComplementExponential_add operator hSelfAdjoint
  isUnit := selfAdjointKernelComplementExponential_isUnit operator hSelfAdjoint
  selfAdjoint :=
    selfAdjointKernelComplementExponential_isSelfAdjoint operator hSelfAdjoint
  commutes :=
    selfAdjointKernelComplementOperator_commute_exponential operator hSelfAdjoint

/-- Public actual-complement exponential checkpoint. -/
theorem self_adjoint_kernel_complement_exponential_gate
    (operator : E →L[Real] E)
    (hSelfAdjoint : IsSelfAdjoint operator) :
    SelfAdjointKernelComplementExponentialCertificate operator hSelfAdjoint :=
  selfAdjointKernelComplementExponentialCertificate operator hSelfAdjoint

end
end P0EFTJanusProgramPSelfAdjointKernelComplementExponential4D
end JanusFormal
