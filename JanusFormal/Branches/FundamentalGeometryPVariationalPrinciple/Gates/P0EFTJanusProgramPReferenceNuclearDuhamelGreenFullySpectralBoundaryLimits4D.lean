import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPReferenceNuclearCountertermRankOneVariation4D
import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPReferenceNuclearDuhamelGreenCollapsedBoundaryLimits4D

/-!
# Fully spectral Duhamel--Green boundary limits

The endpoint-limit packet still carried a counterterm derivative and its
identification with an intrinsic nuclear trace.  This file replaces both by a
`ReferenceNuclearCountertermRankOneVariationData`.

The counterterm variation operator, its intrinsic trace and the derivative of
the scalar counterterm contribution are therefore generated by one
termwise-differentiable rank-one series.  Together with the semigroup-collapsed
short/long spectral integrals and their endpoint limits, this yields the whole
Duhamel--Green boundary packet without any scalar counterterm comparison.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPReferenceNuclearDuhamelGreenFullySpectralBoundaryLimits4D

set_option autoImplicit false
noncomputable section

open Filter Set
open P0EFTJanusProgramPIntrinsicNuclearTrace4D
open P0EFTJanusProgramPNuclearHeatDuhamelTraceVariation4D
open P0EFTJanusProgramPNuclearDuhamelCollapsedRankOneIntegral4D
open P0EFTJanusProgramPReferenceNuclearCountertermRankOneVariation4D
open P0EFTJanusProgramPReferenceNuclearDuhamelBoundaryLimits4D
open P0EFTJanusProgramPReferenceNuclearDuhamelGreenCollapsedBoundaryLimits4D

variable {Slice ShortCutoff LongCutoff E : Type*}
  [MeasurableSpace Slice]
  [NormedAddCommGroup E] [NormedSpace Real E]
  [InnerProductSpace Real E] [CompleteSpace E]

/-- Complete Duhamel boundary data whose counterterm variation is generated by
a differentiable nuclear rank-one series. -/
structure ReferenceNuclearDuhamelGreenFullySpectralBoundaryLimitsData
    (sliceMeasure : Measure Slice) [IsProbabilityMeasure sliceMeasure]
    (shortCutoffFilter : Filter ShortCutoff) [NeBot shortCutoffFilter]
    (longCutoffFilter : Filter LongCutoff) [NeBot longCutoffFilter]
    (nuclear : NuclearHeatDuhamelTraceVariationData (E := E))
    (countertermContribution : Real → Real)
    (shortTimeRegion longTimeRegion : Set Real) where
  countertermVariation :
    ReferenceNuclearCountertermRankOneVariationData
      (E := E) countertermContribution
  shortTime : NuclearDuhamelCollapsedRankOneIntegralData sliceMeasure nuclear
    shortTimeRegion
  longTime : NuclearDuhamelCollapsedRankOneIntegralData sliceMeasure nuclear
    longTimeRegion
  countertermMinusShortTraceClass : ∀ parameter,
    IntrinsicNuclearTraceData
      (countertermVariation.derivativeOperator parameter -
        shortTime.integratedOperator parameter)
  totalTraceClass : ∀ parameter,
    IntrinsicNuclearTraceData
      ((countertermVariation.derivativeOperator parameter -
          shortTime.integratedOperator parameter) -
        longTime.integratedOperator parameter)
  logarithmicDerivativeOperator : Real → E →L[Real] E
  logarithmicDerivativeTraceClass : ∀ parameter,
    IntrinsicNuclearTraceData (logarithmicDerivativeOperator parameter)
  matchingOperator : Real → E →L[Real] E
  shortBoundaryLimit : ∀ parameter,
    ReferenceNuclearDuhamelShortTimeBoundaryLimitData shortCutoffFilter
      (countertermVariation.derivativeOperator parameter)
      (shortTime.integratedOperator parameter)
      (logarithmicDerivativeOperator parameter)
      (matchingOperator parameter)
  longBoundaryLimit : ∀ parameter,
    ReferenceNuclearDuhamelLongTimeBoundaryLimitData longCutoffFilter
      (longTime.integratedOperator parameter)
      (matchingOperator parameter)

namespace ReferenceNuclearDuhamelGreenFullySpectralBoundaryLimitsData

/-- Convert the generated counterterm series to the preceding endpoint-limit
packet. -/
def toCollapsedBoundaryLimits
    {sliceMeasure : Measure Slice} [IsProbabilityMeasure sliceMeasure]
    {shortCutoffFilter : Filter ShortCutoff} [NeBot shortCutoffFilter]
    {longCutoffFilter : Filter LongCutoff} [NeBot longCutoffFilter]
    {nuclear : NuclearHeatDuhamelTraceVariationData (E := E)}
    {countertermContribution : Real → Real}
    {shortTimeRegion longTimeRegion : Set Real}
    (data : ReferenceNuclearDuhamelGreenFullySpectralBoundaryLimitsData
      sliceMeasure shortCutoffFilter longCutoffFilter nuclear
        countertermContribution shortTimeRegion longTimeRegion) :
    ReferenceNuclearDuhamelGreenCollapsedBoundaryLimitsData
      sliceMeasure shortCutoffFilter longCutoffFilter nuclear
        shortTimeRegion longTimeRegion where
  countertermOperator := data.countertermVariation.derivativeOperator
  countertermTraceClass := data.countertermVariation.derivativeTraceClass
  countertermDerivative := data.countertermVariation.derivative
  countertermDerivative_eq_trace :=
    data.countertermVariation.derivative_eq_intrinsicTrace
  shortTime := data.shortTime
  longTime := data.longTime
  countertermMinusShortTraceClass := data.countertermMinusShortTraceClass
  totalTraceClass := data.totalTraceClass
  logarithmicDerivativeOperator := data.logarithmicDerivativeOperator
  logarithmicDerivativeTraceClass := data.logarithmicDerivativeTraceClass
  matchingOperator := data.matchingOperator
  shortBoundaryLimit := data.shortBoundaryLimit
  longBoundaryLimit := data.longBoundaryLimit

/-- The scalar counterterm derivative is generated by the intrinsic nuclear
variation operator. -/
theorem hasDerivAt_countertermContribution
    {sliceMeasure : Measure Slice} [IsProbabilityMeasure sliceMeasure]
    {shortCutoffFilter : Filter ShortCutoff} [NeBot shortCutoffFilter]
    {longCutoffFilter : Filter LongCutoff} [NeBot longCutoffFilter]
    {nuclear : NuclearHeatDuhamelTraceVariationData (E := E)}
    {countertermContribution : Real → Real}
    {shortTimeRegion longTimeRegion : Set Real}
    (data : ReferenceNuclearDuhamelGreenFullySpectralBoundaryLimitsData
      sliceMeasure shortCutoffFilter longCutoffFilter nuclear
        countertermContribution shortTimeRegion longTimeRegion)
    (parameter : Real) :
    HasDerivAt countertermContribution
      (data.countertermVariation.derivative parameter) parameter :=
  data.countertermVariation.hasDerivAt_countertermContribution parameter

/-- The complete integrated Duhamel--Green trace identity with a spectrally
generated counterterm. -/
theorem integratedDuhamel_eq_logarithmicTrace
    {sliceMeasure : Measure Slice} [IsProbabilityMeasure sliceMeasure]
    {shortCutoffFilter : Filter ShortCutoff} [NeBot shortCutoffFilter]
    {longCutoffFilter : Filter LongCutoff} [NeBot longCutoffFilter]
    {nuclear : NuclearHeatDuhamelTraceVariationData (E := E)}
    {countertermContribution : Real → Real}
    {shortTimeRegion longTimeRegion : Set Real}
    (data : ReferenceNuclearDuhamelGreenFullySpectralBoundaryLimitsData
      sliceMeasure shortCutoffFilter longCutoffFilter nuclear
        countertermContribution shortTimeRegion longTimeRegion)
    (parameter : Real) :
    data.countertermVariation.derivative parameter -
        (∫ time in shortTimeRegion,
          nuclear.extendedDuhamelTrace parameter time) -
        (∫ time in longTimeRegion,
          nuclear.extendedDuhamelTrace parameter time) =
      data.toCollapsedBoundaryLimits.toCollapsedBoundary.toBoundaryMatching.
        toOperatorIdentity.logarithmicTrace parameter :=
  data.toCollapsedBoundaryLimits.integratedDuhamel_eq_logarithmicTrace parameter

/-- Public fully spectral boundary-limit checkpoint. -/
theorem reference_nuclear_duhamel_green_fully_spectral_boundary_limits_gate
    (sliceMeasure : Measure Slice) [IsProbabilityMeasure sliceMeasure]
    (shortCutoffFilter : Filter ShortCutoff) [NeBot shortCutoffFilter]
    (longCutoffFilter : Filter LongCutoff) [NeBot longCutoffFilter]
    (nuclear : NuclearHeatDuhamelTraceVariationData (E := E))
    (countertermContribution : Real → Real)
    (shortTimeRegion longTimeRegion : Set Real)
    (data : ReferenceNuclearDuhamelGreenFullySpectralBoundaryLimitsData
      sliceMeasure shortCutoffFilter longCutoffFilter nuclear
        countertermContribution shortTimeRegion longTimeRegion) :
    (∀ parameter,
      HasDerivAt countertermContribution
        (data.countertermVariation.derivative parameter) parameter) ∧
    (∀ parameter,
      data.countertermVariation.derivative parameter =
        intrinsicNuclearTrace
          (data.countertermVariation.derivativeTraceClass parameter)) ∧
    (∀ parameter,
      data.countertermVariation.derivativeOperator parameter -
          data.shortTime.integratedOperator parameter =
        data.logarithmicDerivativeOperator parameter +
          data.matchingOperator parameter) ∧
    (∀ parameter,
      data.longTime.integratedOperator parameter =
        data.matchingOperator parameter) ∧
    (∀ parameter,
      data.countertermVariation.derivative parameter -
          (∫ time in shortTimeRegion,
            nuclear.extendedDuhamelTrace parameter time) -
          (∫ time in longTimeRegion,
            nuclear.extendedDuhamelTrace parameter time) =
        data.toCollapsedBoundaryLimits.toCollapsedBoundary.toBoundaryMatching.
          toOperatorIdentity.logarithmicTrace parameter) :=
  ⟨data.hasDerivAt_countertermContribution,
    data.countertermVariation.derivative_eq_intrinsicTrace,
    data.toCollapsedBoundaryLimits.shortBoundaryIdentity,
    data.toCollapsedBoundaryLimits.longBoundaryIdentity,
    data.integratedDuhamel_eq_logarithmicTrace⟩

end ReferenceNuclearDuhamelGreenFullySpectralBoundaryLimitsData

end
end P0EFTJanusProgramPReferenceNuclearDuhamelGreenFullySpectralBoundaryLimits4D
end JanusFormal
