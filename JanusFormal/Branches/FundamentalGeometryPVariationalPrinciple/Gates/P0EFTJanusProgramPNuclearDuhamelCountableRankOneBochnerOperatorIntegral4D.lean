import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPCountableRankOneNuclearTraceBochnerBridge4D
import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPNuclearDuhamelOperatorIntegral4D

/-!
# Regional countable rank-one Bochner Duhamel integral

For an arbitrary time region, this frontend starts from one Bochner-integrable
operator integrand whose pointwise intrinsic trace is the extended Duhamel
trace.  Countable rank-one data construct the integrated trace certificate and
justify commuting intrinsic trace with the operator integral.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPNuclearDuhamelCountableRankOneBochnerOperatorIntegral4D

set_option autoImplicit false
noncomputable section

open MeasureTheory Set
open P0EFTJanusProgramPCountableRankOneNuclearTraceBochnerBridge4D
open P0EFTJanusProgramPIntrinsicNuclearTrace4D
open P0EFTJanusProgramPNuclearDuhamelOperatorIntegral4D
open P0EFTJanusProgramPNuclearHeatDuhamelTraceVariation4D
open P0EFTJanusProgramPNuclearHeatDuhamelWeightedIntegral4D
open P0EFTJanusProgramPNuclearHeatDuhamelWeightedIntegral4D.NuclearHeatDuhamelTraceVariationData

universe u v

variable {E : Type u}
  [NormedAddCommGroup E] [InnerProductSpace Real E] [CompleteSpace E]

/-- Direct regional operator-integral input. -/
structure NuclearDuhamelCountableRankOneBochnerOperatorIntegralData
    (nuclear : NuclearHeatDuhamelTraceVariationData.{u, v} (E := E))
    (timeRegion : Set Real) where
  weighted : NuclearHeatDuhamelWeightedIntegralData nuclear timeRegion
  operatorIntegrand : Real → Real → E →L[Real] E
  operatorIntegrable : ∀ parameter,
    Integrable (operatorIntegrand parameter) (volume.restrict timeRegion)
  pointwiseTraceClass : ∀ parameter time,
    IntrinsicNuclearTraceData.{u, v} (operatorIntegrand parameter time)
  pointwiseTrace_eq_extendedDuhamelTrace : ∀ parameter,
    ∀ᵐ time ∂volume.restrict timeRegion,
      intrinsicNuclearTrace (pointwiseTraceClass parameter time) =
        extendedDuhamelTrace nuclear parameter time
  rankOne : ∀ parameter,
    CountableRankOneNuclearTraceBochnerBridgeData.{u, v}
      timeRegion (operatorIntegrand parameter)
        (pointwiseTraceClass parameter)

namespace NuclearDuhamelCountableRankOneBochnerOperatorIntegralData

/-- The regional operator is the actual Bochner integral. -/
def integratedOperator
    {nuclear : NuclearHeatDuhamelTraceVariationData.{u, v} (E := E)}
    {timeRegion : Set Real}
    (data : NuclearDuhamelCountableRankOneBochnerOperatorIntegralData
      nuclear timeRegion)
    (parameter : Real) : E →L[Real] E :=
  ∫ time in timeRegion, data.operatorIntegrand parameter time

/-- Nuclearity of the regional integral is generated by the countable
rank-one bridge. -/
def integratedTraceClass
    {nuclear : NuclearHeatDuhamelTraceVariationData.{u, v} (E := E)}
    {timeRegion : Set Real}
    (data : NuclearDuhamelCountableRankOneBochnerOperatorIntegralData
      nuclear timeRegion)
    (parameter : Real) :
    IntrinsicNuclearTraceData.{u, v} (data.integratedOperator parameter) :=
  (data.rankOne parameter).integratedTraceClass

/-- The scalar Duhamel integral is the intrinsic trace of the constructed
operator integral. -/
theorem scalarIntegral_eq_intrinsicTrace
    {nuclear : NuclearHeatDuhamelTraceVariationData.{u, v} (E := E)}
    {timeRegion : Set Real}
    (data : NuclearDuhamelCountableRankOneBochnerOperatorIntegralData
      nuclear timeRegion)
    (parameter : Real) :
    (∫ time in timeRegion, extendedDuhamelTrace nuclear parameter time) =
      intrinsicNuclearTrace (data.integratedTraceClass parameter) := by
  calc
    (∫ time in timeRegion, extendedDuhamelTrace nuclear parameter time) =
        ∫ time in timeRegion,
          intrinsicNuclearTrace (data.pointwiseTraceClass parameter time) := by
      apply integral_congr_ae
      filter_upwards [data.pointwiseTrace_eq_extendedDuhamelTrace parameter]
        with time hTime
      exact hTime.symm
    _ = intrinsicNuclearTrace (data.integratedTraceClass parameter) :=
      (data.rankOne parameter).integral_pointwiseTrace_eq_intrinsicTrace

/-- Complete regional operator-integral packet. -/
def toNuclearDuhamelOperatorIntegral
    {nuclear : NuclearHeatDuhamelTraceVariationData.{u, v} (E := E)}
    {timeRegion : Set Real}
    (data : NuclearDuhamelCountableRankOneBochnerOperatorIntegralData
      nuclear timeRegion) :
    NuclearDuhamelOperatorIntegralData.{u, v} nuclear timeRegion where
  weighted := data.weighted
  integratedOperator := data.integratedOperator
  integratedTraceClass := data.integratedTraceClass
  scalarIntegral_eq_trace := data.scalarIntegral_eq_intrinsicTrace

/-- Public regional countable-Bochner checkpoint. -/
theorem nuclear_duhamel_countable_rank_one_bochner_operator_integral_gate
    (nuclear : NuclearHeatDuhamelTraceVariationData.{u, v} (E := E))
    (timeRegion : Set Real)
    (data : NuclearDuhamelCountableRankOneBochnerOperatorIntegralData
      nuclear timeRegion) :
    (∀ parameter,
      Integrable (data.operatorIntegrand parameter)
        (volume.restrict timeRegion)) ∧
    (∀ parameter,
      data.toNuclearDuhamelOperatorIntegral.integratedOperator parameter =
        ∫ time in timeRegion, data.operatorIntegrand parameter time) ∧
    (∀ parameter,
      (∫ time in timeRegion, extendedDuhamelTrace nuclear parameter time) =
        intrinsicNuclearTrace
          (data.toNuclearDuhamelOperatorIntegral.integratedTraceClass
            parameter)) :=
  ⟨data.operatorIntegrable, fun _ ↦ rfl,
    data.scalarIntegral_eq_intrinsicTrace⟩

end NuclearDuhamelCountableRankOneBochnerOperatorIntegralData

end
end P0EFTJanusProgramPNuclearDuhamelCountableRankOneBochnerOperatorIntegral4D
end JanusFormal
