import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusCyclicMomentReconstruction

/-!
# The observable bulk of an arbitrary bounded realization

For self-adjoint bulk operators, the closure of the boundary-generated Krylov
span is a canonical reducing subspace. Restricting the operator and marking constructs
a cyclic realization with exactly the same moments. Consequently equal complete
moments determine the observable reductions even when the original realizations
contain invisible sectors. No cyclicity hypothesis is imposed on the originals.
-/

namespace JanusFormal
namespace P0EFTJanusObservableBulkReduction

set_option autoImplicit false
noncomputable section

open scoped InnerProductSpace
open P0EFTJanusCyclicMomentReconstruction

variable {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]
  {Boundary : Type*}

/-- The closed bulk subspace generated by the boundary and all bulk powers. -/
def visibleSubspace (A : H →L[ℝ] H) (B : Boundary → H) : Submodule ℝ H :=
  (Submodule.span ℝ (Set.range (krylovFamily A B))).topologicalClosure

theorem krylov_mem_visible (A : H →L[ℝ] H) (B : Boundary → H)
    (i : ℕ × Boundary) : krylovFamily A B i ∈ visibleSubspace A B :=
  Submodule.le_topologicalClosure _ (Submodule.subset_span (Set.mem_range_self i))

theorem marking_mem_visible (A : H →L[ℝ] H) (B : Boundary → H)
    (q : Boundary) : B q ∈ visibleSubspace A B := by
  simpa [krylovFamily] using krylov_mem_visible A B (0, q)

theorem visible_isClosed (A : H →L[ℝ] H) (B : Boundary → H) :
    IsClosed (visibleSubspace A B : Set H) :=
  Submodule.isClosed_topologicalClosure _

/-- Invariance follows from the actual Krylov construction and continuity. -/
theorem visible_invariant (A : H →L[ℝ] H) (B : Boundary → H) :
    ∀ x ∈ visibleSubspace A B, A x ∈ visibleSubspace A B := by
  have hs : Set.MapsTo A
      (Submodule.span ℝ (Set.range (krylovFamily A B)) : Set H)
      (Submodule.span ℝ (Set.range (krylovFamily A B)) : Set H) := by
    change Submodule.span ℝ (Set.range (krylovFamily A B)) ≤
      (Submodule.span ℝ (Set.range (krylovFamily A B))).comap A.toLinearMap
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨n, q⟩, rfl⟩
    change A ((A ^ n) (B q)) ∈ Submodule.span ℝ (Set.range (krylovFamily A B))
    rw [← mul_apply_eq_comp, ← pow_succ']
    exact Submodule.subset_span (Set.mem_range_self (n + 1, q))
  exact hs.closure A.continuous

/-- Every closed invariant subspace containing the marking contains the visible bulk. -/
theorem visible_minimal (A : H →L[ℝ] H) (B : Boundary → H)
    (W : Submodule ℝ H) (hclosed : IsClosed (W : Set H))
    (hinv : ∀ x ∈ W, A x ∈ W) (hmark : ∀ q, B q ∈ W) :
    visibleSubspace A B ≤ W := by
  apply Submodule.topologicalClosure_minimal _ _ hclosed
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨n, q⟩, rfl⟩
  change (A ^ n) (B q) ∈ W
  induction n with
  | zero => simpa using hmark q
  | succ n ih => simpa only [pow_succ', mul_apply_eq_comp] using hinv _ ih

/-- The bounded operator on the observable subspace. -/
def visibleOperator (A : H →L[ℝ] H) (B : Boundary → H) :
    visibleSubspace A B →L[ℝ] visibleSubspace A B :=
  A.restrict (visible_invariant A B)

/-- The original marking, now valued in its closed cyclic subspace. -/
def visibleMarking (A : H →L[ℝ] H) (B : Boundary → H) :
    Boundary → visibleSubspace A B :=
  fun q => ⟨B q, marking_mem_visible A B q⟩

@[simp] theorem visibleOperator_coe (A : H →L[ℝ] H) (B : Boundary → H)
    (x : visibleSubspace A B) : (visibleOperator A B x : H) = A x := rfl

@[simp] theorem visibleMarking_coe (A : H →L[ℝ] H) (B : Boundary → H)
    (q : Boundary) : (visibleMarking A B q : H) = B q := rfl

@[simp] theorem visibleOperator_pow_coe (A : H →L[ℝ] H) (B : Boundary → H)
    (n : ℕ) (x : visibleSubspace A B) :
    ((visibleOperator A B ^ n) x : H) = (A ^ n) x := by
  induction n with
  | zero => simp
  | succ n ih => simp only [pow_succ', mul_apply_eq_comp, visibleOperator_coe, ih]

@[simp] theorem visible_krylov_coe (A : H →L[ℝ] H) (B : Boundary → H)
    (i : ℕ × Boundary) :
    (↑(krylovFamily (visibleOperator A B) (visibleMarking A B) i) : H) =
      krylovFamily A B i := by
  simp only [krylovFamily, visibleOperator_pow_coe, visibleMarking_coe]

/-- The restriction is cyclic by construction, not by an added hypothesis. -/
theorem visible_isCyclic (A : H →L[ℝ] H) (B : Boundary → H) :
    IsCyclic (visibleOperator A B) (visibleMarking A B) := by
  let V := visibleSubspace A B
  let K := krylovFamily (visibleOperator A B) (visibleMarking A B)
  have hmap : (Submodule.span ℝ (Set.range K)).map V.subtype =
      Submodule.span ℝ (Set.range (krylovFamily A B)) := by
    rw [Submodule.map_span, ← Set.range_comp]
    congr 2
    funext i
    exact visible_krylov_coe A B i
  change Dense (Submodule.span ℝ (Set.range K) : Set V)
  rw [Topology.IsInducing.subtypeVal.dense_iff]
  intro x
  change (x : H) ∈ closure
    (((Submodule.span ℝ (Set.range K)).map V.subtype : Submodule ℝ H) : Set H)
  rw [hmap]
  exact x.property

/-- Restriction preserves every measured moment, including the marking Gram matrix. -/
@[simp] theorem visible_boundaryMoment (A : H →L[ℝ] H) (B : Boundary → H)
    (n : ℕ) (q r : Boundary) :
    boundaryMoment (visibleOperator A B) (visibleMarking A B) n q r =
      boundaryMoment A B n q r := by
  unfold boundaryMoment
  change ⟪(visibleMarking A B q : H),
    ((visibleOperator A B ^ n) (visibleMarking A B r) : H)⟫_ℝ = _
  simp only [visibleOperator_pow_coe, visibleMarking_coe]

variable [CompleteSpace H]

instance visible_completeSpace (A : H →L[ℝ] H) (B : Boundary → H) :
    CompleteSpace (visibleSubspace A B) :=
  Submodule.topologicalClosure.completeSpace _

theorem visible_isSelfAdjoint (A : H →L[ℝ] H) (hA : IsSelfAdjoint A)
    (B : Boundary → H) : IsSelfAdjoint (visibleOperator A B) := by
  apply ContinuousLinearMap.isSelfAdjoint_iff_isSymmetric.mpr
  intro x y
  exact hA.isSymmetric x y

/-- The orthogonal, boundary-invisible sector is also invariant. -/
theorem invisible_invariant (A : H →L[ℝ] H) (hA : IsSelfAdjoint A)
    (B : Boundary → H) :
    ∀ x ∈ (visibleSubspace A B)ᗮ, A x ∈ (visibleSubspace A B)ᗮ := by
  intro x hx
  rw [Submodule.mem_orthogonal] at hx ⊢
  intro y hy
  exact (hA.isSymmetric y x).symm.trans (hx (A y) (visible_invariant A B y hy))

omit [CompleteSpace H] in
/-- No boundary-generated vector sees the invisible sector. -/
theorem invisible_orthogonal_krylov (A : H →L[ℝ] H) (B : Boundary → H)
    (x : H) (hx : x ∈ (visibleSubspace A B)ᗮ) (i : ℕ × Boundary) :
    ⟪krylovFamily A B i, x⟫_ℝ = 0 :=
  (Submodule.mem_orthogonal _ _).mp hx _ (krylov_mem_visible A B i)

omit [CompleteSpace H] in
/-- The invisible sector consists exactly of vectors orthogonal to every Krylov probe. -/
theorem invisible_iff_krylov (A : H →L[ℝ] H) (B : Boundary → H) (x : H) :
    x ∈ (visibleSubspace A B)ᗮ ↔
      ∀ n q, ⟪(A ^ n) (B q), x⟫_ℝ = 0 := by
  constructor
  · intro hx n q
    exact invisible_orthogonal_krylov A B x hx (n, q)
  · intro h
    have hspan : Submodule.span ℝ (Set.range (krylovFamily A B)) ≤
        (innerSL ℝ x).ker := by
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨n, q⟩, rfl⟩
      change ⟪x, (A ^ n) (B q)⟫_ℝ = 0
      rw [real_inner_comm]
      exact h n q
    have hvisible : visibleSubspace A B ≤ (innerSL ℝ x).ker :=
      Submodule.topologicalClosure_minimal _ hspan (innerSL ℝ x).isClosed_ker
    rw [Submodule.mem_orthogonal']
    exact fun y hy => hvisible hy

/-- Equivalently, all iterates of an invisible bulk vector have zero boundary signal. -/
theorem invisible_iff_zero_boundary_signal (A : H →L[ℝ] H) (hA : IsSelfAdjoint A)
    (B : Boundary → H) (x : H) :
    x ∈ (visibleSubspace A B)ᗮ ↔
      ∀ n q, ⟪B q, (A ^ n) x⟫_ℝ = 0 := by
  rw [invisible_iff_krylov]
  simp only [inner_pow A hA]

/-- Every bulk state splits into visible and invisible components. -/
theorem visible_invisible_decomposition (A : H →L[ℝ] H) (B : Boundary → H) (x : H) :
    ∃ y ∈ visibleSubspace A B, ∃ z ∈ (visibleSubspace A B)ᗮ, x = y + z :=
  (visibleSubspace A B).exists_add_mem_mem_orthogonal x

variable {H₂ : Type*} [NormedAddCommGroup H₂] [InnerProductSpace ℝ H₂]
  [CompleteSpace H₂]

/-- Complete moments classify the observable parts of arbitrary bounded
self-adjoint realizations. The originals need not be cyclic or finite-dimensional. -/
theorem moments_determine_visible_realization
    (A₁ : H →L[ℝ] H) (A₂ : H₂ →L[ℝ] H₂)
    (hA₁ : IsSelfAdjoint A₁) (hA₂ : IsSelfAdjoint A₂)
    (B₁ : Boundary → H) (B₂ : Boundary → H₂)
    (hmom : ∀ n q r, boundaryMoment A₁ B₁ n q r = boundaryMoment A₂ B₂ n q r) :
    ∃! U : visibleSubspace A₁ B₁ ≃ₗᵢ[ℝ] visibleSubspace A₂ B₂,
      (∀ q, U (visibleMarking A₁ B₁ q) = visibleMarking A₂ B₂ q) ∧
      (∀ x, U (visibleOperator A₁ B₁ x) = visibleOperator A₂ B₂ (U x)) := by
  apply moments_determine_cyclic_realization
    (visibleOperator A₁ B₁) (visibleOperator A₂ B₂)
    (visible_isSelfAdjoint A₁ hA₁ B₁) (visible_isSelfAdjoint A₂ hA₂ B₂)
    (visibleMarking A₁ B₁) (visibleMarking A₂ B₂)
    (visible_isCyclic A₁ B₁) (visible_isCyclic A₂ B₂)
  intro n q r
  simpa only [visible_boundaryMoment] using hmom n q r

end
end P0EFTJanusObservableBulkReduction
end JanusFormal
