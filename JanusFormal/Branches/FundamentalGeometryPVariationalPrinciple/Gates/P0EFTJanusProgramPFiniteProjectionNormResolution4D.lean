import Mathlib

/-!
# Norm-square decomposition from a finite positive projection resolution

A finite family of bounded projections resolves the identity.  If each
projection satisfies

`⟪P_s x, x⟫ = ‖P_s x‖²`,

then the Pythagorean norm decomposition follows by summing the inner products.
The latter identity is the exact local statement supplied by orthogonal
self-adjoint projections.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPFiniteProjectionNormResolution4D

set_option autoImplicit false
noncomputable section

open scoped BigOperators InnerProductSpace

variable {Sector E : Type*}
  [Fintype Sector] [DecidableEq Sector]
  [NormedAddCommGroup E]
  [InnerProductSpace Real E]

/-- A finite resolution of the identity by positive projections. -/
structure FiniteProjectionNormResolutionData where
  projection : Sector → E →L[Real] E
  sum_projection : ∀ vector,
    (∑ sector : Sector, projection sector vector) = vector
  projection_inner_eq_norm_sq : ∀ sector vector,
    inner Real (projection sector vector) vector =
      ‖projection sector vector‖ ^ 2

namespace FiniteProjectionNormResolutionData

/-- Pythagorean norm decomposition generated by the projection resolution. -/
theorem norm_sq_decomposition
    (data : FiniteProjectionNormResolutionData
      (Sector := Sector) (E := E))
    (vector : E) :
    ‖vector‖ ^ 2 =
      ∑ sector : Sector, ‖data.projection sector vector‖ ^ 2 := by
  calc
    ‖vector‖ ^ 2 = inner Real vector vector :=
      (real_inner_self_eq_norm_sq vector).symm
    _ = inner Real
        (∑ sector : Sector, data.projection sector vector) vector := by
      rw [data.sum_projection vector]
    _ = ∑ sector : Sector,
        inner Real (data.projection sector vector) vector := by
      rw [sum_inner]
    _ = ∑ sector : Sector,
        ‖data.projection sector vector‖ ^ 2 := by
      apply Finset.sum_congr rfl
      intro sector _
      exact data.projection_inner_eq_norm_sq sector vector

/-- Every sector norm-square is nonnegative. -/
theorem projection_norm_sq_nonneg
    (data : FiniteProjectionNormResolutionData
      (Sector := Sector) (E := E))
    (sector : Sector) (vector : E) :
    0 ≤ ‖data.projection sector vector‖ ^ 2 :=
  sq_nonneg _

/-- Public finite projection-resolution checkpoint. -/
theorem finite_projection_norm_resolution_gate
    (data : FiniteProjectionNormResolutionData
      (Sector := Sector) (E := E)) :
    ∀ vector : E,
      ‖vector‖ ^ 2 =
        ∑ sector : Sector, ‖data.projection sector vector‖ ^ 2 :=
  data.norm_sq_decomposition

end FiniteProjectionNormResolutionData

end
end P0EFTJanusProgramPFiniteProjectionNormResolution4D
end JanusFormal
