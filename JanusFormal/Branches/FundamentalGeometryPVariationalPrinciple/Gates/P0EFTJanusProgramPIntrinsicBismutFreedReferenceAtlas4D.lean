import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPIntrinsicRelativeTraceReferenceCocycle4D
import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPRelativeHeatMellinZetaAtlas4D

/-!
# Determinant-line atlases generated by intrinsic reference traces

A spectral-cut atlas is modelled by one actual reduced operator family and a
collection of reference families.  Each chart carries an honest Mellin/zeta
family for the corresponding actual-minus-reference problem.

The only comparison input is the local Bismut--Freed identity

`d/da zeta'_i(0,a) = -Tr(H/R_i)`.

The determinant transitions, their Cech cocycle and their connection gauge law
are then those of the generated zeta atlas.  More importantly, the logarithmic
derivative of the transition `i -> j` is proved to be the intrinsic
reference-change trace `Tr(R_i/R_j)`.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPIntrinsicBismutFreedReferenceAtlas4D

set_option autoImplicit false
set_option maxHeartbeats 4600000
set_option synthInstance.maxHeartbeats 2300000

noncomputable section

open P0EFTJanusProgramPIntrinsicRelativeTraceReferenceCocycle4D
open P0EFTJanusProgramPRelativeHeatFinitePartFamily4D
open P0EFTJanusProgramPRelativeHeatMellinZetaAtlas4D
open P0EFTJanusProgramPRelativeHeatMellinZetaFamily4D
open P0EFTJanusProgramPRelativeZetaDeterminantCocycle4D
open P0EFTJanusProgramPRelativeZetaDeterminantLineAtlas4D
open P0EFTJanusProgramPRelativeZetaFinitePartFamily4D

variable {E Index : Type*}
  [NormedAddCommGroup E] [NormedSpace Real E]
  [InnerProductSpace Real E] [CompleteSpace E]

/-- Operator-generated local Mellin families for one actual family and many
references. -/
structure IntrinsicBismutFreedReferenceAtlasData
    (actual : Real → E →L[Real] E)
    (reference : Index → Real → E →L[Real] E) where
  operatorCocycle :
    IntrinsicRelativeTraceReferenceCocycleData actual reference
  family : Index → RelativeHeatMellinZetaFamilyData
  coefficient_agreement : ∀ index parameter,
    relativeZetaConnectionCoefficient (family index).toZetaFamily parameter =
      operatorCocycle.localCoefficient index parameter

namespace IntrinsicBismutFreedReferenceAtlasData

/-- Mellin atlas generated by the local actual/reference families. -/
def mellinAtlas
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference) :
    RelativeHeatMellinZetaFamilyAtlasData Index where
  family := data.family

/-- Underlying local zeta atlas. -/
def zetaAtlas
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference) :
    RelativeZetaLocalFamilyAtlasData Index :=
  data.mellinAtlas.toZetaAtlas

/-- Local determinant coordinate. -/
def localDeterminant
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference)
    (index : Index) (parameter : Real) : Complex :=
  relativeHeatMellinZetaFamilyDeterminant (data.family index) parameter

/-- Transition between two reference charts. -/
def transition
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference)
    (first second : Index) (parameter : Real) : Complex :=
  relativeZetaTransition data.zetaAtlas first second parameter

/-- The local finite-part logarithmic derivative is the exact intrinsic
actual-minus-reference trace. -/
theorem finitePart_logDerivative_eq_localTrace
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference)
    (index : Index) (parameter : Real) :
    (data.family index).finitePartFamily.logDerivative parameter =
      data.operatorCocycle.localTrace index parameter := by
  calc
    (data.family index).finitePartFamily.logDerivative parameter =
        -((relativeZetaConnectionCoefficient
          (data.family index).toZetaFamily parameter).re) :=
      (data.family index).connection_realPart parameter
    _ = -(data.operatorCocycle.localCoefficient index parameter).re := by
      rw [data.coefficient_agreement index parameter]
    _ = data.operatorCocycle.localTrace index parameter := by
      rfl

/-- Difference of local zeta coefficients equals the intrinsic
reference-change trace. -/
theorem coefficient_sub_eq_referenceChangeTrace
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference)
    (first second : Index) (parameter : Real) :
    relativeZetaConnectionCoefficient (data.family first).toZetaFamily parameter -
        relativeZetaConnectionCoefficient (data.family second).toZetaFamily
          parameter =
      (data.operatorCocycle.referenceChangeTrace first second parameter :
        Complex) := by
  rw [data.coefficient_agreement first parameter,
    data.coefficient_agreement second parameter]
  exact data.operatorCocycle.localCoefficient_sub first second parameter

/-- The derivative of the determinant transition is generated by the
intrinsic reference-change trace. -/
theorem transitionDerivative_eq_referenceChangeTrace
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference)
    (first second : Index) (parameter : Real) :
    relativeZetaTransitionDerivative data.zetaAtlas first second parameter =
      (data.operatorCocycle.referenceChangeTrace first second parameter :
          Complex) * data.transition first second parameter := by
  unfold relativeZetaTransitionDerivative transition
  change
    (relativeZetaConnectionCoefficient
        (data.family first).toZetaFamily parameter -
      relativeZetaConnectionCoefficient
        (data.family second).toZetaFamily parameter) *
        relativeZetaTransition data.zetaAtlas first second parameter = _
  rw [data.coefficient_sub_eq_referenceChangeTrace first second parameter]

/-- Local finite-part logarithms change by the intrinsic reference trace. -/
theorem finitePart_logDerivative_changeReference
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference)
    (first second : Index) (parameter : Real) :
    (data.family second).finitePartFamily.logDerivative parameter =
      (data.family first).finitePartFamily.logDerivative parameter +
        data.operatorCocycle.referenceChangeTrace first second parameter := by
  rw [data.finitePart_logDerivative_eq_localTrace,
    data.finitePart_logDerivative_eq_localTrace]
  exact data.operatorCocycle.localTrace_changeReference first second parameter

/-- The generated determinant transitions satisfy the Cech cocycle. -/
theorem transition_cocycle
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference)
    (first second third : Index) (parameter : Real) :
    data.transition second third parameter *
        data.transition first second parameter =
      data.transition first third parameter :=
  relativeZetaTransition_cocycle data.zetaAtlas first second third parameter

/-- The generated local connection obeys the exact gauge law. -/
theorem transition_connectionGauge
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference)
    (first second : Index) (parameter : Real) :
    relativeZetaTransitionDerivative data.zetaAtlas first second parameter +
        relativeZetaConnectionCoefficient
            (data.family second).toZetaFamily parameter *
          data.transition first second parameter =
      data.transition first second parameter *
        relativeZetaConnectionCoefficient
          (data.family first).toZetaFamily parameter := by
  simpa [transition, zetaAtlas, mellinAtlas] using
    relativeHeatMellinZetaTransition_connectionGauge data.mellinAtlas first
      second parameter

/-- Determinant-line atlas certificate generated from the local Mellin families. -/
def determinantLineAtlasCertificate
    {actual : Real → E →L[Real] E}
    {reference : Index → Real → E →L[Real] E}
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference) :
    RelativeZetaDeterminantLineAtlasCertificate data.zetaAtlas :=
  relativeZetaDeterminantLineAtlasCertificate data.zetaAtlas

/-- Public operator-generated spectral-cut atlas checkpoint. -/
theorem intrinsic_bismut_freed_reference_atlas_gate
    (actual : Real → E →L[Real] E)
    (reference : Index → Real → E →L[Real] E)
    (data : IntrinsicBismutFreedReferenceAtlasData actual reference) :
    RelativeZetaDeterminantLineAtlasCertificate data.zetaAtlas ∧
      (∀ first second parameter,
        relativeZetaTransitionDerivative data.zetaAtlas first second parameter =
          (data.operatorCocycle.referenceChangeTrace first second parameter :
              Complex) * data.transition first second parameter) ∧
      (∀ first second third parameter,
        data.transition second third parameter *
            data.transition first second parameter =
          data.transition first third parameter) ∧
      (∀ first second parameter,
        (data.family second).finitePartFamily.logDerivative parameter =
          (data.family first).finitePartFamily.logDerivative parameter +
            data.operatorCocycle.referenceChangeTrace first second parameter) :=
  ⟨data.determinantLineAtlasCertificate,
    data.transitionDerivative_eq_referenceChangeTrace,
    data.transition_cocycle,
    data.finitePart_logDerivative_changeReference⟩

end IntrinsicBismutFreedReferenceAtlasData

end
end P0EFTJanusProgramPIntrinsicBismutFreedReferenceAtlas4D
end JanusFormal
