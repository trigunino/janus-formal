/-- Concrete invariant reference modes, complement gap and LL stationarity. -/
structure GlobalCandidateAActualNamedInvariantOrthogonalGapData4D
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction)
    (Mode : Type*) [Fintype Mode] [DecidableEq Mode] : Prop where
  invariantGap : FiniteModeNamedInvariantOrthogonalGapData
    (globalCandidateAActualKernelOperator period hPeriod configuration data
      analysis chart sameAction physical)
    (globalCandidateAActualKernelOperator_isSelfAdjoint period hPeriod
      configuration data analysis chart sameAction physical)
    (Mode := Mode)
  ll_stationary : ∀ point,
    LLStationaryAt period hPeriod
      (data.boundary.llFields period hPeriod) point

/-- Convert to the preceding named-vector Schur packet. -/
def GlobalCandidateAActualNamedInvariantOrthogonalGapData4D.toNamedVectorsData
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure}
    {sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart}
    {physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction}
    {Mode : Type*} [Fintype Mode] [DecidableEq Mode]
    (invariant : GlobalCandidateAActualNamedInvariantOrthogonalGapData4D period
      hPeriod configuration data analysis chart sameAction physical Mode) :
    GlobalCandidateAActualOrthogonalSchurNamedVectorsData4D period hPeriod
      configuration data analysis chart sameAction physical Mode where
  namedData :=
    { vector := invariant.invariantGap.vector
      linearIndependent := invariant.invariantGap.linearIndependent
      complementEquiv := invariant.invariantGap.toInvariantData.complementEquiv
      complementEquiv_eq := rfl }
  ll_stationary := invariant.ll_stationary

/-- Exact block-diagonal identities for the Candidate-A Hessian. -/
theorem GlobalCandidateAActualNamedInvariantOrthogonalGapData4D.schur_eq_finiteBlock
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure}
    {sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart}
    {physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction}
    {Mode : Type*} [Fintype Mode] [DecidableEq Mode]
    (invariant : GlobalCandidateAActualNamedInvariantOrthogonalGapData4D period
      hPeriod configuration data analysis chart sameAction physical Mode) :
    (invariant.toNamedVectorsData period hPeriod).toBasisData.toOrthogonalData.schur =
      (invariant.toNamedVectorsData period hPeriod).toBasisData.toOrthogonalData.blocks.A :=
  invariant.invariantGap.toInvariantData.schur_eq_blockA

/-- Public Candidate-A invariant reduction checkpoint. -/
theorem global_candidateA_actual_named_invariant_orthogonal_reduction_gate
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction)
    (Mode : Type*) [Fintype Mode] [DecidableEq Mode]
    (invariant : GlobalCandidateAActualNamedInvariantOrthogonalGapData4D period
      hPeriod configuration data analysis chart sameAction physical Mode) :=
  (finite_mode_named_invariant_orthogonal_reduction_gate
      invariant.invariantGap,
    global_candidateA_actual_orthogonal_schur_named_vectors_gate period hPeriod
      configuration data analysis chart sameAction physical Mode
      (invariant.toNamedVectorsData period hPeriod),
    invariant.schur_eq_finiteBlock period hPeriod)

end
