import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPRelativeHeatMellinZetaFamily4D
import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPRelativeZetaDeterminantLineAtlas4D

/-!
# Determinant-line atlas generated by local Mellin families

A local zeta atlas should not be supplied independently of the heat operators
which generate its local determinants.  This file starts with one honest
parameter-uniform Mellin continuation on every chart and forgets only the
Mellin witnesses when constructing the existing zeta cocycle.

Consequently every local determinant, transition function and connection
coefficient is generated by a heat-Mellin family.  The Cech cocycle and gauge
law remain consequences of nonvanishing local determinants; no additional
transition datum is stored.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPRelativeHeatMellinZetaAtlas4D

set_option autoImplicit false
noncomputable section

open P0EFTJanusProgramPRelativeHeatMellinZetaFamily4D
open P0EFTJanusProgramPRelativeZetaDeterminantCocycle4D
open P0EFTJanusProgramPRelativeZetaDeterminantLineAtlas4D

/-- A cover by local, parameter-uniform Mellin continuations. -/
structure RelativeHeatMellinZetaFamilyAtlasData (Index : Type*) where
  family : Index → RelativeHeatMellinZetaFamilyData

/-- Forget the explicit Mellin representations and retain the zeta families
used by the determinant-line atlas. -/
def RelativeHeatMellinZetaFamilyAtlasData.toZetaAtlas
    {Index : Type*}
    (atlas : RelativeHeatMellinZetaFamilyAtlasData Index) :
    RelativeZetaLocalFamilyAtlasData Index where
  family := fun index => (atlas.family index).toZetaFamily

/-- Local determinant generated by the Mellin family on one chart. -/
def relativeHeatMellinZetaLocalDeterminant
    {Index : Type*}
    (atlas : RelativeHeatMellinZetaFamilyAtlasData Index)
    (index : Index) (parameter : Real) : Complex :=
  relativeHeatMellinZetaFamilyDeterminant (atlas.family index) parameter

/-- The preceding local determinant is definitionally the local determinant of
the generated zeta atlas. -/
@[simp] theorem relativeHeatMellinZetaLocalDeterminant_eq_zetaAtlas
    {Index : Type*}
    (atlas : RelativeHeatMellinZetaFamilyAtlasData Index)
    (index : Index) (parameter : Real) :
    relativeHeatMellinZetaLocalDeterminant atlas index parameter =
      relativeZetaLocalDeterminant atlas.toZetaAtlas index parameter :=
  rfl

/-- Transition function of the generated determinant-line atlas. -/
def relativeHeatMellinZetaTransition
    {Index : Type*}
    (atlas : RelativeHeatMellinZetaFamilyAtlasData Index)
    (first second : Index) (parameter : Real) : Complex :=
  relativeZetaTransition atlas.toZetaAtlas first second parameter

/-- Mellin-generated transitions satisfy the exact Cech cocycle. -/
theorem relativeHeatMellinZetaTransition_cocycle
    {Index : Type*}
    (atlas : RelativeHeatMellinZetaFamilyAtlasData Index)
    (first second third : Index) (parameter : Real) :
    relativeHeatMellinZetaTransition atlas second third parameter *
        relativeHeatMellinZetaTransition atlas first second parameter =
      relativeHeatMellinZetaTransition atlas first third parameter :=
  relativeZetaTransition_cocycle atlas.toZetaAtlas first second third parameter

/-- Mellin-generated transitions obey the connection gauge law. -/
theorem relativeHeatMellinZetaTransition_connectionGauge
    {Index : Type*}
    (atlas : RelativeHeatMellinZetaFamilyAtlasData Index)
    (first second : Index) (parameter : Real) :
    relativeZetaTransitionDerivative atlas.toZetaAtlas first second parameter +
        relativeZetaConnectionCoefficient
            (atlas.family second).toZetaFamily parameter *
          relativeHeatMellinZetaTransition atlas first second parameter =
      relativeHeatMellinZetaTransition atlas first second parameter *
        relativeZetaConnectionCoefficient
          (atlas.family first).toZetaFamily parameter := by
  simpa [relativeHeatMellinZetaTransition,
    RelativeHeatMellinZetaFamilyAtlasData.toZetaAtlas] using
    relativeZetaTransition_connectionGauge atlas.toZetaAtlas first second
      parameter

/-- The existing determinant-line atlas certificate is therefore generated
without any independent zeta or transition input. -/
def relativeHeatMellinZetaDeterminantLineAtlasCertificate
    {Index : Type*}
    (atlas : RelativeHeatMellinZetaFamilyAtlasData Index) :
    RelativeZetaDeterminantLineAtlasCertificate atlas.toZetaAtlas :=
  relativeZetaDeterminantLineAtlasCertificate atlas.toZetaAtlas

/-- Public Mellin-atlas checkpoint. -/
theorem relative_heat_mellin_zeta_atlas_gate
    {Index : Type*}
    (atlas : RelativeHeatMellinZetaFamilyAtlasData Index) :
    RelativeZetaDeterminantLineAtlasCertificate atlas.toZetaAtlas :=
  relativeHeatMellinZetaDeterminantLineAtlasCertificate atlas

end
end P0EFTJanusProgramPRelativeHeatMellinZetaAtlas4D
end JanusFormal
