/-- The same Euler formula with the six independent symmetric-matrix
coefficients displayed explicitly. -/
theorem programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (jet : FourthJet) :
    programPT06SecondOrderLocalEuler
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        jet =
      realCovector
        (density.valueLinear +
          2 * density.valueSquare * jet fourthOrderZeroMultiIndex -
          density.firstQuadratic 0 0 * jet second00 -
          2 * density.firstQuadratic 0 1 * jet second01 -
          2 * density.firstQuadratic 0 2 * jet second02 -
          density.firstQuadratic 1 1 * jet second11 -
          2 * density.firstQuadratic 1 2 * jet second12 -
          density.firstQuadratic 2 2 * jet second22) := by
  rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_formula]
  apply ContinuousLinearMap.ext
  intro variation
  simp [Fin.sum_univ_succ, realCovector,
    fourthOrderSecondMultiIndex_comm 1 0,
    fourthOrderSecondMultiIndex_comm 2 0,
    fourthOrderSecondMultiIndex_comm 2 1,
    density.firstQuadratic_symm 1 0,
    density.firstQuadratic_symm 2 0,
    density.firstQuadratic_symm 2 1]
  ring

private theorem symmetricFirstQuadratic_eq_zero_of_upper
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (h00 : density.firstQuadratic 0 0 = 0)
    (h01 : density.firstQuadratic 0 1 = 0)
    (h02 : density.firstQuadratic 0 2 = 0)
    (h11 : density.firstQuadratic 1 1 = 0)
    (h12 : density.firstQuadratic 1 2 = 0)
    (h22 : density.firstQuadratic 2 2 = 0) :
    forall first second : Fin 3,
      density.firstQuadratic first second = 0 := by
  intro first second
  fin_cases first <;> fin_cases second
  · exact h00
  · exact h01
  · exact h02
  · calc
      density.firstQuadratic 1 0 = density.firstQuadratic 0 1 :=
        density.firstQuadratic_symm 1 0
      _ = 0 := h01
  · exact h11
  · exact h12
  · calc
      density.firstQuadratic 2 0 = density.firstQuadratic 0 2 :=
        density.firstQuadratic_symm 2 0
      _ = 0 := h02
  · calc
      density.firstQuadratic 2 1 = density.firstQuadratic 1 2 :=
        density.firstQuadratic_symm 2 1
      _ = 0 := h12
  · exact h22

/-- Euler vanishing is equivalent to vanishing of the value obstruction and
the complete symmetric first-derivative quadratic matrix. -/
theorem programPT06_scalarMultidirectionalQuadratic_euler_eq_zero_iff
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D) :
    (forall jet : FourthJet,
      programPT06SecondOrderLocalEuler
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        jet = 0) <->
      And (density.valueLinear = 0)
        (And (density.valueSquare = 0)
          (forall first second : Fin 3,
            density.firstQuadratic first second = 0)) := by
  constructor
  · intro hEuler
    have hAtZero := congrArg
      (fun covector : ContinuousLinearMap (RingHom.id Real) Real Real =>
        covector 1)
      (hEuler 0)
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit]
      at hAtZero
    have hLinear : density.valueLinear = 0 := by
      simpa [realCovector] using hAtZero
    have hAtValue := congrArg
      (fun covector : ContinuousLinearMap (RingHom.id Real) Real Real =>
        covector 1)
      (hEuler
        (programPT06ThroatSpatialJetCoordinateInjection
          fourthOrderZeroMultiIndex 1))
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit]
      at hAtValue
    have hValueSquare : density.valueSquare = 0 := by
      simp [realCovector, hLinear, fourthOrderSecondMultiIndex_ne_zero,
        programPT06ThroatSpatialJetCoordinateInjection_same,
        programPT06ThroatSpatialJetCoordinateInjection_of_ne] at hAtValue
      linarith
    have hAt00 := congrArg
      (fun covector : ContinuousLinearMap (RingHom.id Real) Real Real =>
        covector 1)
      (hEuler (programPT06ThroatSpatialJetCoordinateInjection second00 1))
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit]
      at hAt00
    have h00 : density.firstQuadratic 0 0 = 0 := by
      simp [realCovector, hLinear, hValueSquare] at hAt00
      linarith
    have hAt01 := congrArg
      (fun covector : ContinuousLinearMap (RingHom.id Real) Real Real =>
        covector 1)
      (hEuler (programPT06ThroatSpatialJetCoordinateInjection second01 1))
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit]
      at hAt01
    have h01 : density.firstQuadratic 0 1 = 0 := by
      simp [realCovector, hLinear, hValueSquare] at hAt01
      linarith
    have hAt02 := congrArg
      (fun covector : ContinuousLinearMap (RingHom.id Real) Real Real =>
        covector 1)
      (hEuler (programPT06ThroatSpatialJetCoordinateInjection second02 1))
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit]
      at hAt02
    have h02 : density.firstQuadratic 0 2 = 0 := by
      simp [realCovector, hLinear, hValueSquare] at hAt02
      linarith
    have hAt11 := congrArg
      (fun covector : ContinuousLinearMap (RingHom.id Real) Real Real =>
        covector 1)
      (hEuler (programPT06ThroatSpatialJetCoordinateInjection second11 1))
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit]
      at hAt11
    have h11 : density.firstQuadratic 1 1 = 0 := by
      simp [realCovector, hLinear, hValueSquare] at hAt11
      linarith
    have hAt12 := congrArg
      (fun covector : ContinuousLinearMap (RingHom.id Real) Real Real =>
        covector 1)
      (hEuler (programPT06ThroatSpatialJetCoordinateInjection second12 1))
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit]
      at hAt12
    have h12 : density.firstQuadratic 1 2 = 0 := by
      simp [realCovector, hLinear, hValueSquare] at hAt12
      linarith
    have hAt22 := congrArg
      (fun covector : ContinuousLinearMap (RingHom.id Real) Real Real =>
        covector 1)
      (hEuler (programPT06ThroatSpatialJetCoordinateInjection second22 1))
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_explicit]
      at hAt22
    have h22 : density.firstQuadratic 2 2 = 0 := by
      simp [realCovector, hLinear, hValueSquare] at hAt22
      linarith
    exact And.intro hLinear
      (And.intro hValueSquare
        (symmetricFirstQuadratic_eq_zero_of_upper density
          h00 h01 h02 h11 h12 h22))
  · rintro ⟨hLinear, hValueSquare, hQuadratic⟩ jet
    rw [programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_formula]
    simp [hLinear, hValueSquare, hQuadratic, realCovector]

/-- Affine current whose divergence is the full linear first-jet part. -/
def programPT06ScalarMultidirectionalQuadraticAffineCurrent
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D) :
    ProgramPT06AffineHorizontalCurrent4D Real where
  constant := fun _ => 0
  linear := fun direction =>
    scaleCovector (density.firstLinear direction) firstOrderValueProjection

/-- The directed quadratic current generating the value-first-jet monomial in
one of the three directions. -/
def programPT06ScalarMultidirectionalQuadraticNonlinearCurrent
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (direction : Fin 3) :
    ProgramPT06DirectedQuadraticValueCurrent4D Real where
  direction := direction
  left := realCovector (density.valueFirst direction / 2)
  right := ContinuousLinearMap.id Real Real

private theorem
    programPT06ScalarMultidirectionalQuadraticNonlinearDivergence_apply
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (direction : Fin 3) (jet : SecondJet) :
    programPT06DirectedQuadraticValueCurrentDivergence
        (programPT06ScalarMultidirectionalQuadraticNonlinearCurrent
          density direction) jet =
      density.valueFirst direction * secondOrderValueProjection jet *
        secondOrderFirstProjection direction jet := by
  rw [programPT06DirectedQuadraticValueCurrentDivergence_eq_density]
  change
    (density.valueFirst direction / 2 *
          secondOrderFirstProjection direction jet) *
        secondOrderValueProjection jet +
      (density.valueFirst direction / 2 *
          secondOrderValueProjection jet) *
        secondOrderFirstProjection direction jet = _
  ring

/-- Under the exact Euler-kernel conditions, the density is its constant plus
the three affine and three quadratic genuine horizontal divergences. -/
theorem programPT06ScalarMultidirectionalQuadratic_eq_constant_add_divergences
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (hLinear : density.valueLinear = 0)
    (hValueSquare : density.valueSquare = 0)
    (hQuadratic : forall first second : Fin 3,
      density.firstQuadratic first second = 0)
    (jet : SecondJet) :
    programPT06ScalarMultidirectionalQuadraticDensityEvaluation density jet =
      density.constant +
        programPT06AffineHorizontalCurrentDivergence
          (programPT06ScalarMultidirectionalQuadraticAffineCurrent density) jet +
        ∑ direction : Fin 3,
          programPT06DirectedQuadraticValueCurrentDivergence
            (programPT06ScalarMultidirectionalQuadraticNonlinearCurrent
              density direction) jet := by
  rw [programPT06AffineHorizontalCurrentDivergence_apply]
  simp_rw [programPT06ScalarMultidirectionalQuadraticNonlinearDivergence_apply]
  simp [programPT06ScalarMultidirectionalQuadraticDensityEvaluation,
    programPT06ScalarMultidirectionalQuadraticAffineCurrent,
    scaleCovector, realCovector, firstOrderValueProjection_totalDerivative,
    hLinear, hValueSquare, hQuadratic, Fin.sum_univ_succ]
  ring

/-- Exact divergence-form classification on the normalized scalar
multidirectional quadratic class. -/
theorem programPT06_scalarMultidirectionalQuadratic_euler_eq_zero_iff_divergence_form
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D) :
    (forall jet : FourthJet,
      programPT06SecondOrderLocalEuler
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        jet = 0) <->
      And (density.valueLinear = 0)
        (And (density.valueSquare = 0)
          (And
            (forall first second : Fin 3,
              density.firstQuadratic first second = 0)
            (forall jet : SecondJet,
              programPT06ScalarMultidirectionalQuadraticDensityEvaluation
                  density jet =
                density.constant +
                  programPT06AffineHorizontalCurrentDivergence
                    (programPT06ScalarMultidirectionalQuadraticAffineCurrent
                      density) jet +
                  ∑ direction : Fin 3,
                    programPT06DirectedQuadraticValueCurrentDivergence
                      (programPT06ScalarMultidirectionalQuadraticNonlinearCurrent
                        density direction) jet))) := by
  constructor
  · intro hEuler
    rcases
        (programPT06_scalarMultidirectionalQuadratic_euler_eq_zero_iff density).mp
          hEuler with
      ⟨hLinear, hValueSquare, hQuadratic⟩
    exact ⟨hLinear, hValueSquare, hQuadratic,
      programPT06ScalarMultidirectionalQuadratic_eq_constant_add_divergences
        density hLinear hValueSquare hQuadratic⟩
  · rintro ⟨hLinear, hValueSquare, hQuadratic, _hDivergence⟩
    exact
      (programPT06_scalarMultidirectionalQuadratic_euler_eq_zero_iff density).mpr
        ⟨hLinear, hValueSquare, hQuadratic⟩

