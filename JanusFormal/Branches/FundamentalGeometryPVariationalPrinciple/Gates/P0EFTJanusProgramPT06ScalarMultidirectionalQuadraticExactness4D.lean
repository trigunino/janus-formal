import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPT06ScalarDirectedQuadraticExactness4D

/-!
# Exact scalar quadratic subclass in all three spatial directions

This gate extends the directed scalar classification to autonomous first-order
quadratic densities using all three first-jet coordinates.  The coefficient
`firstQuadratic` is an honestly symmetric three-by-three matrix.  The
normalization uses one half on diagonal terms and one copy of each upper
off-diagonal term, equivalently one half of the full ordered matrix sum.

The genuine Gate880 Euler expression is computed exactly.  Its kernel on this
class consists precisely of constants plus divergences generated by the three
linear first-jet coefficients and the three value-first-jet coefficients.

This remains a scalar, autonomous, first-order quadratic classification.  It
does not include several field components, explicit base dependence,
second-jet densities, or the full T02 degree-four carrier.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPT06ScalarMultidirectionalQuadraticExactness4D

set_option autoImplicit false
noncomputable section

open scoped BigOperators
open P0EFTJanusProgramPT06ThroatSpatialFinsuppJetTower4D
open P0EFTJanusProgramPT06LocalFunctionTotalDerivative4D
open P0EFTJanusProgramPT06SecondOrderLocalEuler4D
open P0EFTJanusProgramPT06HorizontalDivergenceEulerSoundness4D
open P0EFTJanusProgramPT06DirectedQuadraticValueCurrent4D

attribute [local instance 2000]
  NormedAddCommGroup.toAddCommGroup NormedSpace.toModule
  PseudoMetricSpace.toUniformSpace UniformSpace.toTopologicalSpace

private abbrev FirstJet := ThroatSpatialMultiindexJet1 Real
private abbrev SecondJet := ThroatSpatialMultiindexJet2 Real
private abbrev ThirdJet := ThroatSpatialMultiindexJet3 Real
private abbrev FourthJet := ThroatSpatialMultiindexJet4 Real

/-- Coefficients of the normalized scalar quadratic density in three spatial
directions. -/
structure ProgramPT06ScalarMultidirectionalQuadraticDensity4D where
  constant : Real
  valueLinear : Real
  firstLinear : Fin 3 -> Real
  valueSquare : Real
  valueFirst : Fin 3 -> Real
  firstQuadratic : Fin 3 -> Fin 3 -> Real
  firstQuadratic_symm : forall first second,
    firstQuadratic first second = firstQuadratic second first

private def firstOrderValueProjection :
    ContinuousLinearMap (RingHom.id Real) FirstJet Real :=
  ContinuousLinearMap.proj programPT06FirstOrderZeroMultiIndex

private def secondOrderValueProjection :
    ContinuousLinearMap (RingHom.id Real) SecondJet Real :=
  ContinuousLinearMap.proj programPT06SecondOrderZeroMultiIndex

private def secondOrderFirstProjection (direction : Fin 3) :
    ContinuousLinearMap (RingHom.id Real) SecondJet Real :=
  ContinuousLinearMap.proj
    (programPT06SecondOrderFirstMultiIndex direction)

private def thirdOrderSecondMultiIndex (first second : Fin 3) :
    ThroatSpatialTruncatedIndex 3 :=
  { val :=
      throatSpatialCoordinateMultiIndex first +
        throatSpatialCoordinateMultiIndex second
    property := by
      rw [throatSpatialMultiIndexOrder_add]
      simp }

private def fourthOrderZeroMultiIndex : ThroatSpatialTruncatedIndex 4 :=
  { val := 0, property := by simp }

private def fourthOrderFirstMultiIndex (direction : Fin 3) :
    ThroatSpatialTruncatedIndex 4 :=
  { val := throatSpatialCoordinateMultiIndex direction
    property := by simp }

private def fourthOrderSecondMultiIndex (first second : Fin 3) :
    ThroatSpatialTruncatedIndex 4 :=
  { val :=
      throatSpatialCoordinateMultiIndex first +
        throatSpatialCoordinateMultiIndex second
    property := by
      rw [throatSpatialMultiIndexOrder_add]
      simp }

private def realCovector (coefficient : Real) :
    ContinuousLinearMap (RingHom.id Real) Real Real :=
  ContinuousLinearMap.lsmul Real Real coefficient

private def scaleCovector
    {Domain : Type} [SeminormedAddCommGroup Domain] [NormedSpace Real Domain]
    (coefficient : Real)
    (covector : ContinuousLinearMap (RingHom.id Real) Domain Real) :
    ContinuousLinearMap (RingHom.id Real) Domain Real :=
  (realCovector coefficient).comp covector

private theorem secondOrderFirstMultiIndex_ne_zero (direction : Fin 3) :
    programPT06SecondOrderFirstMultiIndex direction ≠
      programPT06SecondOrderZeroMultiIndex := by
  intro hIndex
  have hOrder := congrArg
    (fun index : ThroatSpatialTruncatedIndex 2 =>
      throatSpatialMultiIndexOrder index.val) hIndex
  simp [programPT06SecondOrderFirstMultiIndex,
    programPT06SecondOrderZeroMultiIndex] at hOrder

private theorem throatSpatialCoordinateMultiIndex_injective :
    Function.Injective throatSpatialCoordinateMultiIndex := by
  intro first second hIndex
  by_contra hDirections
  have hCoordinate := congrArg
    (fun index : ThroatSpatialMultiIndex => index first) hIndex
  simp [throatSpatialCoordinateMultiIndex, hDirections] at hCoordinate

private theorem secondOrderFirstMultiIndex_injective :
    Function.Injective programPT06SecondOrderFirstMultiIndex := by
  intro first second hIndex
  apply throatSpatialCoordinateMultiIndex_injective
  exact congrArg Subtype.val hIndex

private theorem secondOrderSecondMultiIndex_ne_zero
    (first second : Fin 3) :
    programPT06SecondOrderSecondMultiIndex first second ≠
      programPT06SecondOrderZeroMultiIndex := by
  intro hIndex
  have hOrder := congrArg
    (fun index : ThroatSpatialTruncatedIndex 2 =>
      throatSpatialMultiIndexOrder index.val) hIndex
  simp [programPT06SecondOrderSecondMultiIndex,
    programPT06SecondOrderZeroMultiIndex,
    throatSpatialMultiIndexOrder_add] at hOrder

private theorem secondOrderSecondMultiIndex_ne_first
    (first second direction : Fin 3) :
    programPT06SecondOrderSecondMultiIndex first second ≠
      programPT06SecondOrderFirstMultiIndex direction := by
  intro hIndex
  have hOrder := congrArg
    (fun index : ThroatSpatialTruncatedIndex 2 =>
      throatSpatialMultiIndexOrder index.val) hIndex
  simp [programPT06SecondOrderSecondMultiIndex,
    programPT06SecondOrderFirstMultiIndex,
    throatSpatialMultiIndexOrder_add] at hOrder

private theorem fourthOrderSecondMultiIndex_comm (first second : Fin 3) :
    fourthOrderSecondMultiIndex first second =
      fourthOrderSecondMultiIndex second first := by
  apply Subtype.ext
  exact add_comm _ _

private theorem fourthOrderSecondMultiIndex_ne_zero
    (first second : Fin 3) :
    fourthOrderSecondMultiIndex first second ≠ fourthOrderZeroMultiIndex := by
  intro hIndex
  have hOrder := congrArg
    (fun index : ThroatSpatialTruncatedIndex 4 =>
      throatSpatialMultiIndexOrder index.val) hIndex
  simp [fourthOrderSecondMultiIndex, fourthOrderZeroMultiIndex,
    throatSpatialMultiIndexOrder_add] at hOrder

@[simp] private theorem secondOrderValueProjection_truncate_fourth
    (jet : FourthJet) :
    secondOrderValueProjection
        (truncateThroatSpatialMultiindexJet (by omega : 2 <= 4) jet) =
      jet fourthOrderZeroMultiIndex := by
  change jet _ = jet _
  apply congrArg jet
  apply Subtype.ext
  rfl

@[simp] private theorem secondOrderFirstProjection_truncate_fourth
    (direction : Fin 3) (jet : FourthJet) :
    secondOrderFirstProjection direction
        (truncateThroatSpatialMultiindexJet (by omega : 2 <= 4) jet) =
      jet (fourthOrderFirstMultiIndex direction) := by
  change jet _ = jet _
  apply congrArg jet
  apply Subtype.ext
  rfl

@[simp] private theorem
    secondOrderValueProjection_totalDerivative_truncate_fourth
    (direction : Fin 3) (jet : FourthJet) :
    secondOrderValueProjection
        (throatSpatialTotalDerivative direction
          (truncateThroatSpatialMultiindexJet (by omega : 3 <= 4) jet)) =
      jet (fourthOrderFirstMultiIndex direction) := by
  change jet _ = jet _
  apply congrArg jet
  apply Subtype.ext
  simp [programPT06SecondOrderZeroMultiIndex,
    fourthOrderFirstMultiIndex]

@[simp] private theorem
    secondOrderFirstProjection_totalDerivative_truncate_fourth
    (first second : Fin 3) (jet : FourthJet) :
    secondOrderFirstProjection second
        (throatSpatialTotalDerivative first
          (truncateThroatSpatialMultiindexJet (by omega : 3 <= 4) jet)) =
      jet (fourthOrderSecondMultiIndex first second) := by
  change jet _ = jet _
  apply congrArg jet
  apply Subtype.ext
  simp [programPT06SecondOrderFirstMultiIndex,
    fourthOrderSecondMultiIndex, add_comm]

@[simp] private theorem firstOrderValueProjection_totalDerivative
    (direction : Fin 3) (jet : SecondJet) :
    firstOrderValueProjection
        (throatSpatialTotalDerivative direction jet) =
      secondOrderFirstProjection direction jet := by
  change jet _ = jet _
  apply congrArg jet
  apply Subtype.ext
  simp [programPT06FirstOrderZeroMultiIndex,
    programPT06SecondOrderFirstMultiIndex]

/-- The coefficient of the first vertical partial in one direction. -/
def programPT06ScalarMultidirectionalQuadraticFirstCoefficient
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (direction : Fin 3) (jet : SecondJet) : Real :=
  density.firstLinear direction +
    density.valueFirst direction * secondOrderValueProjection jet +
    ∑ second : Fin 3,
      density.firstQuadratic direction second *
        secondOrderFirstProjection second jet

private def programPT06ScalarMultidirectionalQuadraticZeroCoefficient
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (jet : SecondJet) : Real :=
  density.valueLinear +
    2 * density.valueSquare * secondOrderValueProjection jet +
    ∑ direction : Fin 3,
      density.valueFirst direction *
        secondOrderFirstProjection direction jet

/-- Evaluation of the normalized multidirectional quadratic density. -/
def programPT06ScalarMultidirectionalQuadraticDensityEvaluation
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D) :
    SecondJet -> Real :=
  fun jet =>
    let value := secondOrderValueProjection jet
    let firstZero := secondOrderFirstProjection (0 : Fin 3) jet
    let firstOne := secondOrderFirstProjection (1 : Fin 3) jet
    let firstTwo := secondOrderFirstProjection (2 : Fin 3) jet
    density.constant + density.valueLinear * value +
      density.valueSquare * value ^ 2 +
      density.firstLinear 0 * firstZero +
      density.firstLinear 1 * firstOne +
      density.firstLinear 2 * firstTwo +
      density.valueFirst 0 * value * firstZero +
      density.valueFirst 1 * value * firstOne +
      density.valueFirst 2 * value * firstTwo +
      density.firstQuadratic 0 0 / 2 * firstZero ^ 2 +
      density.firstQuadratic 1 1 / 2 * firstOne ^ 2 +
      density.firstQuadratic 2 2 / 2 * firstTwo ^ 2 +
      density.firstQuadratic 0 1 * firstZero * firstOne +
      density.firstQuadratic 0 2 * firstZero * firstTwo +
      density.firstQuadratic 1 2 * firstOne * firstTwo

private def programPT06ScalarMultidirectionalQuadraticDensityDerivative
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (jet : SecondJet) :
    ContinuousLinearMap (RingHom.id Real) SecondJet Real :=
  scaleCovector
      (programPT06ScalarMultidirectionalQuadraticZeroCoefficient density jet)
      secondOrderValueProjection +
    scaleCovector
      (programPT06ScalarMultidirectionalQuadraticFirstCoefficient density 0 jet)
      (secondOrderFirstProjection 0) +
    scaleCovector
      (programPT06ScalarMultidirectionalQuadraticFirstCoefficient density 1 jet)
      (secondOrderFirstProjection 1) +
    scaleCovector
      (programPT06ScalarMultidirectionalQuadraticFirstCoefficient density 2 jet)
      (secondOrderFirstProjection 2)

theorem programPT06ScalarMultidirectionalQuadraticDensityEvaluation_hasFDerivAt
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (jet : SecondJet) :
    HasFDerivAt
      (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
      (programPT06ScalarMultidirectionalQuadraticDensityDerivative density jet)
      jet := by
  let value := secondOrderValueProjection
  let firstZero := secondOrderFirstProjection (0 : Fin 3)
  let firstOne := secondOrderFirstProjection (1 : Fin 3)
  let firstTwo := secondOrderFirstProjection (2 : Fin 3)
  have hValue := value.hasFDerivAt (x := jet)
  have hZero := firstZero.hasFDerivAt (x := jet)
  have hOne := firstOne.hasFDerivAt (x := jet)
  have hTwo := firstTwo.hasFDerivAt (x := jet)
  have h0 := (hasFDerivAt_const (x := jet) (c := density.constant)).add
    (hValue.const_mul density.valueLinear)
  have h1 := h0.add ((hValue.pow 2).const_mul density.valueSquare)
  have h2 := h1.add (hZero.const_mul (density.firstLinear 0))
  have h3 := h2.add (hOne.const_mul (density.firstLinear 1))
  have h4 := h3.add (hTwo.const_mul (density.firstLinear 2))
  have h5 := h4.add ((hValue.mul hZero).const_mul (density.valueFirst 0))
  have h6 := h5.add ((hValue.mul hOne).const_mul (density.valueFirst 1))
  have h7 := h6.add ((hValue.mul hTwo).const_mul (density.valueFirst 2))
  have h8 := h7.add
    ((hZero.pow 2).const_mul (density.firstQuadratic 0 0 / 2))
  have h9 := h8.add
    ((hOne.pow 2).const_mul (density.firstQuadratic 1 1 / 2))
  have h10 := h9.add
    ((hTwo.pow 2).const_mul (density.firstQuadratic 2 2 / 2))
  have h11 := h10.add
    ((hZero.mul hOne).const_mul (density.firstQuadratic 0 1))
  have h12 := h11.add
    ((hZero.mul hTwo).const_mul (density.firstQuadratic 0 2))
  have hRaw := h12.add
    ((hOne.mul hTwo).const_mul (density.firstQuadratic 1 2))
  convert hRaw using 1
  · funext candidate
    dsimp [programPT06ScalarMultidirectionalQuadraticDensityEvaluation,
      value, firstZero, firstOne, firstTwo]
    ring
  · ext variation
    simp [programPT06ScalarMultidirectionalQuadraticDensityDerivative,
      programPT06ScalarMultidirectionalQuadraticZeroCoefficient,
      programPT06ScalarMultidirectionalQuadraticFirstCoefficient,
      scaleCovector, realCovector, value, firstZero, firstOne, firstTwo,
      Fin.sum_univ_succ]
    rw [density.firstQuadratic_symm 1 0,
      density.firstQuadratic_symm 2 0,
      density.firstQuadratic_symm 2 1]
    ring

private theorem
    programPT06ScalarMultidirectionalQuadraticVerticalPartialZero_apply
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (jet : SecondJet) (variation : Real) :
    programPT06SecondOrderLocalVerticalPartialZero
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        jet variation =
      programPT06ScalarMultidirectionalQuadraticZeroCoefficient density jet *
        variation := by
  change programPT06ThroatSpatialVerticalPartialDerivative
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density) jet
      programPT06SecondOrderZeroMultiIndex variation = _
  rw [programPT06ThroatSpatialVerticalPartialDerivative_eq_of_hasFDerivAt
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density) jet
    programPT06SecondOrderZeroMultiIndex
    (programPT06ScalarMultidirectionalQuadraticDensityDerivative density jet)
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation_hasFDerivAt
      density jet)]
  simp [programPT06ScalarMultidirectionalQuadraticDensityDerivative,
    scaleCovector, realCovector, secondOrderValueProjection,
    secondOrderFirstProjection, secondOrderFirstMultiIndex_ne_zero]

private theorem
    programPT06ScalarMultidirectionalQuadraticVerticalPartialOne_apply
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (direction : Fin 3) (jet : SecondJet) (variation : Real) :
    programPT06SecondOrderLocalVerticalPartialOne
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        direction jet variation =
      programPT06ScalarMultidirectionalQuadraticFirstCoefficient
        density direction jet * variation := by
  change programPT06ThroatSpatialVerticalPartialDerivative
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density) jet
      (programPT06SecondOrderFirstMultiIndex direction) variation = _
  rw [programPT06ThroatSpatialVerticalPartialDerivative_eq_of_hasFDerivAt
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density) jet
    (programPT06SecondOrderFirstMultiIndex direction)
    (programPT06ScalarMultidirectionalQuadraticDensityDerivative density jet)
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation_hasFDerivAt
      density jet)]
  fin_cases direction <;>
    simp [programPT06ScalarMultidirectionalQuadraticDensityDerivative,
      programPT06ScalarMultidirectionalQuadraticFirstCoefficient,
      scaleCovector, realCovector, secondOrderValueProjection,
      secondOrderFirstProjection,
      Ne.symm (secondOrderFirstMultiIndex_ne_zero (0 : Fin 3)),
      Ne.symm (secondOrderFirstMultiIndex_ne_zero (1 : Fin 3)),
      Ne.symm (secondOrderFirstMultiIndex_ne_zero (2 : Fin 3)),
      secondOrderFirstMultiIndex_injective.eq_iff,
      Fin.sum_univ_succ, density.firstQuadratic_symm 1 0,
      density.firstQuadratic_symm 2 0,
      density.firstQuadratic_symm 2 1] <;>
    ring

private theorem
    programPT06ScalarMultidirectionalQuadraticVerticalPartialTwo
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (first second : Fin 3) :
    programPT06SecondOrderLocalVerticalPartialTwo
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        first second = 0 := by
  funext jet
  apply ContinuousLinearMap.ext
  intro variation
  change programPT06ThroatSpatialVerticalPartialDerivative
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density) jet
      (programPT06SecondOrderSecondMultiIndex first second) variation = _
  rw [programPT06ThroatSpatialVerticalPartialDerivative_eq_of_hasFDerivAt
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density) jet
    (programPT06SecondOrderSecondMultiIndex first second)
    (programPT06ScalarMultidirectionalQuadraticDensityDerivative density jet)
    (programPT06ScalarMultidirectionalQuadraticDensityEvaluation_hasFDerivAt
      density jet)]
  simp [programPT06ScalarMultidirectionalQuadraticDensityDerivative,
    scaleCovector, realCovector, secondOrderValueProjection,
    secondOrderFirstProjection,
    Ne.symm (secondOrderSecondMultiIndex_ne_zero first second),
    Ne.symm
      (secondOrderSecondMultiIndex_ne_first first second (0 : Fin 3)),
    Ne.symm
      (secondOrderSecondMultiIndex_ne_first first second (1 : Fin 3)),
    Ne.symm
      (secondOrderSecondMultiIndex_ne_first first second (2 : Fin 3))]

private def programPT06ScalarMultidirectionalQuadraticFirstPartialLinearMap
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (direction : Fin 3) :
    ContinuousLinearMap (RingHom.id Real) SecondJet
      (ContinuousLinearMap (RingHom.id Real) Real Real) :=
  (ContinuousLinearMap.lsmul Real Real).comp
    (scaleCovector (density.valueFirst direction) secondOrderValueProjection +
      ∑ second : Fin 3,
        scaleCovector (density.firstQuadratic direction second)
          (secondOrderFirstProjection second))

private theorem
    programPT06ScalarMultidirectionalQuadraticFirstPartial_hasFDerivAt
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (direction : Fin 3) (jet : SecondJet) :
    HasFDerivAt
      (fun candidate : SecondJet =>
        realCovector
          (programPT06ScalarMultidirectionalQuadraticFirstCoefficient
            density direction candidate))
      (programPT06ScalarMultidirectionalQuadraticFirstPartialLinearMap
        density direction) jet := by
  have hAffine : HasFDerivAt
      (fun candidate : SecondJet =>
        realCovector (density.firstLinear direction) +
          programPT06ScalarMultidirectionalQuadraticFirstPartialLinearMap
            density direction candidate)
      (programPT06ScalarMultidirectionalQuadraticFirstPartialLinearMap
        density direction) jet := by
    exact
      (hasFDerivAt_const_add_iff
        (realCovector (density.firstLinear direction))).2
        (programPT06ScalarMultidirectionalQuadraticFirstPartialLinearMap
          density direction).hasFDerivAt
  convert hAffine using 1
  funext candidate
  apply ContinuousLinearMap.ext
  intro variation
  simp [programPT06ScalarMultidirectionalQuadraticFirstPartialLinearMap,
    programPT06ScalarMultidirectionalQuadraticFirstCoefficient,
    scaleCovector, realCovector]
  ring



private theorem programPT06ScalarMultidirectionalQuadraticFirstEulerTerm_apply
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (direction : Fin 3) (jet : ThirdJet) (variation : Real) :
    programPT06SecondOrderLocalEulerFirstTotalTerm
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        direction jet variation =
      (density.valueFirst direction *
          secondOrderValueProjection
            (throatSpatialTotalDerivative direction jet) +
        ∑ second : Fin 3,
          density.firstQuadratic direction second *
            secondOrderFirstProjection second
              (throatSpatialTotalDerivative direction jet)) * variation := by
  rw [programPT06SecondOrderLocalEulerFirstTotalTerm]
  have hPartial :
      programPT06SecondOrderLocalVerticalPartialOne
          (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
          direction =
        fun candidate : SecondJet =>
          realCovector
            (programPT06ScalarMultidirectionalQuadraticFirstCoefficient
              density direction candidate) := by
    funext candidate
    apply ContinuousLinearMap.ext
    intro candidateVariation
    rw [programPT06ScalarMultidirectionalQuadraticVerticalPartialOne_apply]
    simp [realCovector]
  rw [hPartial]
  rw [programPT06ThroatSpatialLocalFunctionTotalDerivative_eq_of_hasFDerivAt
    direction _ jet
    (programPT06ScalarMultidirectionalQuadraticFirstPartialLinearMap
      density direction)
    (programPT06ScalarMultidirectionalQuadraticFirstPartial_hasFDerivAt
      density direction
      (truncateThroatSpatialMultiindexJet (by omega : 2 <= 3) jet))]
  simp [programPT06ScalarMultidirectionalQuadraticFirstPartialLinearMap,
    scaleCovector, realCovector]
  rw [add_mul, Finset.sum_mul]

private theorem programPT06ScalarMultidirectionalQuadraticSecondEulerTerm
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (first second : Fin 3) (jet : FourthJet) :
    programPT06SecondOrderLocalEulerSecondTotalTerm
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        first second jet = 0 := by
  rw [programPT06SecondOrderLocalEulerSecondTotalTerm,
    programPT06ScalarMultidirectionalQuadraticVerticalPartialTwo]
  simp

/-- Exact Gate880 Euler formula for the scalar quadratic family in all three
spatial directions. -/
theorem programPT06SecondOrderLocalEuler_scalarMultidirectionalQuadratic_formula
    (density : ProgramPT06ScalarMultidirectionalQuadraticDensity4D)
    (jet : FourthJet) :
    programPT06SecondOrderLocalEuler
        (programPT06ScalarMultidirectionalQuadraticDensityEvaluation density)
        jet =
      realCovector
        (density.valueLinear +
          2 * density.valueSquare * jet fourthOrderZeroMultiIndex -
          ∑ first : Fin 3,
            ∑ second : Fin 3,
              density.firstQuadratic first second *
                jet (fourthOrderSecondMultiIndex first second)) := by
  apply ContinuousLinearMap.ext
  intro variation
  rw [programPT06SecondOrderLocalEuler_apply,
    programPT06ScalarMultidirectionalQuadraticVerticalPartialZero_apply]
  have hFirst :
      Finset.univ.sum
          (fun direction : Fin 3 =>
            programPT06SecondOrderLocalEulerFirstTotalTerm
              (programPT06ScalarMultidirectionalQuadraticDensityEvaluation
                density)
              direction
              (truncateThroatSpatialMultiindexJet (by omega : 3 <= 4) jet)
              variation) =
        ((∑ direction : Fin 3,
            density.valueFirst direction *
              jet (fourthOrderFirstMultiIndex direction)) +
          ∑ first : Fin 3,
            ∑ second : Fin 3,
              density.firstQuadratic first second *
                jet (fourthOrderSecondMultiIndex first second)) * variation := by
    calc
      Finset.univ.sum
          (fun direction : Fin 3 =>
            programPT06SecondOrderLocalEulerFirstTotalTerm
              (programPT06ScalarMultidirectionalQuadraticDensityEvaluation
                density)
              direction
              (truncateThroatSpatialMultiindexJet (by omega : 3 <= 4) jet)
              variation) =
          Finset.univ.sum
            (fun direction : Fin 3 =>
              (density.valueFirst direction *
                  jet (fourthOrderFirstMultiIndex direction) +
                ∑ second : Fin 3,
                  density.firstQuadratic direction second *
                    jet (fourthOrderSecondMultiIndex direction second)) *
                variation) := by
            apply Finset.sum_congr rfl
            intro direction _
            rw [programPT06ScalarMultidirectionalQuadraticFirstEulerTerm_apply]
            simp
      _ =
          ((∑ direction : Fin 3,
              density.valueFirst direction *
                jet (fourthOrderFirstMultiIndex direction)) +
            ∑ first : Fin 3,
              ∑ second : Fin 3,
                density.firstQuadratic first second *
                  jet (fourthOrderSecondMultiIndex first second)) *
            variation := by
              rw [← Finset.sum_mul, Finset.sum_add_distrib]
  rw [hFirst]
  simp [programPT06ScalarMultidirectionalQuadraticZeroCoefficient,
    secondOrderFirstProjection_truncate_fourth,
    programPT06ScalarMultidirectionalQuadraticSecondEulerTerm,
    realCovector]
  simp_rw [add_mul, Finset.sum_mul]
  ring

private abbrev second00 : ThroatSpatialTruncatedIndex 4 :=
  fourthOrderSecondMultiIndex 0 0

private abbrev second01 : ThroatSpatialTruncatedIndex 4 :=
  fourthOrderSecondMultiIndex 0 1

private abbrev second02 : ThroatSpatialTruncatedIndex 4 :=
  fourthOrderSecondMultiIndex 0 2

private abbrev second11 : ThroatSpatialTruncatedIndex 4 :=
  fourthOrderSecondMultiIndex 1 1

private abbrev second12 : ThroatSpatialTruncatedIndex 4 :=
  fourthOrderSecondMultiIndex 1 2

private abbrev second22 : ThroatSpatialTruncatedIndex 4 :=
  fourthOrderSecondMultiIndex 2 2

private theorem fourthOrderSecondMultiIndex_ne_of_coordinate
    (first second otherFirst otherSecond coordinate : Fin 3)
    (hCoordinate :
      (throatSpatialCoordinateMultiIndex first +
          throatSpatialCoordinateMultiIndex second) coordinate ≠
        (throatSpatialCoordinateMultiIndex otherFirst +
          throatSpatialCoordinateMultiIndex otherSecond) coordinate) :
    fourthOrderSecondMultiIndex first second ≠
      fourthOrderSecondMultiIndex otherFirst otherSecond := by
  intro hIndex
  apply hCoordinate
  exact congrArg
    (fun index : ThroatSpatialTruncatedIndex 4 => index.val coordinate) hIndex

@[simp] private theorem second00_ne_second01 : second00 ≠ second01 := by
  apply fourthOrderSecondMultiIndex_ne_of_coordinate 0 0 0 1 1
  simp [throatSpatialCoordinateMultiIndex]

@[simp] private theorem second00_ne_second02 : second00 ≠ second02 := by
