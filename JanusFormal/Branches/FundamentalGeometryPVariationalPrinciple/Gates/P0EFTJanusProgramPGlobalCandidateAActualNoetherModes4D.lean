/-- Honest augmented Candidate-A action whose Hessian is represented by the
actual H12 operator. -/
def globalCandidateAActualNoetherAction
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction) :=
  globalCandidateACommonAugmentedAction period hPeriod configuration data
    analysis chart sameAction physical

/-- Candidate-A Noether germ at the zero configuration of the completed
quadratic action. -/
def GlobalCandidateAActualNoetherModeAt
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction)
    (mode : CandidateANoetherHilbert period hPeriod configuration data analysis) :
    Prop :=
  NoetherModeGermAt
    (globalCandidateAActualNoetherAction period hPeriod configuration data
      analysis chart sameAction physical)
    0 mode

/-- The second derivative of the honest quadratic action is exactly the common
augmented Candidate-A Hessian. -/
theorem globalCandidateAActualNoetherHessian_eq
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction) :
    noetherHessianForm
        (globalCandidateAActualNoetherAction period hPeriod configuration data
          analysis chart sameAction physical)
        0 =
      globalCandidateACommonAugmentedHessian period hPeriod configuration data
        analysis chart sameAction physical := by
  simpa [noetherHessianForm, actionGradient,
    globalCandidateAActualNoetherAction] using
    globalCandidateACommonAugmentedAction_second_fderiv period hPeriod
      configuration data analysis chart sameAction physical
      (0 : CandidateANoetherHilbert period hPeriod configuration data analysis)

/-- A Noether germ kills the actual augmented Hessian in its second slot. -/
theorem globalCandidateAActualNoetherMode_hessian_right_zero
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction)
    (mode : CandidateANoetherHilbert period hPeriod configuration data analysis)
    (hNoether : GlobalCandidateAActualNoetherModeAt period hPeriod configuration
      data analysis chart sameAction physical mode)
    (direction : CandidateANoetherHilbert period hPeriod configuration data
      analysis) :
    globalCandidateACommonAugmentedHessian period hPeriod configuration data
        analysis chart sameAction physical direction mode = 0 := by
  have hGeneric := noetherMode_hessian_right_zero
    (globalCandidateAActualNoetherAction period hPeriod configuration data
      analysis chart sameAction physical)
    (0 : CandidateANoetherHilbert period hPeriod configuration data analysis)
    mode
    (globalCandidateACommonAugmentedAction_contDiff_two period hPeriod
      configuration data analysis chart sameAction physical).contDiffAt
    hNoether direction
  rw [globalCandidateAActualNoetherHessian_eq period hPeriod configuration data
    analysis chart sameAction physical] at hGeneric
  exact hGeneric

/-- Symmetry of the Candidate-A Hessian gives the corresponding first-slot
vanishing. -/
theorem globalCandidateAActualNoetherMode_hessian_left_zero
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction)
    (mode : CandidateANoetherHilbert period hPeriod configuration data analysis)
    (hNoether : GlobalCandidateAActualNoetherModeAt period hPeriod configuration
      data analysis chart sameAction physical mode)
    (direction : CandidateANoetherHilbert period hPeriod configuration data
      analysis) :
    globalCandidateACommonAugmentedHessian period hPeriod configuration data
        analysis chart sameAction physical mode direction = 0 := by
  rw [globalCandidateACommonAugmentedHessian_comm period hPeriod configuration
    data analysis chart sameAction physical mode direction]
  exact globalCandidateAActualNoetherMode_hessian_right_zero period hPeriod
    configuration data analysis chart sameAction physical mode hNoether direction

/-- A Candidate-A Noether direction is an actual zero mode of the displayed
augmented H12 operator. -/
theorem globalCandidateAActualNoetherMode_operator_zero
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction)
    (mode : CandidateANoetherHilbert period hPeriod configuration data analysis)
    (hNoether : GlobalCandidateAActualNoetherModeAt period hPeriod configuration
      data analysis chart sameAction physical mode) :
    globalCandidateAActualKernelOperator period hPeriod configuration data
      analysis chart sameAction physical mode = 0 := by
  let operator := globalCandidateAActualKernelOperator period hPeriod
    configuration data analysis chart sameAction physical
  have hPairing :
      inner Real (operator mode) (operator mode) =
        globalCandidateACommonAugmentedHessian period hPeriod configuration data
          analysis chart sameAction physical mode (operator mode) := by
    exact globalCandidateACommonAugmentedRieszOperator_pairing period hPeriod
      configuration data analysis chart sameAction physical mode (operator mode)
  have hFormZero :
      globalCandidateACommonAugmentedHessian period hPeriod configuration data
          analysis chart sameAction physical mode (operator mode) = 0 :=
    globalCandidateAActualNoetherMode_hessian_left_zero period hPeriod
      configuration data analysis chart sameAction physical mode hNoether
      (operator mode)
  have hInner : inner Real (operator mode) (operator mode) = 0 :=
    hPairing.trans hFormZero
  have hNorm : ‖operator mode‖ = 0 := by
    rw [← sq_eq_zero_iff, ← real_inner_self_eq_norm_sq]
    exact hInner
  exact norm_eq_zero.mp hNorm

/-- Finite collection of Candidate-A symmetry directions specified entirely at
the action level. -/
structure GlobalCandidateAActualNoetherModeFamily4D
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    (configuration : GlobalGaugeFixedFieldConfiguration period hPeriod)
    (data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace)
    (analysis : GlobalAnalysisData period hPeriod configuration.physical)
    (chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure)
    (sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart)
    (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction)
    (ZeroMode : Type*) [Fintype ZeroMode] where
  vector : ZeroMode →
    CandidateANoetherHilbert period hPeriod configuration data analysis
  noether : ∀ mode,
    GlobalCandidateAActualNoetherModeAt period hPeriod configuration data
      analysis chart sameAction physical (vector mode)

/-- Every member of a finite Noether family is genuinely annihilated by the
actual Candidate-A Hessian operator. -/
theorem GlobalCandidateAActualNoetherModeFamily4D.vector_mem_kernel
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure}
    {sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart}
    {physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction}
    {ZeroMode : Type*} [Fintype ZeroMode]
    (modes : GlobalCandidateAActualNoetherModeFamily4D period hPeriod
      configuration data analysis chart sameAction physical ZeroMode)
    (mode : ZeroMode) :
    globalCandidateAActualKernelOperator period hPeriod configuration data
      analysis chart sameAction physical (modes.vector mode) = 0 :=
  globalCandidateAActualNoetherMode_operator_zero period hPeriod configuration
    data analysis chart sameAction physical (modes.vector mode)
      (modes.noether mode)

/-- Public finite-family Noether checkpoint. -/
theorem global_candidateA_actual_noether_modes_gate
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {chart : GlobalCandidateALocalVariationalChart period hPeriod couplings
      NonNullFace NullFace measure}
    {sameAction : ProgramPGlobalMinimalPhysicalLocalMatterLLSameActionBridge4D
      period hPeriod configuration data analysis chart}
    {physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D period
      hPeriod configuration data analysis chart sameAction}
    (ZeroMode : Type*) [Fintype ZeroMode]
    (modes : GlobalCandidateAActualNoetherModeFamily4D period hPeriod
      configuration data analysis chart sameAction physical ZeroMode) :
    ∀ mode,
      globalCandidateAActualKernelOperator period hPeriod configuration data
        analysis chart sameAction physical (modes.vector mode) = 0 :=
  modes.vector_mem_kernel period hPeriod

end
