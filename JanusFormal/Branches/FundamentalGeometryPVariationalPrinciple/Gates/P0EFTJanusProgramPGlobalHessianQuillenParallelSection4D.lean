import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPGlobalHessianQuillenMetricAnchor4D

/-!
# Parallel Quillen section generated by the global determinant anchor

The periodic determinant anchor is transported through the explicit flat
Quillen connection of the circle model.  The resulting section has constant
Hermitian norm and its endpoint mismatch is exactly the closed-loop unitary
holonomy already computed for that line.

This still does not identify the parameter of the full Janus Hessian family
with the circle holonomy parameter.  It constructs the unique parallel circle
section generated by the global basepoint determinant.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPGlobalHessianQuillenParallelSection4D

set_option autoImplicit false
set_option maxHeartbeats 9600000
set_option synthInstance.maxHeartbeats 4800000

noncomputable section

open Set Topology MeasureTheory
open scoped Manifold ContDiff InnerProductSpace ComplexConjugate
open P0EFTJanusCircleDiracHeatTraceCancellation
open P0EFTJanusCircleDeterminantLineFamily
open P0EFTJanusCircleQuillenMetricFlatConnection
open P0EFTJanusMappingTorusQuotient
open P0EFTJanusMappingTorusSmoothAtlasFrontier
open P0EFTJanusMappingTorusSmoothQuotientManifold
open P0EFTJanusProgramPGlobalFieldSpace4D
open P0EFTJanusProgramPGlobalTypedNonminimalFieldSpace4D
open P0EFTJanusProgramPGlobalCovariantAction4D
open P0EFTJanusProgramPGlobalAnalysisDomain4D
open P0EFTJanusProgramPGlobalLocalVariationalChart4D
open P0EFTJanusProgramPGlobalCandidateAMatterLLSameActionClosure4D
open P0EFTJanusProgramPGlobalCandidateACommonAugmentedAnalyticDomain4D
open P0EFTJanusProgramPGlobalCandidateAMinimalPhysicalActionFamilyH10Reduction4D
open P0EFTJanusProgramPGlobalCandidateAMinimalPhysicalActionFamilyBoundaryProjection4D
open P0EFTJanusProgramPGlobalCandidateASevenPhysicalCanonicalAgreement4D
open P0EFTJanusProgramPGlobalCandidateAAugmentedOrthogonalCoerciveShift4D
open P0EFTJanusProgramPGlobalHessianDiracGreenBoundedClosure4D
open P0EFTJanusProgramPGlobalHessianConcreteAgreementClosure4D
open P0EFTJanusProgramPGlobalHessianFinitePartDeterminant4D
open P0EFTJanusProgramPGlobalHessianQuillenMetricAnchor4D
open P0EFTJanusProgramPRelativeDeterminantPhase4D

variable (period : Real) (hPeriod : period ≠ 0)

private abbrev EffectiveQuotient :=
  MappingTorus (reflectedSphereData period hPeriod)

local instance effectiveQuotientChartedSpace :
    ChartedSpace CoverModel (EffectiveQuotient period hPeriod) :=
  reflectedSphereQuotientChartedSpace period hPeriod

local instance effectiveQuotientIsManifold :
    IsManifold coverModelWithCorners ω (EffectiveQuotient period hPeriod) :=
  reflectedSphereQuotient_isManifold period hPeriod

local instance effectiveQuotientMeasurableSpace :
    MeasurableSpace (EffectiveQuotient period hPeriod) := borel _

local instance effectiveQuotientBorelSpace :
    BorelSpace (EffectiveQuotient period hPeriod) where
  measurable_eq := rfl

/-- Parallel-transported Fourier coordinate. -/
def globalCandidateAHessianQuillenParallelCoordinate
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {einsteinScale : Real}
    {hBoundaryTransverse : HasNoTangentialRadical period hPeriod
      data.plusGravity.metric.metric}
    {family : ProgramPGlobalMinimalPhysicalLocalActionFamilyH10ReducedData4D
      period hPeriod configuration data analysis
        (diracGreenClosureMatterRealization period hPeriod
          couplings.matterMassSquared) einsteinScale}
    {extensions : GlobalCandidateASevenPhysicalCanonicalContinuousAgreements4D
      period hPeriod configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)}
    {shift : GlobalCandidateAAugmentedOrthogonalCoerciveShift4D period hPeriod
      configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateAConcretePhysicalExtension period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family extensions)}
    (fold : Fold)
    (determinant : GlobalCandidateAHessianFinitePartDeterminantData4D period
      hPeriod configuration data analysis einsteinScale hBoundaryTransverse
        family extensions shift)
    (phase : RelativeDeterminantPhaseData)
    (holonomy : Real) : Complex :=
  circleQuillenParallelTransport fold 0 holonomy
    (globalCandidateAHessianComplexDeterminant determinant phase)

/-- Actual determinant-line section in the circle family. -/
def globalCandidateAHessianQuillenParallelSection
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {einsteinScale : Real}
    {hBoundaryTransverse : HasNoTangentialRadical period hPeriod
      data.plusGravity.metric.metric}
    {family : ProgramPGlobalMinimalPhysicalLocalActionFamilyH10ReducedData4D
      period hPeriod configuration data analysis
        (diracGreenClosureMatterRealization period hPeriod
          couplings.matterMassSquared) einsteinScale}
    {extensions : GlobalCandidateASevenPhysicalCanonicalContinuousAgreements4D
      period hPeriod configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)}
    {shift : GlobalCandidateAAugmentedOrthogonalCoerciveShift4D period hPeriod
      configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateAConcretePhysicalExtension period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family extensions)}
    (fold : Fold)
    (determinant : GlobalCandidateAHessianFinitePartDeterminantData4D period
      hPeriod configuration data analysis einsteinScale hBoundaryTransverse
        family extensions shift)
    (phase : RelativeDeterminantPhaseData)
    (twist : CircleTwist) : CircleDeterminantFiber fold twist :=
  circleDeterminantFrameEquiv fold twist
    (globalCandidateAHessianQuillenParallelCoordinate fold determinant phase
      twist.value)

/-- The section starts at the previously constructed periodic anchor. -/
@[simp]
theorem globalCandidateAHessianQuillenParallelSection_periodic
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {einsteinScale : Real}
    {hBoundaryTransverse : HasNoTangentialRadical period hPeriod
      data.plusGravity.metric.metric}
    {family : ProgramPGlobalMinimalPhysicalLocalActionFamilyH10ReducedData4D
      period hPeriod configuration data analysis
        (diracGreenClosureMatterRealization period hPeriod
          couplings.matterMassSquared) einsteinScale}
    {extensions : GlobalCandidateASevenPhysicalCanonicalContinuousAgreements4D
      period hPeriod configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)}
    {shift : GlobalCandidateAAugmentedOrthogonalCoerciveShift4D period hPeriod
      configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateAConcretePhysicalExtension period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family extensions)}
    (fold : Fold)
    (determinant : GlobalCandidateAHessianFinitePartDeterminantData4D period
      hPeriod configuration data analysis einsteinScale hBoundaryTransverse
        family extensions shift)
    (phase : RelativeDeterminantPhaseData) :
    globalCandidateAHessianQuillenParallelSection fold determinant phase
        periodicTwist =
      globalCandidateAHessianQuillenMetricAnchor fold determinant phase := by
  apply (circleDeterminantFrameEquiv fold periodicTwist).injective
  simp [globalCandidateAHessianQuillenParallelSection,
    globalCandidateAHessianQuillenParallelCoordinate,
    globalCandidateAHessianQuillenMetricAnchor]

/-- The transported section has the same Quillen norm at every twist. -/
theorem globalCandidateAHessianQuillenParallelSection_normSq
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {einsteinScale : Real}
    {hBoundaryTransverse : HasNoTangentialRadical period hPeriod
      data.plusGravity.metric.metric}
    {family : ProgramPGlobalMinimalPhysicalLocalActionFamilyH10ReducedData4D
      period hPeriod configuration data analysis
        (diracGreenClosureMatterRealization period hPeriod
          couplings.matterMassSquared) einsteinScale}
    {extensions : GlobalCandidateASevenPhysicalCanonicalContinuousAgreements4D
      period hPeriod configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)}
    {shift : GlobalCandidateAAugmentedOrthogonalCoerciveShift4D period hPeriod
      configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateAConcretePhysicalExtension period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family extensions)}
    (fold : Fold)
    (determinant : GlobalCandidateAHessianFinitePartDeterminantData4D period
      hPeriod configuration data analysis einsteinScale hBoundaryTransverse
        family extensions shift)
    (phase : RelativeDeterminantPhaseData)
    (twist : CircleTwist) :
    circleQuillenNormSq fold twist
        (globalCandidateAHessianQuillenParallelSection fold determinant phase
          twist) =
      (globalCandidateAHessianFinitePartDeterminant determinant) ^ 2 := by
  change circleQuillenCoordinateNormSq fold twist.value
      (globalCandidateAHessianQuillenParallelCoordinate fold determinant phase
        twist.value) = _
  rw [globalCandidateAHessianQuillenParallelCoordinate,
    circleQuillenParallelTransport_isometry]
  unfold circleQuillenCoordinateNormSq
  rw [circleQuillenMetricWeight_zero, one_mul]
  exact normSq_relativeHeatComplexDeterminant determinant.renormalization phase

/-- Endpoint transport followed by clutching produces precisely the unitary
closed-loop holonomy. -/
theorem globalCandidateAHessianQuillenParallelSection_endpoint_clutching
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {einsteinScale : Real}
    {hBoundaryTransverse : HasNoTangentialRadical period hPeriod
      data.plusGravity.metric.metric}
    {family : ProgramPGlobalMinimalPhysicalLocalActionFamilyH10ReducedData4D
      period hPeriod configuration data analysis
        (diracGreenClosureMatterRealization period hPeriod
          couplings.matterMassSquared) einsteinScale}
    {extensions : GlobalCandidateASevenPhysicalCanonicalContinuousAgreements4D
      period hPeriod configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)}
    {shift : GlobalCandidateAAugmentedOrthogonalCoerciveShift4D period hPeriod
      configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateAConcretePhysicalExtension period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family extensions)}
    (fold : Fold)
    (determinant : GlobalCandidateAHessianFinitePartDeterminantData4D period
      hPeriod configuration data analysis einsteinScale hBoundaryTransverse
        family extensions shift)
    (phase : RelativeDeterminantPhaseData) :
    circleLargeGaugeDeterminantTransition fold
        (globalCandidateAHessianQuillenParallelSection fold determinant phase
          unitCircleTwist) =
      circleQuillenClosedHolonomy fold •
        globalCandidateAHessianQuillenMetricAnchor fold determinant phase := by
  apply (circleDeterminantFrameEquiv fold periodicTwist).symm.injective
  rw [circleLargeGaugeDeterminantTransition_coordinate]
  simp only [globalCandidateAHessianQuillenParallelSection,
    globalCandidateAHessianQuillenMetricAnchor,
    circleDeterminantCoordinate,
    LinearEquiv.apply_symm_apply, map_smul]
  exact circleQuillen_transport_then_clutching fold
    (globalCandidateAHessianComplexDeterminant determinant phase)

/-- Public parallel-section checkpoint. -/
theorem global_candidateA_hessian_quillen_parallel_section_gate
    {couplings : GlobalCandidateAActionCouplings}
    {NonNullFace NullFace : Type*}
    [Fintype NonNullFace] [Fintype NullFace]
    {measure : Measure (EffectiveQuotient period hPeriod)}
    {configuration : GlobalGaugeFixedFieldConfiguration period hPeriod}
    {data : GlobalCandidateAActionData period hPeriod configuration.physical
      couplings NonNullFace NullFace}
    {analysis : GlobalAnalysisData period hPeriod configuration.physical}
    {einsteinScale : Real}
    {hBoundaryTransverse : HasNoTangentialRadical period hPeriod
      data.plusGravity.metric.metric}
    {family : ProgramPGlobalMinimalPhysicalLocalActionFamilyH10ReducedData4D
      period hPeriod configuration data analysis
        (diracGreenClosureMatterRealization period hPeriod
          couplings.matterMassSquared) einsteinScale}
    {extensions : GlobalCandidateASevenPhysicalCanonicalContinuousAgreements4D
      period hPeriod configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)}
    {shift : GlobalCandidateAAugmentedOrthogonalCoerciveShift4D period hPeriod
      configuration data analysis
        (globalCandidateABoundaryProjectionChart period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateABoundaryProjectionSameAction period hPeriod
          configuration data analysis einsteinScale hBoundaryTransverse family)
        (globalCandidateAConcretePhysicalExtension period hPeriod configuration
          data analysis einsteinScale hBoundaryTransverse family extensions)}
    (fold : Fold)
    (determinant : GlobalCandidateAHessianFinitePartDeterminantData4D period
      hPeriod configuration data analysis einsteinScale hBoundaryTransverse
        family extensions shift)
    (phase : RelativeDeterminantPhaseData) :
    (∀ twist : CircleTwist,
      circleQuillenNormSq fold twist
          (globalCandidateAHessianQuillenParallelSection fold determinant phase
            twist) =
        (globalCandidateAHessianFinitePartDeterminant determinant) ^ 2) ∧
      circleLargeGaugeDeterminantTransition fold
          (globalCandidateAHessianQuillenParallelSection fold determinant phase
            unitCircleTwist) =
        circleQuillenClosedHolonomy fold •
          globalCandidateAHessianQuillenMetricAnchor fold determinant phase :=
  ⟨globalCandidateAHessianQuillenParallelSection_normSq fold determinant phase,
    globalCandidateAHessianQuillenParallelSection_endpoint_clutching fold
      determinant phase⟩

end
