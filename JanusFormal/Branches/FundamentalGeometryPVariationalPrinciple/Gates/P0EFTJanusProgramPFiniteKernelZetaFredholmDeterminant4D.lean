import JanusFormal.Branches.FundamentalGeometryPVariationalPrinciple.Gates.P0EFTJanusProgramPSplitFredholmDeterminantFrameConnection4D

/-!
# Fredholm determinant coordinate from a finite kernel and a zeta family

A named basis of every actual kernel supplies a canonical nonzero top exterior
volume.  A differentiable zeta family supplies the nonzero determinant of the
invertible complement.  In the canonical named kernel frame, the full split
Fredholm determinant coordinate is therefore exactly the reduced zeta
coordinate.

This file performs that join without postulating a second determinant.  The
kernel frame coordinate is constantly `1`, its connection contribution is
zero, and all metric/connection variation comes from the same reduced zeta
family.  The result is still stated as a canonical coordinate certificate;
the abstract complex tensor-product determinant line remains a separate
comparison theorem.
-/

namespace JanusFormal
namespace P0EFTJanusProgramPFiniteKernelZetaFredholmDeterminant4D

set_option autoImplicit false
set_option maxHeartbeats 3600000
set_option synthInstance.maxHeartbeats 1800000

noncomputable section

open P0EFTJanusProgramPFiniteKernelBasisFamily4D
open P0EFTJanusProgramPFiniteKernelDeterminantLineFamily4D
open P0EFTJanusProgramPSplitFredholmDeterminantFamily4D
open P0EFTJanusProgramPSplitFredholmDeterminantFrameAtlas4D
open P0EFTJanusProgramPSplitFredholmDeterminantFrameConnection4D
open P0EFTJanusProgramPRelativeZetaDeterminantConnection4D

variable {E : Type*} {ZeroMode : Type}
  [NormedAddCommGroup E] [NormedSpace Real E]
  [Fintype ZeroMode] [DecidableEq ZeroMode] [LinearOrder ZeroMode]

/-- Split Fredholm determinant generated by the actual kernel basis family and
one reduced zeta family. -/
def finiteKernelZetaSplitDeterminant
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData) :
    SplitFredholmDeterminantFamilyData operator ZeroMode where
  kernels := kernels
  reducedDeterminant := relativeZetaDeterminantCoordinate zetaFamily
  reducedDeterminant_ne_zero :=
    relativeZetaDeterminantCoordinate_ne_zero zetaFamily

/-- Canonical one-frame atlas selected by the named kernel top exterior
volume. -/
def finiteKernelZetaNamedFrameAtlas
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData) :
    SplitFredholmDeterminantFrameAtlasData operator ZeroMode Unit where
  split := finiteKernelZetaSplitDeterminant operator kernels zetaFamily
  kernelFrameCoordinate := fun _ _ => 1
  kernelFrameCoordinate_ne_zero := by
    intro _ _
    exact one_ne_zero

/-- Canonical connection in the named kernel frame. -/
def finiteKernelZetaNamedFrameConnection
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData) :
    SplitFredholmDeterminantFrameConnectionData operator ZeroMode Unit where
  atlas := finiteKernelZetaNamedFrameAtlas operator kernels zetaFamily
  reducedFamily := zetaFamily
  reduced_agreement := fun _ => rfl
  kernelFrameDerivative := fun _ _ => 0
  kernelFrame_hasDerivAt := by
    intro _ parameter
    change HasFDerivAt (fun _ : Real => (1 : Complex))
      (ContinuousLinearMap.toSpanSingleton Real (0 : Complex)) parameter
    simpa using
      (hasFDerivAt_const (𝕜 := Real) (E := Real) (1 : Complex) parameter)

/-- In the canonical named kernel frame the full determinant coordinate is
literally the reduced zeta determinant. -/
@[simp]
theorem finiteKernelZetaNamedFrame_localDeterminant
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData)
    (parameter : Real) :
    (finiteKernelZetaNamedFrameAtlas operator kernels zetaFamily).localDeterminant
        () parameter =
      relativeZetaDeterminantCoordinate zetaFamily parameter := by
  simp [SplitFredholmDeterminantFrameAtlasData.localDeterminant,
    finiteKernelZetaNamedFrameAtlas, finiteKernelZetaSplitDeterminant]

/-- The named kernel frame contributes no additional connection one-form. -/
@[simp]
theorem finiteKernelZetaNamedFrame_localConnectionCoefficient
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData)
    (parameter : Real) :
    (finiteKernelZetaNamedFrameConnection operator kernels zetaFamily).localConnectionCoefficient
      () parameter =
      relativeZetaConnectionCoefficient zetaFamily parameter := by
  simp [finiteKernelZetaNamedFrameConnection,
    SplitFredholmDeterminantFrameConnectionData.localConnectionCoefficient]

/-- The full canonical coordinate is nonzero. -/
theorem finiteKernelZetaNamedFrame_localDeterminant_ne_zero
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData)
    (parameter : Real) :
    (finiteKernelZetaNamedFrameAtlas operator kernels zetaFamily).localDeterminant
        () parameter ≠ 0 :=
  (finiteKernelZetaNamedFrameAtlas operator kernels zetaFamily).localDeterminant_ne_zero
    () parameter

/-- The full canonical coordinate is parallel for the same zeta connection. -/
theorem finiteKernelZetaNamedFrame_parallel
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData)
    (parameter : Real) :
    (finiteKernelZetaNamedFrameConnection operator kernels zetaFamily).localConnectionAt
        () parameter
        ((finiteKernelZetaNamedFrameAtlas operator kernels zetaFamily).localDeterminant
          () parameter)
        ((finiteKernelZetaNamedFrameConnection operator kernels zetaFamily).localDeterminantDerivative
          () parameter) = 0 :=
  (finiteKernelZetaNamedFrameConnection operator kernels zetaFamily).localDeterminant_parallel
    () parameter

/-- The finite kernel determinant volume is nonzero independently of the zeta
coordinate. -/
theorem finiteKernelZeta_namedVolume_ne_zero
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData)
    (parameter : Real) :
    ((finiteKernelZetaSplitDeterminant operator kernels zetaFamily).canonicalSection
      parameter).kernelVolume ≠ 0 :=
  (finiteKernelZetaSplitDeterminant operator kernels zetaFamily).canonicalSection_nonzero_components
    parameter |>.1

/-- Complete canonical-coordinate certificate. -/
structure FiniteKernelZetaFredholmDeterminantCertificate
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData) : Prop where
  kernelLine : ∀ parameter,
    Module.finrank Real
      (FiniteKernelDeterminantFiber kernels parameter) = 1
  namedVolume_nonzero : ∀ parameter,
    finiteKernelNamedVolume kernels parameter ≠ 0
  fullCoordinate_eq_zeta : ∀ parameter,
    (finiteKernelZetaNamedFrameAtlas operator kernels zetaFamily).localDeterminant
        () parameter =
      relativeZetaDeterminantCoordinate zetaFamily parameter
  fullCoordinate_nonzero : ∀ parameter,
    (finiteKernelZetaNamedFrameAtlas operator kernels zetaFamily).localDeterminant
        () parameter ≠ 0
  fullCoordinate_parallel : ∀ parameter,
    (finiteKernelZetaNamedFrameConnection operator kernels zetaFamily).localConnectionAt
        () parameter
        ((finiteKernelZetaNamedFrameAtlas operator kernels zetaFamily).localDeterminant
          () parameter)
        ((finiteKernelZetaNamedFrameConnection operator kernels zetaFamily).localDeterminantDerivative
          () parameter) = 0
  connection_eq_reduced : ∀ parameter,
    (finiteKernelZetaNamedFrameConnection operator kernels zetaFamily).localConnectionCoefficient
      () parameter =
      relativeZetaConnectionCoefficient zetaFamily parameter

/-- Build the full canonical-coordinate certificate. -/
def finiteKernelZetaFredholmDeterminantCertificate
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData) :
    FiniteKernelZetaFredholmDeterminantCertificate operator kernels zetaFamily where
  kernelLine := finiteKernelDeterminantFiber_finrank_one kernels
  namedVolume_nonzero := finiteKernelNamedVolume_ne_zero kernels
  fullCoordinate_eq_zeta :=
    finiteKernelZetaNamedFrame_localDeterminant operator kernels zetaFamily
  fullCoordinate_nonzero :=
    finiteKernelZetaNamedFrame_localDeterminant_ne_zero operator kernels zetaFamily
  fullCoordinate_parallel :=
    finiteKernelZetaNamedFrame_parallel operator kernels zetaFamily
  connection_eq_reduced :=
    finiteKernelZetaNamedFrame_localConnectionCoefficient operator kernels
      zetaFamily

/-- Public finite-kernel plus reduced-zeta Fredholm determinant checkpoint. -/
theorem finite_kernel_zeta_fredholm_determinant_gate
    (operator : Real → E →L[Real] E)
    (kernels : FiniteKernelBasisFamilyData operator ZeroMode)
    (zetaFamily : RelativeZetaDeterminantFamilyData) :
    FiniteKernelZetaFredholmDeterminantCertificate operator kernels zetaFamily :=
  finiteKernelZetaFredholmDeterminantCertificate operator kernels zetaFamily

end
end P0EFTJanusProgramPFiniteKernelZetaFredholmDeterminant4D
end JanusFormal
