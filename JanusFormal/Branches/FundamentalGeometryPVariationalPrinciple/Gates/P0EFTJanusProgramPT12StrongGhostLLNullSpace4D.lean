def auxLLCore : GlobalLLAuxMeasureSmooth period hPeriod →ₗ[Real]
    GlobalCandidateADiagonalExtendedBulkSmoothCore period hPeriod analysis :=
  (fullLLCore period hPeriod configuration analysis).comp (LinearMap.inl Real _ _)

def actualAuxLLEmbedding : GlobalLLAuxMeasureSmooth period hPeriod →ₗ[Real]
    CommonAugmentedHilbert period hPeriod configuration data analysis :=
  (diagonalExtendedBulkL2SmoothEmbedding period hPeriod
    (globalCandidateAMetricBySector period hPeriod data) couplings.matterMassSquared data analysis).comp
      (auxLLCore period hPeriod configuration analysis)

def closedAuxLLSubspace : Submodule Real (CommonAugmentedHilbert period hPeriod configuration data analysis) :=
  (actualAuxLLEmbedding period hPeriod configuration data analysis).range.topologicalClosure

instance closedAuxLLSubspace_isClosed :
    IsClosed (closedAuxLLSubspace period hPeriod configuration data analysis :
      Set (CommonAugmentedHilbert period hPeriod configuration data analysis)) :=
  Submodule.isClosed_topologicalClosure _

/-- Closure of the sum removes both null sectors in the same actual Hilbert space. -/
def jointGhostLLNullSpace : Submodule Real (CommonAugmentedHilbert period hPeriod configuration data analysis) :=
  (closedAuxLLSubspace period hPeriod configuration data analysis ⊔
    closedGhostSubspace period hPeriod configuration data analysis).topologicalClosure

instance jointGhostLLNullSpace_isClosed :
    IsClosed (jointGhostLLNullSpace period hPeriod configuration data analysis :
      Set (CommonAugmentedHilbert period hPeriod configuration data analysis)) :=
  Submodule.isClosed_topologicalClosure _

variable [IsFiniteMeasure measure]
variable (realization : ProgramPPrimitiveSpinCMatterSmoothGraphRealization4D
  period hPeriod couplings.matterMassSquared)
variable (plusBase minusBase : RegularGeneralLorentzMetric period hPeriod)
variable (hBase : RegularGeneralMetricC2PairedLorentzChartBaseCompatible
  period hPeriod plusBase minusBase)
variable (hCenter : RegularGeneralMetricC2PairedMinimalPhysicalCenterCompatible
  period hPeriod configuration.physical plusBase minusBase hBase)

variable (physical : GlobalCandidateASevenPhysicalCommonDomainExtension4D
  period hPeriod configuration data analysis
  (strongChart (measure := measure) period hPeriod configuration data analysis realization plusBase minusBase hBase)
  (strongBridge (measure := measure) period hPeriod configuration data analysis realization plusBase minusBase hBase hCenter))

variable (hZero : (data.boundary.llFields period hPeriod).llField = 0)

include hZero in
/-- Auxiliary/measure cancellation holds against every completed augmented test. -/
theorem actualAuxLL_riesz_zero (aux : GlobalLLAuxMeasureSmooth period hPeriod) :
    strongAugmentedRiesz (measure := measure) period hPeriod configuration data analysis realization
      plusBase minusBase hBase hCenter physical
      (actualAuxLLEmbedding period hPeriod configuration data analysis aux) = 0 := by
  let value := strongAugmentedRiesz (measure := measure) period hPeriod configuration data analysis realization
    plusBase minusBase hBase hCenter physical
    (actualAuxLLEmbedding period hPeriod configuration data analysis aux)
  have hRow : (fun test : CommonAugmentedHilbert period hPeriod configuration data analysis =>
      inner Real value test) = fun _ => 0 := by
    apply (diagonalExtendedBulkL2SmoothEmbedding_denseRange period hPeriod
      (globalCandidateAMetricBySector period hPeriod data) couplings.matterMassSquared data analysis).equalizer
      (by fun_prop) continuous_const
    funext test
    change inner Real
      (strongAugmentedRiesz (measure := measure) period hPeriod configuration data analysis realization
        plusBase minusBase hBase hCenter physical
        (diagonalExtendedBulkL2SmoothEmbedding period hPeriod
          (globalCandidateAMetricBySector period hPeriod data) couplings.matterMassSquared data analysis
          (fullLLCore period hPeriod configuration analysis (aux, 0)))) _ = 0
    exact (strong_fullLL_augmented_pairing period hPeriod configuration data analysis realization
      plusBase minusBase hBase hCenter physical (aux, 0) test).trans
        (sameActionHessian_pureAuxMeasure_zeroFlux period hPeriod data analysis hZero aux.1 aux.2 test.2.2.2)
  apply ext_inner_right Real
  intro test
  rw [inner_zero_left]
  exact congrFun hRow test

include hZero in
theorem closedAuxLLSubspace_le_kernel :
    closedAuxLLSubspace period hPeriod configuration data analysis ≤
      (strongAugmentedRiesz (measure := measure) period hPeriod configuration data analysis realization
        plusBase minusBase hBase hCenter physical).ker := by
  apply Submodule.topologicalClosure_minimal
  · rintro vector ⟨aux, rfl⟩
    exact actualAuxLL_riesz_zero period hPeriod configuration data analysis realization
      plusBase minusBase hBase hCenter physical hZero aux
  · exact ContinuousLinearMap.isClosed_ker _

variable (hMetric : globalCandidateAMetricBySector period hPeriod data .plus =
  globalCandidateAMetricBySector period hPeriod data .minus)
variable (hWeights : candidateAPlusEinsteinKineticWeight couplings + candidateAMinusEinsteinKineticWeight couplings = 0)

include hZero hMetric hWeights in
theorem jointGhostLLNullSpace_le_kernel :
    jointGhostLLNullSpace period hPeriod configuration data analysis ≤
      (strongAugmentedRiesz (measure := measure) period hPeriod configuration data analysis realization
        plusBase minusBase hBase hCenter physical).ker := by
  apply Submodule.topologicalClosure_minimal
  · apply sup_le
    · exact closedAuxLLSubspace_le_kernel period hPeriod configuration data analysis realization
        plusBase minusBase hBase hCenter physical hZero
    · exact closedGhostSubspace_le_kernel period hPeriod configuration data analysis
        (strongChart (measure := measure) period hPeriod configuration data analysis realization plusBase minusBase hBase)
        (strongBridge (measure := measure) period hPeriod configuration data analysis realization plusBase minusBase hBase hCenter)
        physical hMetric hWeights
  · exact ContinuousLinearMap.isClosed_ker _

end
