variable (period : Real) (hPeriod : period ≠ 0)

private abbrev ThroatData := fixedEquatorData period hPeriod
private abbrev ThroatBase := MappingTorus (ThroatData period hPeriod)

local instance throatBaseChartedSpace :
    ChartedSpace ThroatCoverModel (ThroatBase period hPeriod) :=
  fixedThroatQuotientChartedSpace period hPeriod

local instance throatBaseIsManifold :
    IsManifold throatCoverModelWithCorners ω
      (ThroatBase period hPeriod) :=
  fixedThroatQuotient_isManifold period hPeriod

private abbrev SmoothSection :=
  D9PrimitiveSpinCSmoothSection period hPeriod .positiveQuarter

/-- Span of the three positive first-sphere eigensections. -/
def primitiveSpinCHopfFirstSpherePositiveBlock
    (sector : NormalRootChoice) (mode : Int) :
    Submodule Real (SmoothSection period hPeriod) :=
  Submodule.span Real
    (Set.range fun coordinate : Fin 3 =>
      primitiveSpinCHopfFirstSpherePositiveSection
        period hPeriod coordinate sector mode)

/-- Span of the three negative first-sphere eigensections. -/
def primitiveSpinCHopfFirstSphereNegativeBlock
    (sector : NormalRootChoice) (mode : Int) :
    Submodule Real (SmoothSection period hPeriod) :=
  Submodule.span Real
    (Set.range fun coordinate : Fin 3 =>
      primitiveSpinCHopfFirstSphereNegativeSection
        period hPeriod coordinate sector mode)

/-- Geometric seed block generated by the coordinate and tangential sections. -/
def primitiveSpinCHopfFirstSphereGeometricSeedBlock
    (sector : NormalRootChoice) (mode : Int) :
    Submodule Real (SmoothSection period hPeriod) :=
  Submodule.span Real
      (Set.range fun coordinate : Fin 3 =>
        primitiveSpinCHopfFirstSphereCoordinateSection
          period hPeriod coordinate sector mode) ⊔
    Submodule.span Real
      (Set.range fun coordinate : Fin 3 =>
        primitiveSpinCHopfFirstSphereTangentialSection
          period hPeriod coordinate sector mode)

theorem primitiveSpinCHopfFirstSpherePositiveBlock_eigen
    {sector : NormalRootChoice} {mode : Int}
    {state : SmoothSection period hPeriod}
    (hState :
      state ∈ primitiveSpinCHopfFirstSpherePositiveBlock
        period hPeriod sector mode) :
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter state =
      primitiveSpinCHopfFirstSphereDiracFrequency period sector mode •
        state := by
  rw [primitiveSpinCHopfFirstSpherePositiveBlock] at hState
  refine Submodule.span_induction
    (p := fun state _ =>
      d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter state =
        primitiveSpinCHopfFirstSphereDiracFrequency
            period sector mode • state)
    ?_ ?_ ?_ ?_ hState
  · rintro _ ⟨coordinate, rfl⟩
    exact
      primitiveSpinCHopfFirstSpherePositiveGeometricDiracOperator_eigen
        period hPeriod coordinate sector mode
  · rw [d9PrimitiveSpinCGeometricDiracOperator_zero, smul_zero]
  · intro first second _ _ hFirst hSecond
    rw [d9PrimitiveSpinCGeometricDiracOperator_add,
      hFirst, hSecond, smul_add]
  · intro scalar sectionState _ hSection
    rw [d9PrimitiveSpinCGeometricDiracOperator_real_smul,
      hSection, smul_smul, smul_smul, mul_comm scalar]

theorem primitiveSpinCHopfFirstSphereNegativeBlock_eigen
    {sector : NormalRootChoice} {mode : Int}
    {state : SmoothSection period hPeriod}
    (hState :
      state ∈ primitiveSpinCHopfFirstSphereNegativeBlock
        period hPeriod sector mode) :
    d9PrimitiveSpinCGeometricDiracOperator
        period hPeriod .positiveQuarter state =
      (-primitiveSpinCHopfFirstSphereDiracFrequency period sector mode) •
        state := by
  rw [primitiveSpinCHopfFirstSphereNegativeBlock] at hState
  refine Submodule.span_induction
    (p := fun state _ =>
      d9PrimitiveSpinCGeometricDiracOperator
          period hPeriod .positiveQuarter state =
        (-primitiveSpinCHopfFirstSphereDiracFrequency
            period sector mode) • state)
    ?_ ?_ ?_ ?_ hState
  · rintro _ ⟨coordinate, rfl⟩
    exact
      primitiveSpinCHopfFirstSphereNegativeGeometricDiracOperator_eigen
        period hPeriod coordinate sector mode
  · rw [d9PrimitiveSpinCGeometricDiracOperator_zero, smul_zero]
  · intro first second _ _ hFirst hSecond
    rw [d9PrimitiveSpinCGeometricDiracOperator_add,
      hFirst, hSecond, smul_add]
  · intro scalar sectionState _ hSection
    rw [d9PrimitiveSpinCGeometricDiracOperator_real_smul,
      hSection, smul_smul, smul_smul, mul_comm scalar]

/-- Unique positive coordinates on the constructed first-sphere block. -/
def primitiveSpinCHopfFirstSpherePositiveCoordinateEquiv
    (sector : NormalRootChoice) (mode : Int) :
    (Fin 3 → Real) ≃ₗ[Real]
      primitiveSpinCHopfFirstSpherePositiveBlock
        period hPeriod sector mode :=
  (Finsupp.linearEquivFunOnFinite Real Real (Fin 3)).symm.trans
    ((primitiveSpinCHopfFirstSpherePositiveSections_linearIndependent
      period hPeriod sector mode).linearCombinationEquiv)

/-- Unique negative coordinates on the constructed first-sphere block. -/
def primitiveSpinCHopfFirstSphereNegativeCoordinateEquiv
    (sector : NormalRootChoice) (mode : Int) :
    (Fin 3 → Real) ≃ₗ[Real]
      primitiveSpinCHopfFirstSphereNegativeBlock
        period hPeriod sector mode :=
  (Finsupp.linearEquivFunOnFinite Real Real (Fin 3)).symm.trans
    ((primitiveSpinCHopfFirstSphereNegativeSections_linearIndependent
      period hPeriod sector mode).linearCombinationEquiv)

theorem primitiveSpinCHopfFirstSpherePositiveBlock_finrank
    (sector : NormalRootChoice) (mode : Int) :
    Module.finrank Real
        (primitiveSpinCHopfFirstSpherePositiveBlock
          period hPeriod sector mode) =
      primitiveSphereModeDegeneracy 1 := by
  calc
    _ = Module.finrank Real (Fin 3 → Real) :=
      (primitiveSpinCHopfFirstSpherePositiveCoordinateEquiv
        period hPeriod sector mode).finrank_eq.symm
    _ = 3 := Module.finrank_fin_fun Real
    _ = primitiveSphereModeDegeneracy 1 :=
      (primitiveSphereModeDegeneracy_one).symm

theorem primitiveSpinCHopfFirstSphereNegativeBlock_finrank
    (sector : NormalRootChoice) (mode : Int) :
    Module.finrank Real
        (primitiveSpinCHopfFirstSphereNegativeBlock
          period hPeriod sector mode) =
      primitiveSphereModeDegeneracy 1 := by
  calc
    _ = Module.finrank Real (Fin 3 → Real) :=
      (primitiveSpinCHopfFirstSphereNegativeCoordinateEquiv
        period hPeriod sector mode).finrank_eq.symm
    _ = 3 := Module.finrank_fin_fun Real
    _ = primitiveSphereModeDegeneracy 1 :=
      (primitiveSphereModeDegeneracy_one).symm

theorem primitiveSpinCHopfFirstSpherePositiveNegative_disjoint
    (sector : NormalRootChoice) (mode : Int) :
    Disjoint
      (primitiveSpinCHopfFirstSpherePositiveBlock
        period hPeriod sector mode)
      (primitiveSpinCHopfFirstSphereNegativeBlock
        period hPeriod sector mode) := by
  refine Submodule.disjoint_def.mpr ?_
  intro state hPositive hNegative
  have hPositiveEigen :=
    primitiveSpinCHopfFirstSpherePositiveBlock_eigen
      period hPeriod hPositive
  have hNegativeEigen :=
    primitiveSpinCHopfFirstSphereNegativeBlock_eigen
      period hPeriod hNegative
  let frequency :=
    primitiveSpinCHopfFirstSphereDiracFrequency period sector mode
  have hFrequency : frequency ≠ 0 := by
    exact ne_of_gt
      (primitiveSpinCHopfFirstSphereDiracFrequency_pos
        period sector mode)
  have hTwiceFrequency : (2 * frequency) ≠ 0 :=
    mul_ne_zero (by norm_num) hFrequency
  have hScaled : (2 * frequency) • state = 0 := by
    calc
      (2 * frequency) • state =
          frequency • state - (-frequency) • state := by
        module
      _ = 0 := by
        rw [← hPositiveEigen, ← hNegativeEigen]
        exact sub_self _
  exact (smul_eq_zero.mp hScaled).resolve_left hTwiceFrequency

theorem primitiveSpinCHopfFirstSpherePositiveBlock_le_seed
    (sector : NormalRootChoice) (mode : Int) :
    primitiveSpinCHopfFirstSpherePositiveBlock
        period hPeriod sector mode ≤
      primitiveSpinCHopfFirstSphereGeometricSeedBlock
        period hPeriod sector mode := by
  rw [primitiveSpinCHopfFirstSpherePositiveBlock, Submodule.span_le]
  rintro state ⟨coordinate, rfl⟩
  unfold primitiveSpinCHopfFirstSpherePositiveSection
  apply Submodule.add_mem
  · apply Submodule.smul_mem
    exact Submodule.mem_sup_left
      (Submodule.subset_span ⟨coordinate, rfl⟩)
  · exact Submodule.mem_sup_right
      (Submodule.subset_span ⟨coordinate, rfl⟩)

theorem primitiveSpinCHopfFirstSphereNegativeBlock_le_seed
    (sector : NormalRootChoice) (mode : Int) :
    primitiveSpinCHopfFirstSphereNegativeBlock
        period hPeriod sector mode ≤
      primitiveSpinCHopfFirstSphereGeometricSeedBlock
        period hPeriod sector mode := by
  rw [primitiveSpinCHopfFirstSphereNegativeBlock, Submodule.span_le]
  rintro state ⟨coordinate, rfl⟩
  unfold primitiveSpinCHopfFirstSphereNegativeSection
  apply Submodule.add_mem
  · apply Submodule.smul_mem
    exact Submodule.mem_sup_left
      (Submodule.subset_span ⟨coordinate, rfl⟩)
  · exact Submodule.mem_sup_right
      (Submodule.subset_span ⟨coordinate, rfl⟩)

theorem primitiveSpinCHopfFirstSphereCoordinateSection_mem_eigenblocks
    (coordinate : Fin 3) (sector : NormalRootChoice) (mode : Int) :
    primitiveSpinCHopfFirstSphereCoordinateSection
        period hPeriod coordinate sector mode ∈
      primitiveSpinCHopfFirstSpherePositiveBlock
          period hPeriod sector mode ⊔
        primitiveSpinCHopfFirstSphereNegativeBlock
          period hPeriod sector mode := by
  let frequency :=
    primitiveSpinCHopfFirstSphereDiracFrequency period sector mode
  have hFrequency : frequency ≠ 0 := by
    exact ne_of_gt
      (primitiveSpinCHopfFirstSphereDiracFrequency_pos
        period sector mode)
  have hTwiceFrequency : (2 * frequency) ≠ 0 :=
    mul_ne_zero (by norm_num) hFrequency
  have hPositive :
      primitiveSpinCHopfFirstSpherePositiveSection
          period hPeriod coordinate sector mode ∈
        primitiveSpinCHopfFirstSpherePositiveBlock
            period hPeriod sector mode ⊔
          primitiveSpinCHopfFirstSphereNegativeBlock
            period hPeriod sector mode :=
    Submodule.mem_sup_left
      (Submodule.subset_span ⟨coordinate, rfl⟩)
  have hNegative :
      primitiveSpinCHopfFirstSphereNegativeSection
          period hPeriod coordinate sector mode ∈
        primitiveSpinCHopfFirstSpherePositiveBlock
            period hPeriod sector mode ⊔
          primitiveSpinCHopfFirstSphereNegativeBlock
            period hPeriod sector mode :=
    Submodule.mem_sup_right
      (Submodule.subset_span ⟨coordinate, rfl⟩)
  have hDifference :
      primitiveSpinCHopfFirstSpherePositiveSection
            period hPeriod coordinate sector mode -
          primitiveSpinCHopfFirstSphereNegativeSection
            period hPeriod coordinate sector mode =
        (2 * frequency) •
          primitiveSpinCHopfFirstSphereCoordinateSection
            period hPeriod coordinate sector mode := by
    unfold primitiveSpinCHopfFirstSpherePositiveSection
      primitiveSpinCHopfFirstSphereNegativeSection
    module
  have hScaled :
      (2 * frequency) •
          primitiveSpinCHopfFirstSphereCoordinateSection
            period hPeriod coordinate sector mode ∈
        primitiveSpinCHopfFirstSpherePositiveBlock
            period hPeriod sector mode ⊔
          primitiveSpinCHopfFirstSphereNegativeBlock
            period hPeriod sector mode := by
    rw [← hDifference]
    exact Submodule.sub_mem _ hPositive hNegative
  have hRecover :
      primitiveSpinCHopfFirstSphereCoordinateSection
          period hPeriod coordinate sector mode =
        (2 * frequency)⁻¹ •
          ((2 * frequency) •
            primitiveSpinCHopfFirstSphereCoordinateSection
              period hPeriod coordinate sector mode) := by
    rw [smul_smul, inv_mul_cancel₀ hTwiceFrequency, one_smul]
  rw [hRecover]
  exact Submodule.smul_mem _ _ hScaled

theorem primitiveSpinCHopfFirstSphereTangentialSection_mem_eigenblocks
    (coordinate : Fin 3) (sector : NormalRootChoice) (mode : Int) :
    primitiveSpinCHopfFirstSphereTangentialSection
        period hPeriod coordinate sector mode ∈
      primitiveSpinCHopfFirstSpherePositiveBlock
          period hPeriod sector mode ⊔
        primitiveSpinCHopfFirstSphereNegativeBlock
          period hPeriod sector mode := by
  have hPositive :
      primitiveSpinCHopfFirstSpherePositiveSection
          period hPeriod coordinate sector mode ∈
        primitiveSpinCHopfFirstSpherePositiveBlock
            period hPeriod sector mode ⊔
          primitiveSpinCHopfFirstSphereNegativeBlock
            period hPeriod sector mode :=
    Submodule.mem_sup_left
      (Submodule.subset_span ⟨coordinate, rfl⟩)
  have hCoordinate :=
    primitiveSpinCHopfFirstSphereCoordinateSection_mem_eigenblocks
      period hPeriod coordinate sector mode
  have hIdentity :
      primitiveSpinCHopfFirstSphereTangentialSection
          period hPeriod coordinate sector mode =
        primitiveSpinCHopfFirstSpherePositiveSection
            period hPeriod coordinate sector mode -
          (primitiveSpinCHopfFirstSphereDiracFrequency
              period sector mode -
            normalRootLeviCivitaCorrectedFrequency
              period sector mode) •
            primitiveSpinCHopfFirstSphereCoordinateSection
              period hPeriod coordinate sector mode := by
    unfold primitiveSpinCHopfFirstSpherePositiveSection
    module
  rw [hIdentity]
  exact Submodule.sub_mem _ hPositive
    (Submodule.smul_mem _ _ hCoordinate)

/-- The two eigenspaces exhaust the entire geometric first-sphere seed block. -/
theorem primitiveSpinCHopfFirstSphereEigenblocks_sup_eq_seed
    (sector : NormalRootChoice) (mode : Int) :
    primitiveSpinCHopfFirstSpherePositiveBlock
          period hPeriod sector mode ⊔
        primitiveSpinCHopfFirstSphereNegativeBlock
          period hPeriod sector mode =
      primitiveSpinCHopfFirstSphereGeometricSeedBlock
        period hPeriod sector mode := by
  apply le_antisymm
  · exact sup_le
      (primitiveSpinCHopfFirstSpherePositiveBlock_le_seed
        period hPeriod sector mode)
      (primitiveSpinCHopfFirstSphereNegativeBlock_le_seed
        period hPeriod sector mode)
  · apply sup_le
    · rw [Submodule.span_le]
      rintro state ⟨coordinate, rfl⟩
      exact
        primitiveSpinCHopfFirstSphereCoordinateSection_mem_eigenblocks
          period hPeriod coordinate sector mode
    · rw [Submodule.span_le]
      rintro state ⟨coordinate, rfl⟩
      exact
        primitiveSpinCHopfFirstSphereTangentialSection_mem_eigenblocks
          period hPeriod coordinate sector mode

theorem primitiveSpinCHopfFirstSphereGeometricSeedBlock_finrank
    (sector : NormalRootChoice) (mode : Int) :
    Module.finrank Real
        (primitiveSpinCHopfFirstSphereGeometricSeedBlock
          period hPeriod sector mode) = 6 := by
  let positive :=
    primitiveSpinCHopfFirstSpherePositiveBlock
      period hPeriod sector mode
  let negative :=
    primitiveSpinCHopfFirstSphereNegativeBlock
      period hPeriod sector mode
  letI : FiniteDimensional Real positive :=
    (primitiveSpinCHopfFirstSpherePositiveCoordinateEquiv
      period hPeriod sector mode).finiteDimensional
  letI : FiniteDimensional Real negative :=
    (primitiveSpinCHopfFirstSphereNegativeCoordinateEquiv
      period hPeriod sector mode).finiteDimensional
  have hDimension :=
    Submodule.finrank_sup_add_finrank_inf_eq positive negative
  have hDisjoint :
      Disjoint positive negative :=
    primitiveSpinCHopfFirstSpherePositiveNegative_disjoint
      period hPeriod sector mode
  have hDisjointEq : positive ⊓ negative = ⊥ :=
    hDisjoint.eq_bot
  dsimp [positive, negative] at hDimension hDisjointEq
  rw [hDisjointEq, finrank_bot,
    primitiveSpinCHopfFirstSpherePositiveBlock_finrank,
    primitiveSpinCHopfFirstSphereNegativeBlock_finrank,
    primitiveSphereModeDegeneracy_one] at hDimension
  rw [← primitiveSpinCHopfFirstSphereEigenblocks_sup_eq_seed
    period hPeriod sector mode]
  omega

end
